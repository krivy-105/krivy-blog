# 静态资源缓存策略（Cloudflare 会读取这些响应头并据此缓存）

# Astro 构建产物带内容哈希，可永久缓存
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# 字体文件
/*.woff
  Cache-Control: public, max-age=31536000, immutable
/*.woff2
  Cache-Control: public, max-age=31536000, immutable
/*.ttf
  Cache-Control: public, max-age=31536000, immutable

# 图片
/*.png
  Cache-Control: public, max-age=604800
/*.jpg
  Cache-Control: public, max-age=604800
/*.jpeg
  Cache-Control: public, max-age=604800
/*.gif
  Cache-Control: public, max-age=604800
/*.webp
  Cache-Control: public, max-age=604800
/*.svg
  Cache-Control: public, max-age=604800

# favicon
/favicon.ico
  Cache-Control: public, max-age=86400
/favicon.svg
  Cache-Control: public, max-age=86400
/icons/*
  Cache-Control: public, max-age=604800

# PWA：SW 与 manifest 必须每次校验，否则新版本无法生效
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache

# sitemap 不缓存，保证实时更新
/sitemap-index.xml
  Cache-Control: no-cache
