# 环境变量示例 —— 复制成 .env 后填真实值
#
# 注意：`node server.mjs` 不会自动加载 .env，
# 用 docker compose 时它会被读进容器；用 systemd 直接跑则要自己 export。

# 管理员账号（不设默认 admin）
ADMIN_USERNAME=admin

# 管理员密码 —— 必须设置且必须强
# 不设的话线上会一直用 admin123456，并且每次重启都会覆盖库里的密码
ADMIN_PASSWORD=改成你自己的强密码

# 会话 cookie 名（多站点共享域名时才需要区分）
SESSION_COOKIE=blog_session

# 数据库位置：容器里固定 /data/blog.db（上传图与备份也在同目录）
DB_PATH=/data/blog.db

# 监听端口（平台一般会自己注入 PORT）
PORT=4321

# 时区：容器默认 UTC，不改会让北京时间 0–8 点发布的文章显示成前一天
TZ=Asia/Shanghai

# 设为 1 可关闭每日自动备份（默认开启，卷内保留最近 7 份）
# DISABLE_DB_BACKUP=1
