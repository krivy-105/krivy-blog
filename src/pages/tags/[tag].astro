---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';
import { tagQueries } from '../../lib/db';

const tag = decodeURIComponent(Astro.params.tag as string);
const posts = tagQueries.postsByTag.all(tag) as any[];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={`标签：${tag} - ${SITE_TITLE}`} description={`标签「${tag}」下的所有文章`} />
  </head>
  <body>
    <Header />
    <main class="narrow">
      <header class="page-head">
        <span class="eyebrow">TAG</span>
        <h1>#{tag}</h1>
        <p>{posts.length > 0 ? `共 ${posts.length} 篇文章` : '该标签下暂无文章'}</p>
      </header>

      {posts.length > 0 ? (
        <ul class="post-list">
          {posts.map((post, i) => (
            <li style={`animation-delay: ${i * 60}ms`}>
              <div class={`post-item${post.pinned_at ? ' is-pinned' : ''}`}>
                <a
                  href={`/blog/${post.slug}/`}
                  class="post-item-link"
                  aria-label={`阅读文章：${post.title}`}
                ></a>
                <div class="item-main">
                  {post.pinned_at && <span class="pin-badge">📌 置顶</span>}
                  <h2>{post.title}</h2>
                  {post.description && <p class="post-desc">{post.description}</p>}
                </div>
                <div class="item-meta">
                  <time>{new Date(post.created_at).toLocaleDateString('zh-CN')}</time>
                  <a class="meta-author" href={`/users/${post.author_name}`}>✍️ {post.author_name}</a>
                </div>
              </div>
            </li>
          ))}
        </ul>
      ) : (
        <div class="empty-state card">
          <div class="empty-icon">🏷️</div>
          <p>这个标签下还没有文章。</p>
          <a href="/blog" class="btn btn-outline">浏览全部文章</a>
        </div>
      )}
    </main>
    <Footer />

    <style>
      .page-head { margin-bottom: 2.4rem; }
      .page-head .eyebrow {
        display: inline-block;
        font-size: 0.76rem;
        letter-spacing: 0.34em;
        color: var(--monet-blue-dark);
        font-weight: 650;
        margin-bottom: 0.5rem;
      }
      .page-head h1 { margin-bottom: 0.4rem; color: var(--monet-blue-deep); }
      .page-head p { color: var(--text-gray); font-size: 0.95rem; margin: 0; }

      .post-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }
      .post-list li { animation: fadeInUp 0.5s var(--ease) both; }
      .post-item {
        position: relative;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 1.5rem;
        padding: 1.4rem 1.6rem;
        background: var(--bg-white);
        border: 1px solid var(--border-light);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-sm);
        transition: var(--transition);
      }
      .post-item:hover {
        transform: translateX(5px);
        box-shadow: var(--shadow-md);
        border-color: #d2e3eb;
      }
      .post-item-link {
        position: absolute;
        inset: 0;
        z-index: 0;
        border-radius: inherit;
      }
      .item-main { flex: 1; min-width: 0; }
      .item-main h2 {
        margin: 0 0 0.4rem;
        font-size: 1.18rem;
        line-height: 1.45;
        transition: color 0.2s var(--ease);
      }
      .post-item:hover h2 { color: var(--monet-blue-dark); }
      .post-desc {
        color: var(--text-gray);
        font-size: 0.92rem;
        line-height: 1.7;
        margin: 0;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }
      .item-meta {
        flex-shrink: 0;
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 0.35rem;
        padding-top: 2px;
        font-size: 0.82rem;
        color: var(--text-light);
        white-space: nowrap;
      }
      .meta-author {
        position: relative;
        z-index: 1;
        color: var(--monet-blue-dark);
        font-weight: 500;
      }
      .meta-author:hover { color: var(--monet-blue-deep); text-decoration: underline; }

      @media (max-width: 560px) {
        .post-item {
          flex-direction: column;
          gap: 0.7rem;
          padding: 1.25rem 1.3rem;
        }
        .item-meta {
          flex-direction: row;
          align-items: center;
          gap: 0.8rem;
        }
      }
    </style>
  </body>
</html>
