---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';
import { seriesQueries } from '../../lib/db';

const seriesList = seriesQueries.listAll.all() as any[];
const totalPosts = seriesList.reduce((acc, s) => acc + Number(s.post_count || 0), 0);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={`连载系列 - ${SITE_TITLE}`} description={`所有连载系列合集，共 ${seriesList.length} 个系列，${totalPosts} 篇文章。`} />
    <style>
      .page-head { margin-bottom: 2rem; }
      .page-head h1 { margin-bottom: 0.4rem; }
      .page-head p { color: var(--text-gray); font-size: 0.94rem; margin: 0; }

      .series-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.2rem;
      }
      .series-card {
        display: flex;
        flex-direction: column;
        background: var(--bg-white);
        border: 1px solid var(--border-light);
        border-radius: var(--radius-lg);
        padding: 1.4rem 1.5rem;
        box-shadow: var(--shadow-sm);
        color: inherit;
        text-decoration: none;
        position: relative;
        overflow: hidden;
        transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease), border-color 0.3s var(--ease);
        animation: fadeInUp 0.5s var(--ease) both;
      }
      .series-card::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 3px;
        background: linear-gradient(90deg, var(--monet-blue-light), var(--monet-blue-deep));
        opacity: 0.9;
      }
      .series-card:hover {
        transform: translateY(-5px);
        box-shadow: var(--shadow-lg);
        border-color: var(--monet-blue-light);
      }
      .series-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.8rem;
        margin-bottom: 0.6rem;
      }
      .series-title {
        font-size: 1.12rem;
        font-weight: 650;
        margin: 0;
        color: var(--text-dark);
        line-height: 1.35;
        transition: color 0.2s var(--ease);
      }
      .series-card:hover .series-title { color: var(--monet-blue-dark); }
      .series-badge {
        flex: none;
        padding: 3px 10px;
        font-size: 0.72rem;
        border-radius: var(--radius-pill);
        background: var(--monet-blue-lighter);
        color: var(--monet-blue-dark);
        font-weight: 600;
      }
      .series-desc {
        flex: 1;
        margin: 0.2rem 0 1rem;
        color: var(--text-gray);
        font-size: 0.88rem;
        line-height: 1.7;
        min-height: 44px;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }
      .series-foot {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: 0.8rem;
        border-top: 1px dashed var(--border-light);
        font-size: 0.8rem;
        color: var(--text-light);
      }
      .series-author {
        color: var(--monet-blue-dark);
        font-weight: 550;
        text-decoration: none;
      }
      .series-author:hover { text-decoration: underline; }
      .empty-state {
        text-align: center;
        padding: 4rem 2rem;
      }
      .empty-icon { font-size: 2.8rem; margin-bottom: 0.8rem; opacity: 0.8; }
      .empty-state p { color: var(--text-gray); margin-bottom: 1.4rem; }

      @media (max-width: 960px) { .series-grid { grid-template-columns: repeat(2, 1fr); } }
      @media (max-width: 580px) { .series-grid { grid-template-columns: 1fr; } }
      @media (prefers-reduced-motion: reduce) {
        .series-card { animation: none !important; }
      }
    </style>
  </head>
  <body>
    <Header />
    <main class="wide">
      <header class="page-head">
        <h1>📚 连载系列</h1>
        <p>共 {seriesList.length} 个系列，累计 {totalPosts} 篇已发布文章。</p>
      </header>

      {seriesList.length === 0 ? (
        <div class="empty-state card">
          <div class="empty-icon">📖</div>
          <p>还没有创建任何连载系列。</p>
          {Astro.locals.user && <a href="/write" class="btn btn-primary">开始创作</a>}
        </div>
      ) : (
        <div class="series-grid">
          {seriesList.map((s, i) => (
            <a href={`/series/${s.slug}/`} class="series-card" style={`animation-delay:${Math.min(i, 15) * 55}ms`}>
              <div class="series-head">
                <h2 class="series-title">{s.title}</h2>
                <span class="series-badge">{s.post_count ?? 0} 篇</span>
              </div>
              <p class="series-desc">{s.description || '作者暂未填写这个系列的简介。'}</p>
              <div class="series-foot">
                <a class="series-author" href={`/users/${s.author_name}`} onclick="event.stopPropagation()">@{s.author_name}</a>
                <span>更新于 {new Date(s.updated_at).toLocaleDateString('zh-CN')}</span>
              </div>
            </a>
          ))}
        </div>
      )}
    </main>
    <Footer />
  </body>
</html>
