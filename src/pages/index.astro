---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { postQueries, tagQueries, viewQueries, likeQueries, commentQueries } from '../lib/db';

const posts = postQueries.findApproved.all() as any[];
const recent = posts.slice(0, 6);
const hotPosts = postQueries.topHot.all() as any[];

// post_id -> tags 数组
const tagRows = tagQueries.forPostList.all() as { post_id: number; tags: string | null }[];
const tagMap = new Map<number, string[]>();
for (const r of tagRows) {
  if (r.tags) tagMap.set(r.post_id, r.tags.split(','));
}

// post_id -> 浏览量
const viewRows = viewQueries.countForPostList.all() as { post_id: number; count: number }[];
const viewMap = new Map<number, number>();
for (const r of viewRows) viewMap.set(r.post_id, r.count);

// 点赞数 / 评论数 Map（给热门卡片的小指标）
const likeRows = likeQueries.countForPostList.all() as { post_id: number; count: number }[];
const likeMap = new Map<number, number>();
for (const r of likeRows) likeMap.set(r.post_id, r.count);

const cmtRows = commentQueries.countForPostList.all() as { post_id: number; count: number }[];
const cmtMap = new Map<number, number>();
for (const r of cmtRows) cmtMap.set(r.post_id, r.count);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />

    <!-- 首屏 -->
    <section class="hero">
      <div class="hero-inner">
        <span class="hero-eyebrow">KRIVY · CYOU</span>
        <h1>want to see you</h1>
        <p class="hero-sub">
          记录技术成长、生活点滴与思考感悟。<br class="br-pc" />
          欢迎来到这片莫奈蓝色的静谧角落。
        </p>
        <div class="hero-actions">
          <a href="/blog" class="btn btn-primary">浏览文章</a>
          <a href="/about" class="btn btn-outline">关于我</a>
        </div>
      </div>
    </section>

    <main>
      <!-- 站点简介 -->
      <section class="intro card">
        <span class="eyebrow">ABOUT HERE</span>
        <h2>一个记录与相遇的地方</h2>
        <div class="intro-body">
          <p>
            「want to see you」装着技术路上的摸索与成长，也藏着生活里的细碎思考。
            文字被认真地收进标签与连载，等你慢慢翻阅。
          </p>
          <p>
            你也不只是过客：注册账号就能发表自己的文章——Markdown 工具栏、实时预览、草稿自动保存，让写作很轻；
            给喜欢的文字点赞收藏，在评论区楼中楼接着聊，关注感兴趣的人，他们的更新会出现在你的动态流；
            互动通知与私信，也都安静地替你收好。
          </p>
          <p class="intro-end">不打扰，不喧闹。欢迎坐下，读点什么，也写点什么。</p>
        </div>
        <ul class="intro-chips">
          <li><a href="/blog">📚 浏览文章</a></li>
          <li><a href="/tags">🏷 标签找文</a></li>
          <li><a href="/series">📖 系列连载</a></li>
          <li><a href="/write">✍️ 开始写作</a></li>
        </ul>
      </section>

      <section class="latest">
        <div class="section-head">
          <span class="eyebrow">LATEST POSTS</span>
          <h2>最新文章</h2>
        </div>

        {recent.length > 0 ? (
          <ul class="post-grid">
            {recent.map((post, i) => (
              <li style={`animation-delay: ${i * 70}ms`}>
                <div class={`post-card${post.pinned_at ? ' is-pinned' : ''}`}>
                  <a
                    href={`/blog/${post.slug}/`}
                    class="post-card-link"
                    aria-label={`阅读文章：${post.title}`}
                  ></a>
                  <div class="post-meta">
                    {post.pinned_at && <span class="pin-badge">📌 置顶</span>}
                    <span>{new Date(post.created_at).toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
                    <span class="meta-dot">·</span>
                    <a class="card-author" href={`/users/${post.author_name}`}>{post.author_name}</a>
                    {viewMap.has(post.id) && (
                      <>
                        <span class="meta-dot">·</span>
                        <span class="view-count">👁 {viewMap.get(post.id)}</span>
                      </>
                    )}
                  </div>
                  <h2>{post.title}</h2>
                  {post.description && <p class="post-desc">{post.description}</p>}
                  {(tagMap.get(post.id) || []).length > 0 && (
                    <ul class="tag-list">
                      {tagMap.get(post.id)!.map((t) => (
                        <li><a class="tag-chip" href={`/tags/${t}/`}>{t}</a></li>
                      ))}
                    </ul>
                  )}
                  <span class="read-more">
                    阅读全文
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                  </span>
                </div>
              </li>
            ))}
          </ul>
        ) : (
          <div class="empty-state card">
            <div class="empty-icon">📝</div>
            <p>还没有文章，敬请期待。</p>
            {Astro.locals.user && <a href="/write" class="btn btn-primary">发表第一篇</a>}
          </div>
        )}

        {posts.length > recent.length && (
          <div class="more-wrap">
            <a href="/blog" class="btn btn-outline">查看全部 {posts.length} 篇 →</a>
          </div>
        )}
      </section>

      <section class="hot-section">
        <div class="section-head">
          <span class="eyebrow">HOT POSTS · 🔥</span>
          <h2>热门文章</h2>
        </div>

        {hotPosts.length > 0 ? (
          <ol class="hot-list card">
            {hotPosts.map((post, i) => (
              <li class={`hot-item rank-${i + 1}${post.pinned_at ? ' is-pinned' : ''}`}>
                <div class="rank-badge" aria-hidden="true">{i + 1}</div>
                <a href={`/blog/${post.slug}/`} class="hot-main">
                  <div class="hot-title-row">
                    <h3>{post.title}</h3>
                  </div>
                  <div class="hot-meta">
                    <span>{new Date(post.created_at).toLocaleDateString('zh-CN')}</span>
                    <span class="meta-dot">·</span>
                    <a class="card-author" href={`/users/${post.author_name}`}>{post.author_name}</a>
                    <span class="meta-dot">·</span>
                    <span class="stat-item">👁 {viewMap.get(post.id) || 0}</span>
                    <span class="stat-item">♡ {likeMap.get(post.id) || 0}</span>
                    <span class="stat-item">💬 {cmtMap.get(post.id) || 0}</span>
                  </div>
                  {(tagMap.get(post.id) || []).length > 0 && (
                    <ul class="tag-list">
                      {tagMap.get(post.id)!.slice(0, 3).map((t) => (
                        <li><span class="tag-chip inline">{t}</span></li>
                      ))}
                    </ul>
                  )}
                </a>
                <a href={`/blog/${post.slug}/`} class="hot-go" aria-label="进入文章">
                  →
                </a>
              </li>
            ))}
          </ol>
        ) : (
          <div class="empty-state card small">
            <div class="empty-icon">🔥</div>
            <p>暂时没有热门数据，文章被点赞、评论、阅读后会出现在这里。</p>
          </div>
        )}
      </section>
    </main>
    <Footer />
  </body>
</html>

<style>
  /* ---------- 首屏 ---------- */
  .hero {
    padding: 5.5rem 1.5rem 4.5rem;
    text-align: center;
    background:
      radial-gradient(900px 380px at 50% -8%, rgba(126, 166, 184, 0.16), transparent 70%);
  }
  .hero-inner {
    max-width: 720px;
    margin: 0 auto;
    animation: fadeInUp 0.7s var(--ease);
  }
  .hero-eyebrow {
    display: inline-block;
    font-size: 0.76rem;
    letter-spacing: 0.34em;
    color: var(--monet-blue-dark);
    font-weight: 650;
    margin-bottom: 1.1rem;
    padding-left: 0.34em;
  }
  .hero h1 {
    font-size: clamp(2.1rem, 5.2vw, 3rem);
    font-weight: 650;
    color: var(--text-dark);
    margin-bottom: 1rem;
    letter-spacing: 0.03em;
  }
  .hero-sub {
    font-size: clamp(1rem, 2vw, 1.12rem);
    color: var(--text-gray);
    line-height: 1.9;
    margin-bottom: 2.2rem;
  }
  .hero-actions {
    display: flex;
    justify-content: center;
    gap: 0.9rem;
    flex-wrap: wrap;
  }

  /* ---------- 站点简介 ---------- */
  .intro {
    max-width: 920px;
    margin: 0 auto 3.2rem;
    padding: 2.2rem 2.4rem;
    text-align: center;
    background:
      radial-gradient(520px 200px at 50% -30%, rgba(126, 166, 184, 0.12), transparent 70%),
      var(--bg-white);
  }
  .intro h2 {
    margin: 0.5rem 0 1.2rem;
    font-size: 1.45rem;
    font-weight: 650;
    color: var(--text-dark);
    letter-spacing: 0.02em;
  }
  .intro-body {
    max-width: 660px;
    margin: 0 auto;
  }
  .intro-body p {
    margin: 0 0 0.9rem;
    font-size: 0.96rem;
    line-height: 2;
    color: var(--text-gray);
  }
  .intro-end {
    margin-bottom: 0 !important;
    color: var(--monet-blue-dark) !important;
    font-weight: 550;
  }
  .intro-chips {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
    padding: 0;
    margin: 1.5rem 0 0;
  }
  .intro-chips a {
    display: inline-block;
    padding: 7px 16px;
    border-radius: var(--radius-pill);
    background: var(--monet-blue-lighter);
    color: var(--monet-blue-dark);
    font-size: 0.86rem;
    font-weight: 550;
    text-decoration: none;
    border: 1px solid transparent;
    transition: var(--transition);
  }
  .intro-chips a:hover {
    background: var(--bg-white);
    border-color: var(--monet-blue-light);
    transform: translateY(-2px);
  }

  /* ---------- 文章网格 ---------- */
  .latest { max-width: 920px; margin: 0 auto; }
  .post-grid {
    display: grid;
    gap: 1.4rem;
    grid-template-columns: 1fr;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .post-grid li {
    animation: fadeInUp 0.55s var(--ease) both;
  }
  .post-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.7rem 1.8rem;
    background: var(--bg-white);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    color: inherit;
    transition: var(--transition);
  }
  .post-card-link {
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: inherit;
  }
  .card-author {
    position: relative;
    z-index: 1;
  }
  .card-author:hover { text-decoration: underline; }
  .post-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: #d2e3eb;
  }
  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.83rem;
    color: var(--monet-blue-dark);
    font-weight: 500;
    margin-bottom: 0.75rem;
  }
  .meta-dot { color: var(--text-light); }
  .post-card h2 {
    margin: 0 0 0.55rem;
    font-size: 1.28rem;
    line-height: 1.45;
    color: var(--text-dark);
    transition: color 0.2s var(--ease);
  }
  .post-card:hover h2 { color: var(--monet-blue-dark); }
  .post-desc {
    color: var(--text-gray);
    font-size: 0.95rem;
    line-height: 1.75;
    margin: 0 0 1.2rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .read-more {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--monet-blue-dark);
    font-weight: 600;
    font-size: 0.88rem;
  }
  .read-more svg { transition: transform 0.25s var(--ease); }
  .post-card:hover .read-more svg { transform: translateX(4px); }

  .more-wrap { text-align: center; margin-top: 2.6rem; }

  /* ---------- 热门文章 ---------- */
  .hot-section {
    max-width: 920px;
    margin: 3rem auto 0;
  }
  .hot-list {
    list-style: none;
    margin: 0;
    padding: 0.5rem;
  }
  .hot-item {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 1rem 1rem 1rem 0.8rem;
    border-radius: var(--radius-md);
    transition: background 0.25s var(--ease);
  }
  .hot-item + .hot-item { border-top: 1px dashed var(--border-light); }
  .hot-item:hover { background: linear-gradient(135deg, rgba(232,241,247,0.7), rgba(255,255,255,0)); }
  .rank-badge {
    width: 32px;
    height: 32px;
    flex: 0 0 32px;
    border-radius: 10px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 750;
    font-size: 0.92rem;
    color: var(--text-light);
    background: var(--bg-body);
    transition: all 0.25s var(--ease);
  }
  .hot-item.rank-1 .rank-badge {
    background: linear-gradient(135deg, #ffd88c, #ff9e8c);
    color: #fff;
    box-shadow: 0 3px 8px rgba(255, 158, 140, 0.28);
  }
  .hot-item.rank-2 .rank-badge {
    background: linear-gradient(135deg, #dde9f0, #c9dbe6);
    color: #3e5a6b;
  }
  .hot-item.rank-3 .rank-badge {
    background: linear-gradient(135deg, #ffe5d6, #ffcfb6);
    color: #8a4a22;
  }
  .hot-main {
    flex: 1;
    min-width: 0;
    color: inherit;
    text-decoration: none;
  }
  .hot-title-row h3 {
    margin: 0;
    font-size: 1.02rem;
    font-weight: 600;
    color: var(--text-dark);
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 0.2s var(--ease);
  }
  .hot-item:hover .hot-title-row h3 { color: var(--monet-blue-dark); }
  .hot-meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
    font-size: 0.78rem;
    color: var(--text-light);
    margin: 0.25rem 0 0.35rem;
  }
  .stat-item {
    padding: 1px 7px;
    border-radius: 10px;
    background: rgba(107, 148, 168, 0.08);
    color: var(--monet-blue-dark);
    font-weight: 500;
  }
  .hot-go {
    flex: 0 0 auto;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--monet-blue-dark);
    opacity: 0;
    transform: translateX(-6px);
    transition: all 0.25s var(--ease);
    font-weight: 700;
  }
  .hot-item:hover .hot-go {
    opacity: 1;
    transform: translateX(0);
    background: var(--monet-blue-lighter);
  }
  .empty-state.card.small {
    padding: 2rem 1.5rem;
  }
  .tag-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    padding: 0;
    margin: 0;
  }
  .tag-chip.inline {
    display: inline-flex;
    align-items: center;
    padding: 2px 9px;
    font-size: 0.72rem;
    font-weight: 500;
    border-radius: var(--radius-pill);
    background: var(--monet-blue-lighter);
    color: var(--monet-blue-dark);
    text-decoration: none;
  }

  @media (min-width: 720px) {
    .post-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) {
    .hero { padding: 3.4rem 1.2rem 2.8rem; }
    .br-pc { display: none; }
    .hero-actions { gap: 0.7rem; width: 100%; }
    .hero-actions .btn { flex: 1; min-height: 46px; padding: 11px 18px; }
    .intro { padding: 1.6rem 1.2rem; margin-bottom: 2.2rem; }
    .intro h2 { font-size: 1.25rem; }
    .intro-body p { font-size: 0.9rem; line-height: 1.9; }
    .intro-chips { gap: 0.5rem; }
    .intro-chips a { padding: 7px 13px; font-size: 0.82rem; min-height: 38px; display: inline-flex; align-items: center; }
    .latest { padding: 0 0.2rem; }
    .hot-section { margin-top: 2.2rem; }
    .hot-list { padding: 0.35rem; }
    .hot-item { padding: 0.85rem 0.7rem; gap: 0.7rem; }
    .hot-go { display: none; }
    .hot-item:hover { background: transparent; }
    .post-grid { gap: 1rem; }
    .post-card { padding: 1.35rem 1.25rem; }
    .post-card h2 { font-size: 1.15rem; }
    .post-meta { gap: 0.4rem; flex-wrap: wrap; }
    .card-author {
      display: inline-flex;
      align-items: center;
      min-height: 32px;
      padding: 2px 4px;
    }
    .more-wrap { margin-top: 2rem; }
    .more-wrap .btn { min-height: 46px; }
  }
</style>
