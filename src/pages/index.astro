---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { postQueries } from '../lib/db';

const posts = postQueries.findApproved.all() as any[];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <style>
      .hero {
        text-align: center;
        padding: 5rem 2rem 4rem;
        background: linear-gradient(135deg, #E6F0F5 0%, #FFFFFF 100%);
        border-radius: 0 0 40px 40px;
        margin-bottom: 3rem;
        animation: fadeInUp 0.6s var(--ease);
      }
      .hero h1 {
        font-size: 2.6rem;
        color: var(--monet-blue);
        font-weight: 300;
        letter-spacing: 2px;
        margin-bottom: 1rem;
      }
      .hero p {
        font-size: 1.1rem;
        color: var(--text-gray);
        max-width: 600px;
        margin: 0 auto 2rem;
      }
      .hero-actions {
        display: flex;
        justify-content: center;
        gap: 1rem;
      }

      .section-title {
        text-align: center;
        font-size: 1.6rem;
        font-weight: 400;
        color: var(--text-dark);
        margin-bottom: 2rem;
      }

      .post-list {
        display: grid;
        gap: 1.5rem;
        grid-template-columns: 1fr;
        list-style: none;
        padding: 0;
        max-width: 800px;
        margin: 0 auto;
      }
      .post-card {
        border: 1px solid var(--border-light);
        border-radius: var(--radius-lg);
        padding: 1.75rem;
        background: var(--bg-white);
        transition: var(--transition);
        display: block;
        text-decoration: none;
        color: inherit;
      }
      .post-card:hover {
        transform: translateY(-5px);
        box-shadow: var(--shadow-lg);
      }
      .post-card h2 {
        margin: 0 0 0.5rem;
        font-size: 1.4rem;
        color: var(--text-dark);
        transition: color 0.2s var(--ease);
      }
      .post-card:hover h2 { color: var(--monet-blue); }
      .post-meta {
        font-size: 0.85rem;
        color: var(--monet-blue);
        margin-bottom: 0.75rem;
        display: block;
      }
      .post-desc {
        color: var(--text-gray);
        line-height: 1.6;
        margin: 0 0 1rem;
      }
      .read-more {
        color: var(--monet-blue);
        font-weight: 500;
        font-size: 0.9rem;
      }
      .empty-state {
        text-align: center;
        padding: 3rem 1rem;
        color: var(--text-gray);
      }
      @media (min-width: 768px) {
        .post-list { grid-template-columns: 1fr 1fr; }
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <section class="hero">
        <h1>Krivy 的个人空间</h1>
        <p>在这里，记录技术成长、生活点滴与思考感悟。欢迎来到这片莫奈蓝色的静谧角落。</p>
        <div class="hero-actions">
          <a href="/blog" class="btn btn-primary">浏览文章</a>
          <a href="/about" class="btn btn-outline">关于我</a>
        </div>
      </section>

      <section style="max-width: 900px; margin: 0 auto 3rem; padding: 0 1rem;">
        <h2 class="section-title">最新文章</h2>
        {posts.length > 0 ? (
          <ul class="post-list">
            {posts.map((post) => (
              <li>
                <a href={`/blog/${post.slug}/`} class="post-card">
                  <span class="post-meta">
                    {new Date(post.created_at).toLocaleDateString('zh-CN')} · {post.author_name}
                  </span>
                  <h2>{post.title}</h2>
                  {post.description && <p class="post-desc">{post.description}</p>}
                  <span class="read-more">阅读全文 →</span>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <div class="empty-state">
            <p>暂无文章，敬请期待。</p>
            {Astro.locals.user && <a href="/write" class="btn btn-primary">发表第一篇</a>}
          </div>
        )}
      </section>
    </main>
    <Footer />
  </body>
</html>
