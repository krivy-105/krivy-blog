---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { postQueries, tagQueries, viewQueries, likeQueries, commentQueries } from '../lib/db';

const recent = postQueries.findApprovedRecent.all(6) as any[];
const totalApproved = (postQueries.countApproved.get() as { count: number }).count;
const hotPosts = postQueries.topHot.all() as any[];

// post_id -> tags 数组
const tagRows = tagQueries.forPostList.all() as { post_id: number; tags: string | null }[];
const tagMap = new Map<number, string[]>();
for (const r of tagRows) {
  if (r.tags) tagMap.set(r.post_id, r.tags.split(','));
}

// post_id -> 浏览量
const viewRows = viewQueries.countForPostList.all() as { post_id: number; count: number }[];
const viewMap = new Map<number, number>();
for (const r of viewRows) viewMap.set(r.post_id, r.count);

// 点赞数 / 评论数 Map（给热门卡片的小指标）
const likeRows = likeQueries.countForPostList.all() as { post_id: number; count: number }[];
const likeMap = new Map<number, number>();
for (const r of likeRows) likeMap.set(r.post_id, r.count);

const cmtRows = commentQueries.countForPostList.all() as { post_id: number; count: number }[];
const cmtMap = new Map<number, number>();
for (const r of cmtRows) cmtMap.set(r.post_id, r.count);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <!-- 站点级结构化数据：让搜索结果出现「站内搜索框」等增强展示 -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: SITE_TITLE,
        description: SITE_DESCRIPTION,
        url: new URL('/', Astro.site).toString(),
        inLanguage: 'zh-CN',
        potentialAction: {
          '@type': 'SearchAction',
          target: {
            '@type': 'EntryPoint',
            urlTemplate: new URL('/search?q={search_term_string}', Astro.site).toString(),
          },
          'query-input': 'required name=search_term_string',
        },
      })}
    />
  </head>
  <body>
    <Header />

    <!-- 首屏 -->
    <section class="hero">
      <!-- 浮游光点：纯装饰，极缓上升，营造水面浮光的空气感 -->
      <div class="hero-motes" aria-hidden="true">
        <span></span><span></span><span></span>
        <span></span><span></span><span></span>
        <span></span><span></span><span></span>
        <span></span><span></span><span></span>
      </div>
      <div class="hero-inner">
        <span class="hero-eyebrow">KRIVY · CYOU</span>
        <h1>want to see you</h1>
        <p class="hero-sub">
          技术笔记、课程记录，和偶尔的生活片段。<br class="br-pc" />
          写给自己，也留给路过的人。
        </p>
        <div class="hero-actions">
          <a href="/blog" class="btn btn-primary">浏览文章</a>
          <a href="/about" class="btn btn-outline">关于本站</a>
        </div>
      </div>
    </section>

    <main>
      <!-- 站点简介 -->
      <section class="intro card">
        <span class="eyebrow">ABOUT HERE</span>
        <h2>一个安静写作的地方</h2>
        <div class="intro-body">
          <p>
            「want to see you」是我的长期笔记本：技术笔记、课程记录，还有一些当时没想清楚的问题。
            文章按标签归档，成体系的收进连载。
          </p>
          <p>
            你也可以在这里写。注册后就能发文章，编辑器支持 Markdown、实时预览和草稿自动保存。
            读到喜欢的可以点赞、收藏、评论；关注作者，更新会出现在你的动态里。
          </p>
          <p class="intro-end">没有算法推荐，也没有催更提醒。随便翻翻，想写了就写。</p>
        </div>
        <ul class="intro-chips">
          <li><a href="/blog"><Icon name="book" size={16} /> 浏览文章</a></li>
          <li><a href="/tags"><Icon name="tag" size={16} /> 按标签找</a></li>
          <li><a href="/series"><Icon name="file" size={16} /> 系列连载</a></li>
          <li><a href="/write"><Icon name="pen" size={16} /> 开始写作</a></li>
        </ul>
      </section>

      <section class="latest">
        <div class="section-head">
          <span class="eyebrow">LATEST POSTS</span>
          <h2>最新文章</h2>
        </div>

        {recent.length > 0 ? (
          <ul class="post-grid">
            {recent.map((post, i) => (
              <li style={`animation-delay: ${i * 70}ms`}>
                <div class={`post-card${post.pinned_at ? ' is-pinned' : ''}`}>
                  <a
                    href={`/blog/${post.slug}/`}
                    class="post-card-link"
                    aria-label={`阅读文章：${post.title}`}
                  ></a>
                  <div class="post-meta">
                    {post.pinned_at && <span class="pin-badge"><Icon name="pin" size={13} /> 置顶</span>}
                    <span>{new Date(post.created_at).toLocaleDateString('zh-CN', { timeZone: 'Asia/Shanghai', year: 'numeric', month: 'long', day: 'numeric' })}</span>
                    <span class="meta-dot">·</span>
                    <a class="card-author" href={`/users/${post.author_name}`}>{post.author_name}</a>
                    {viewMap.has(post.id) && (
                      <>
                        <span class="meta-dot">·</span>
                        <span class="view-count"><Icon name="eye" size={13} /> {viewMap.get(post.id)}</span>
                      </>
                    )}
                  </div>
                  <h2>{post.title}</h2>
                  {post.description && <p class="post-desc">{post.description}</p>}
                  {(tagMap.get(post.id) || []).length > 0 && (
                    <ul class="tag-list">
                      {tagMap.get(post.id)!.map((t) => (
                        <li><a class="tag-chip" href={`/tags/${t}/`}>{t}</a></li>
                      ))}
                    </ul>
                  )}
                  <span class="read-more">
                    阅读全文
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                  </span>
                </div>
              </li>
            ))}
          </ul>
        ) : (
          <div class="empty-state card">
            <div class="empty-icon"><Icon name="pen" size={32} /></div>
            <p>暂时还没有文章，第一篇的位置给你留着。</p>
            {Astro.locals.user && <a href="/write" class="btn btn-primary">写第一篇</a>}
          </div>
        )}

        {totalApproved > recent.length && (
          <div class="more-wrap">
            <a href="/blog" class="btn btn-outline">查看全部 {totalApproved} 篇 →</a>
          </div>
        )}
      </section>

      <section class="hot-section">
        <div class="section-head">
          <span class="eyebrow">HOT POSTS · <Icon name="flame" size={13} /></span>
          <h2>热门文章</h2>
        </div>

        {hotPosts.length > 0 ? (
          <ol class="hot-list card">
            {hotPosts.map((post, i) => (
              <li class={`hot-item rank-${i + 1}${post.pinned_at ? ' is-pinned' : ''}`}>
                <div class="rank-badge" aria-hidden="true">{i + 1}</div>
                {/* 这里不能用 <a> 包住整块：里面还有作者 <a>，a 不能嵌套 a，
                    浏览器会把外层 a 强行闭合，导致日期/标签被挤成兄弟节点、
                    标题宽度算成 0（移动端表现为文字重叠）。
                    改用 div + 一个绝对定位的覆盖链接。 */}
                <div class="hot-main">
                  <div class="hot-title-row">
                    <h3>{post.title}</h3>
                  </div>
                  <div class="hot-meta">
                    <span>{new Date(post.created_at).toLocaleDateString('zh-CN', { timeZone: 'Asia/Shanghai' })}</span>
                    <span class="meta-dot">·</span>
                    <a class="card-author" href={`/users/${post.author_name}`}>{post.author_name}</a>
                    <span class="meta-dot">·</span>
                    <span class="stat-item"><Icon name="eye" size={13} /> {viewMap.get(post.id) || 0}</span>
                    <span class="stat-item"><Icon name="heart" size={13} /> {likeMap.get(post.id) || 0}</span>
                    <span class="stat-item"><Icon name="message" size={13} /> {cmtMap.get(post.id) || 0}</span>
                  </div>
                  {(tagMap.get(post.id) || []).length > 0 && (
                    <ul class="tag-list">
                      {tagMap.get(post.id)!.slice(0, 3).map((t) => (
                        <li><span class="tag-chip inline">{t}</span></li>
                      ))}
                    </ul>
                  )}
                </div>
                <a class="hot-cover" href={`/blog/${post.slug}/`} aria-label={`阅读：${post.title}`}></a>
                <a href={`/blog/${post.slug}/`} class="hot-go" aria-label="进入文章">
                  <Icon name="arrowRight" size={16} />
                </a>
              </li>
            ))}
          </ol>
        ) : (
          <div class="empty-state card small">
            <div class="empty-icon"><Icon name="flame" size={32} /></div>
            <p>还没有热门数据。文章被阅读、点赞、评论后，会按热度排在这里。</p>
          </div>
        )}
      </section>
    </main>
    <Footer />
  </body>
</html>

<style>
  /* ---------- 首屏 ---------- */
  .hero {
    position: relative;
    padding: 5.8rem 1.5rem 4.8rem;
    text-align: center;
    overflow: hidden;
    isolation: isolate;
  }
  .hero::before,
  .hero::after {
    content: '';
    position: absolute;
    border-radius: 50%;
    filter: blur(8px);
    pointer-events: none;
    z-index: -1;
  }
  .hero::before {
    width: 420px;
    height: 420px;
    top: -140px;
    left: 50%;
    /* --par-x/--par-y 由指针位置驱动（-1 ~ 1），两层光斑反向位移产生纵深 */
    transform: translateX(-58%) translate3d(calc(var(--par-x, 0) * 18px), calc(var(--par-y, 0) * 12px), 0);
    background: radial-gradient(circle, rgba(126, 166, 184, 0.28), transparent 68%);
  }
  .hero::after {
    width: 280px;
    height: 280px;
    right: 8%;
    bottom: -40px;
    transform: translate3d(calc(var(--par-x, 0) * -24px), calc(var(--par-y, 0) * -16px), 0);
    background: radial-gradient(circle, rgba(143, 180, 197, 0.18), transparent 70%);
  }
  .hero-inner {
    max-width: 720px;
    margin: 0 auto;
  }
  /* 入场分四拍：眉标 → 标题 → 副文 → 按钮，形成呼吸般的节奏 */
  .hero-eyebrow { animation: hero-rise 0.72s var(--ease-out-expo) both; }
  .hero-sub { animation: hero-rise 0.85s var(--ease-out-expo) 0.2s both; }
  .hero-actions { animation: hero-rise 0.85s var(--ease-out-expo) 0.32s both; }

  @keyframes hero-rise {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* 标题：渐变光带极缓流动，像水面反光扫过一行字 */
  @keyframes title-flow {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  /* ---------- 浮游光点 ---------- */
  .hero-motes {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }
  .hero-motes span {
    position: absolute;
    bottom: -10px;
    left: var(--x, 50%);
    width: var(--s, 5px);
    height: var(--s, 5px);
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(255, 255, 255, 0.95) 0%,
      rgba(143, 180, 197, 0.6) 45%,
      transparent 72%
    );
    box-shadow: 0 0 16px rgba(107, 148, 168, 0.6);
    opacity: 0;
    animation: mote-rise var(--dur, 26s) linear var(--delay, 0s) infinite;
  }
  .hero-motes span:nth-child(1) { --x: 6%; --s: 6px; --dur: 27s; --delay: -2s; --drift: 26px; }
  .hero-motes span:nth-child(2) { --x: 17%; --s: 3px; --dur: 21s; --delay: -14s; --drift: -20px; }
  .hero-motes span:nth-child(3) { --x: 27%; --s: 5px; --dur: 24s; --delay: -9s; --drift: -18px; }
  .hero-motes span:nth-child(4) { --x: 36%; --s: 4px; --dur: 29s; --delay: -19s; --drift: 22px; }
  .hero-motes span:nth-child(5) { --x: 43%; --s: 6px; --dur: 31s; --delay: -16s; --drift: 30px; }
  .hero-motes span:nth-child(6) { --x: 52%; --s: 3px; --dur: 23s; --delay: -5s; --drift: -26px; }
  .hero-motes span:nth-child(7) { --x: 61%; --s: 4px; --dur: 26s; --delay: -6s; --drift: -24px; }
  .hero-motes span:nth-child(8) { --x: 69%; --s: 5px; --dur: 32s; --delay: -22s; --drift: 18px; }
  .hero-motes span:nth-child(9) { --x: 78%; --s: 6px; --dur: 29s; --delay: -13s; --drift: 16px; }
  .hero-motes span:nth-child(10) { --x: 86%; --s: 3px; --dur: 22s; --delay: -17s; --drift: -32px; }
  .hero-motes span:nth-child(11) { --x: 92%; --s: 4px; --dur: 25s; --delay: -20s; --drift: -28px; }
  .hero-motes span:nth-child(12) { --x: 96%; --s: 5px; --dur: 28s; --delay: -11s; --drift: 22px; }

  @keyframes mote-rise {
    0% { opacity: 0; transform: translate3d(0, 0, 0) scale(0.8); }
    14% { opacity: 0.78; }
    72% { opacity: 0.42; }
    100% { opacity: 0; transform: translate3d(var(--drift, 20px), -380px, 0) scale(1.15); }
  }
  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.76rem;
    letter-spacing: 0.34em;
    color: var(--monet-blue-dark);
    font-weight: 650;
    margin-bottom: 1.1rem;
    padding: 0.35rem 0.9rem 0.35rem 0.75rem;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--bg-white) 70%, transparent);
    border: 1px solid color-mix(in srgb, var(--monet-blue) 22%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: var(--shadow-sm);
  }
  .hero-eyebrow::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: linear-gradient(135deg, #9fc3d2, #5f889d);
    box-shadow: 0 0 0 4px rgba(95, 136, 157, 0.14);
  }
  .hero h1 {
    font-size: clamp(2.2rem, 5.4vw, 3.15rem);
    font-weight: 700;
    color: var(--text-dark);
    margin-bottom: 1rem;
    letter-spacing: 0.02em;
    /* 中间一段稍亮的蓝，配合 title-flow 缓慢横移 = 水光掠过字面 */
    background-image: linear-gradient(
      100deg,
      var(--text-dark) 0%,
      var(--text-dark) 34%,
      var(--monet-blue-dark) 47%,
      var(--monet-blue) 52%,
      var(--text-dark) 66%,
      var(--text-dark) 100%
    );
    background-size: 240% 100%;
    background-position: 0% 50%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation:
      hero-rise 0.95s var(--ease-out-expo) 0.06s both,
      title-flow 7.5s ease-in-out 1.8s infinite;
  }
  :global([data-theme="dark"]) .hero h1 {
    background-image: linear-gradient(
      100deg,
      #e8eef2 0%,
      #e8eef2 34%,
      #cbe0e9 47%,
      #a8c7d4 52%,
      #e8eef2 66%,
      #e8eef2 100%
    );
    background-size: 240% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero-sub {
    font-size: clamp(1rem, 2vw, 1.12rem);
    color: var(--text-gray);
    line-height: 1.9;
    margin-bottom: 2.2rem;
  }
  .hero-actions {
    display: flex;
    justify-content: center;
    gap: 0.9rem;
    flex-wrap: wrap;
  }

  /* ---------- 站点简介 ---------- */
  .intro {
    max-width: 920px;
    margin: 0 auto 3.2rem;
    padding: 2.2rem 2.4rem;
    text-align: center;
    background:
      radial-gradient(520px 200px at 50% -30%, rgba(126, 166, 184, 0.14), transparent 70%),
      var(--glass-bg);
    border: 1px solid var(--glass-border);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }
  .intro h2 {
    margin: 0.5rem 0 1.2rem;
    font-size: 1.45rem;
    font-weight: 650;
    color: var(--text-dark);
    letter-spacing: 0.02em;
  }
  .intro-body {
    max-width: 660px;
    margin: 0 auto;
  }
  .intro-body p {
    margin: 0 0 0.9rem;
    font-size: 0.96rem;
    line-height: 2;
    color: var(--text-gray);
  }
  .intro-end {
    margin-bottom: 0 !important;
    color: var(--monet-blue-dark) !important;
    font-weight: 550;
  }
  .intro-chips {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
    padding: 0;
    margin: 1.5rem 0 0;
  }
  .intro-chips a {
    display: inline-flex;
    align-items: center;
    padding: 7px 16px;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--monet-blue-lighter) 88%, transparent);
    color: var(--monet-blue-dark);
    font-size: 0.86rem;
    font-weight: 550;
    text-decoration: none;
    border: 1px solid color-mix(in srgb, var(--monet-blue) 18%, transparent);
    transition: var(--transition);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.35) inset;
  }
  .intro-chips a:hover {
    background: var(--bg-white);
    border-color: var(--monet-blue-light);
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
  }

  /* ---------- 文章网格 ---------- */
  .latest { max-width: 920px; margin: 0 auto; }
  .post-grid {
    display: grid;
    gap: 1.4rem;
    grid-template-columns: 1fr;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .post-grid li {
    animation: fadeInUp 0.55s var(--ease) both;
  }
  .post-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.7rem 1.8rem;
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--bg-white) 92%, transparent), var(--glass-bg)),
      var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    color: inherit;
    transition: var(--transition);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    overflow: hidden;
  }
  .post-card::before {
    content: '';
    position: absolute;
    inset: 0 auto auto 0;
    width: 100%;
    height: 3px;
    background: linear-gradient(90deg, transparent, rgba(126, 166, 184, 0.55), transparent);
    opacity: 0;
    transition: opacity 0.25s var(--ease);
  }
  .post-card-link {
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: inherit;
  }
  .card-author {
    position: relative;
    z-index: 1;
  }
  .card-author:hover { text-decoration: underline; }
  .post-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--glow-soft);
    border-color: color-mix(in srgb, var(--monet-blue) 35%, var(--border-light));
  }
  .post-card:hover::before { opacity: 1; }
  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.83rem;
    color: var(--monet-blue-dark);
    font-weight: 500;
    margin-bottom: 0.75rem;
  }
  .meta-dot { color: var(--text-light); }
  .post-card h2 {
    margin: 0 0 0.55rem;
    font-size: 1.28rem;
    line-height: 1.45;
    color: var(--text-dark);
    transition: color 0.2s var(--ease);
  }
  .post-card:hover h2 { color: var(--monet-blue-dark); }
  .post-desc {
    color: var(--text-gray);
    font-size: 0.95rem;
    line-height: 1.75;
    margin: 0 0 1.2rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .read-more {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--monet-blue-dark);
    font-weight: 600;
    font-size: 0.88rem;
  }
  .read-more svg { transition: transform 0.25s var(--ease); }
  .post-card:hover .read-more svg { transform: translateX(4px); }

  .more-wrap { text-align: center; margin-top: 2.6rem; }

  /* ---------- 热门文章 ---------- */
  .hot-section {
    max-width: 920px;
    margin: 3rem auto 0;
  }
  .hot-list {
    list-style: none;
    margin: 0;
    padding: 0.5rem;
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  .hot-item {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.9rem;
