---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
import { changelog, type ChangelogEntry } from '../data/changelog';

const typeLabels: Record<ChangelogEntry['type'], string> = {
  feat: '功能',
  fix: '修复',
  style: '视觉',
  perf: '优化',
  security: '安全',
};

// 筛选按钮用的短标签（不带 emoji，省空间）
const typeShort: Record<ChangelogEntry['type'], string> = {
  feat: '功能',
  fix: '修复',
  style: '视觉',
  perf: '优化',
  security: '安全',
};

const typeOrder: ChangelogEntry['type'][] = ['feat', 'fix', 'style', 'perf', 'security'];
// 折叠态一次只列这么多，其余点按钮展开，避免日志墙
const COLLAPSED_LIMIT = 6;
import Icon from '../components/Icon.astro';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={`关于本站 - ${SITE_TITLE}`} description="关于本站：一台自己的服务器、一个数据库文件，说说这个博客是怎么搭起来的。" />
  </head>
  <body>
    <Header />
    <main class="about-page">
      <header class="about-hero">
        <div class="avatar"><Icon name="wrench" size={32} /></div>
        <h1>关于本站</h1>
        <p class="about-sub">从页面到服务器都是自己搭的。下面说清楚它怎么跑，以及为什么这么搭。</p>
      </header>

      <div class="about-grid">
        <div class="about-content prose">
          <p class="about-lead">
            这个站没有用现成的博客系统。文章、评论、标签都存在自己的数据库里，
            页面在服务器上渲染好再发出去，整套东西跑在一台我自己维护的机器上。
            下面分几段说清楚。
          </p>

          <h3>用什么搭的</h3>
          <p>
            页面框架是 Astro，由 Node 在服务器端渲染，所以你收到的是完整 HTML，
            不用等浏览器再拼一次。私信和通知走 WebSocket 推送，不需要轮询刷新。
            除此之外没有别的依赖：不接第三方博客平台，也没有独立的数据库服务。
          </p>

          <h3>数据放在哪</h3>
          <p>
            文字内容存在一个 SQLite 数据库文件里，上传的图片放在同一个数据目录。
            迁移时整包拷走就行；更新代码、重启服务都不会碰到它。
            服务每天自动备份一次，保留最近 7 份。
          </p>

          <h3>安全</h3>
          <p>
            密码只存哈希，不存明文；登录状态靠 HttpOnly cookie 维持。
            用户提交的内容在输出前统一过滤，避免有人注入脚本。
            头像上传后先进人工审核队列，通过之后才会上线。
          </p>

          <h3>怎么上线</h3>
          <p>
            改完代码跑一次部署脚本：构建、替换产物、重启容器，一般二三十秒，
            期间站点仍然可以访问。对外通过 Cloudflare Tunnel 接入，
            服务器不用暴露公网端口，放在内网也能正常提供服务。
          </p>

          <blockquote>一台自己的机器，一个数据库文件，没有多余依赖。</blockquote>
        </div>

        <aside class="changelog-aside" aria-label="站点更新日志">
          <div class="cl-bar">
            <h2 class="cl-title"><Icon name="calendar" size={22} /> 更新日志</h2>
            <span class="cl-count">{changelog.length} 条</span>
          </div>

          <div class="cl-filters" role="group" aria-label="按类型筛选更新日志">
            <button type="button" class="cl-filter is-active" data-filter="all">全部</button>
            {typeOrder.map((t) => (
              <button type="button" class="cl-filter" data-filter={t}>{typeShort[t]}</button>
            ))}
          </div>

          <ol class="cl-list" id="clList">
            {changelog.map((e, i) => (
              <li class="cl-item" data-type={e.type}>
                <details class="cl-card" open={i === 0}>
                  <summary class="cl-summary">
                    <span class="cl-meta">
                      <span class="cl-tag">{typeLabels[e.type]}</span>
                      <time class="cl-date" datetime={e.date} title={e.date}>{e.date.slice(5)}</time>
                    </span>
                    {e.detail && e.detail.length > 0 && (
                      <svg class="cl-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M6 9l6 6 6-6" />
                      </svg>
                    )}
                    <span class="cl-name">{e.title}</span>
                  </summary>
                  {e.detail && e.detail.length > 0 && (
                    <ul class="cl-detail">
                      {e.detail.map((d) => <li>{d}</li>)}
                    </ul>
                  )}
                </details>
              </li>
            ))}
          </ol>

          <button type="button" class="cl-more" id="clMore" hidden></button>
          <p class="cl-foot">持续更新</p>
        </aside>
      </div>
    </main>
    <Footer />
    <script>
      // 更新日志：类型筛选 + 折叠长列表（无 JS 时全量可读，脚本只做增强）
      var listEl = document.getElementById('clList');
      var items = Array.prototype.slice.call(document.querySelectorAll('.cl-item'));
      var moreBtn = document.getElementById('clMore');
      var filterBtns = Array.prototype.slice.call(document.querySelectorAll('.cl-filter'));
      // 折叠时先显示几条（改动时和上方 COLLAPSED_LIMIT 保持一致）
      var LIMIT = 6;
      var activeType = 'all';
      var expanded = false;

      function apply() {
        var matched = items.filter(function (el) {
          return activeType === 'all' || el.dataset.type === activeType;
        });
        var limit = activeType === 'all' && !expanded ? Math.min(LIMIT, matched.length) : matched.length;

        items.forEach(function (el) { el.hidden = true; });
        matched.slice(0, limit).forEach(function (el) { el.hidden = false; });

        var rest = matched.length - limit;
        if (moreBtn) {
          moreBtn.hidden = rest <= 0;
          moreBtn.textContent = rest > 0 ? '展开剩余 ' + rest + ' 条 →' : '';
        }
        if (listEl) listEl.classList.toggle('is-empty', matched.length === 0);
      }

      filterBtns.forEach(function (btn) {
        btn.addEventListener('click', function () {
          activeType = btn.dataset.filter || 'all';
          expanded = false;
          filterBtns.forEach(function (b) { b.classList.toggle('is-active', b === btn); });
          // 切换筛选后自动展开第一条匹配项，省一次点击
          var first = items.filter(function (el) {
            return activeType === 'all' || el.dataset.type === activeType;
          })[0];
          var box = first && first.querySelector('details');
          if (box) box.setAttribute('open', '');
          apply();
        });
      });

      if (moreBtn) {
        moreBtn.addEventListener('click', function () {
          expanded = true;
          apply();
        });
      }

      apply();
    </script>
  </body>
</html>

<style>
  .about-page {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  .about-hero {
    text-align: center;
    padding: 1.5rem 0 2.2rem;
  }
  .avatar {
    width: 92px;
    height: 92px;
    margin: 0 auto 1.2rem;
    border-radius: 28px;
    background: linear-gradient(135deg, #8fb4c5 0%, #5f889d 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.4rem;
    color: #fff;
    box-shadow: 0 12px 30px rgba(95, 136, 157, 0.3);
    animation: fadeInUp 0.55s var(--ease);
  }
  .about-hero h1 { margin-bottom: 0.4rem; }
  .about-sub {
    color: var(--text-gray);
    font-size: 1rem;
    margin: 0;
  }
  .about-content {
    animation: fadeIn 0.5s var(--ease) 0.1s both;
  }
  /* 开场白：比正文稍大、左侧一道主色竖线，和下面的小节区分开 */
  .about-content .about-lead {
    font-size: 1.05rem;
    line-height: 1.95;
    color: var(--text-gray);
    padding-left: 0.95rem;
    border-left: 3px solid color-mix(in srgb, var(--monet-blue) 45%, transparent);
    margin: 0 0 1.9rem;
    padding-bottom: 0.1rem;
  }
  .about-content blockquote {
    text-align: center;
    font-size: 1.05rem;
    color: var(--monet-blue-dark);
    background: var(--monet-blue-lighter);
  }

  /* 双栏：左内容 + 右更新日志 */
  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 400px;
    gap: 2.2rem;
    align-items: start;
    padding-bottom: 1.5rem;
  }

  /* ---- 更新日志（紧凑时间轴） ---- */
  .changelog-aside {
    animation: fadeIn 0.5s var(--ease) 0.15s both;
  }

  /* 标题行 + 条数 */
  .cl-bar {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.6rem;
    margin-bottom: 0.8rem;
  }
  .cl-title {
    font-size: 1.12rem;
    margin: 0;
    color: var(--monet-blue-dark);
  }
  .cl-count {
    font-size: 0.76rem;
    color: var(--text-light);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  /* 类型筛选 */
  .cl-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-bottom: 0.9rem;
  }
  .cl-filter {
    font-family: inherit;
    font-size: 0.76rem;
    line-height: 1;
    padding: 0.4rem 0.66rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border-light);
    background: var(--glass-bg);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: var(--text-gray);
    cursor: pointer;
    transition: var(--transition);
  }
  .cl-filter:hover {
    border-color: var(--monet-blue);
    color: var(--monet-blue-dark);
    transform: translateY(-1px);
  }
  .cl-filter.is-active {
    background: var(--monet-blue);
    border-color: var(--monet-blue);
    color: #fff;
    box-shadow: 0 3px 10px rgba(95, 136, 157, 0.24);
  }

  /* 列表 */
  .cl-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .cl-list.is-empty::after {
    content: '这个分类下暂时没有记录';
    display: block;
    text-align: center;
    color: var(--text-light);
    font-size: 0.84rem;
    padding: 1.6rem 0;
  }
  .cl-item {
    margin-bottom: 0.5rem;
  }
  .cl-item[hidden] {
    display: none !important;
  }

  .cl-card {
    background: var(--glass-bg);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    transition: var(--transition);
    overflow: hidden;
  }
  .cl-card:hover {
    border-color: color-mix(in srgb, var(--monet-blue) 32%, var(--border-light));
  }
  .cl-card[open] {
    border-color: color-mix(in srgb, var(--monet-blue) 40%, var(--border-light));
    box-shadow: var(--glow-soft);
  }

  /* summary：第一行「标签 + 日期 + 箭头」，第二行标题 */
  .cl-summary {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 0.3rem 0.5rem;
    padding: 0.62rem 0.8rem;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }
  .cl-summary::-webkit-details-marker { display: none; }
  .cl-summary:hover .cl-name { color: var(--monet-blue-dark); }

  .cl-meta {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    min-width: 0;
  }
  .cl-tag {
    font-size: 0.7rem;
    line-height: 1.7;
    padding: 0 0.5rem;
    border-radius: var(--radius-pill);
    white-space: nowrap;
  }
  .cl-date {
    font-size: 0.72rem;
    color: var(--text-light);
    font-variant-numeric: tabular-nums;
  }
  .cl-arrow {
    color: var(--text-light);
    transition: transform 0.25s var(--ease);
    flex: 0 0 auto;
  }
  .cl-card[open] .cl-arrow { transform: rotate(180deg); }

  .cl-name {
    grid-column: 1 / -1;
    font-size: 0.92rem;
    font-weight: 600;
    line-height: 1.45;
    color: var(--text-dark);
    transition: color 0.2s var(--ease);
  }

  /* 类型配色 */
  .cl-card[data-type='feat'] .cl-tag {
    color: var(--monet-blue-dark);
    background: var(--monet-blue-lighter);
  }
  .cl-card[data-type='fix'] .cl-tag {
    color: #cc6a3d;
    background: rgba(255, 165, 85, 0.14);
  }
  .cl-card[data-type='style'] .cl-tag {
    color: #8a63c3;
    background: rgba(160, 120, 220, 0.14);
  }
  .cl-card[data-type='perf'] .cl-tag {
    color: #2e8b8b;
    background: rgba(80, 190, 190, 0.14);
  }
  .cl-card[data-type='security'] .cl-tag {
    color: #3d8a4e;
    background: rgba(110, 190, 130, 0.16);
  }

  /* 展开后的明细：小一号、更紧凑，避免日志墙 */
  .cl-detail {
    list-style: none;
    margin: 0;
    padding: 0 0.85rem 0.75rem;
  }
  .cl-detail li {
    position: relative;
    padding-left: 0.85rem;
    font-size: 0.8rem;
    line-height: 1.6;
    color: var(--text-gray);
    margin-bottom: 0.22rem;
  }
  .cl-detail li:last-child { margin-bottom: 0; }
  .cl-detail li::before {
    content: '';
    position: absolute;
    left: 0.08rem;
    top: 0.6em;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--monet-blue);
    opacity: 0.5;
  }

  /* 展开剩余 N 条 */
  .cl-more {
    display: block;
    width: 100%;
    margin-top: 0.3rem;
    padding: 0.6rem;
    font-family: inherit;
    font-size: 0.82rem;
    color: var(--monet-blue-dark);
    background: var(--monet-blue-lighter);
    border: 1px dashed color-mix(in srgb, var(--monet-blue) 38%, transparent);
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: var(--transition);
  }
  .cl-more[hidden] { display: none; }
  .cl-more:hover {
    background: var(--monet-blue-light);
    border-style: solid;
    transform: translateY(-1px);
  }
  .cl-foot {
    text-align: center;
    color: var(--text-light);
    font-size: 0.78rem;
    margin: 0.8rem 0 0;
  }

  :global([data-theme="dark"]) .cl-card {
    background: rgba(22, 31, 36, 0.65);
    border-color: rgba(255, 255, 255, 0.08);
  }
  :global([data-theme="dark"]) .cl-filter {
    background: rgba(22, 31, 36, 0.65);
    border-color: rgba(255, 255, 255, 0.1);
  }
  :global([data-theme="dark"]) .cl-more {
    background: rgba(143, 180, 197, 0.1);
  }

  @media (max-width: 1080px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 1.6rem;
    }
    /* 单栏布局下日志变宽，两列排会更省纵向空间 */
    .cl-list {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.5rem;
      align-items: start;
    }
    .cl-item { margin-bottom: 0; }
  }
  @media (max-width: 560px) {
    .about-page { padding: 0 1rem; }
    .cl-list { display: block; }
    .cl-item { margin-bottom: 0.5rem; }
    .cl-summary { padding: 0.6rem 0.7rem; }
    .cl-name { font-size: 0.88rem; }
  }
</style>
