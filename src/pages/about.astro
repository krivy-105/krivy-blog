---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
import { changelog, type ChangelogEntry } from '../data/changelog';

const typeLabels: Record<ChangelogEntry['type'], string> = {
  feat: '✨ 功能',
  fix: '🛠 修复',
  style: '🎨 视觉',
  perf: '⚡ 优化',
  security: '🛡 安全',
};
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={`关于本站 - ${SITE_TITLE}`} description="这个站点的技术实现：Astro SSR、SQLite、FTS5 与部署方案" />
  </head>
  <body>
    <Header />
    <main class="about-page">
      <header class="about-hero">
        <div class="avatar">🛠️</div>
        <h1>关于本站</h1>
        <p class="about-sub">简单交代下，这个站是怎么跑起来的。</p>
      </header>

      <div class="about-grid">
        <div class="about-content prose">
          <h3>架构</h3>
          <p>
            Astro 7 SSR + <code>@astrojs/node</code>（Node 22），入口是自己写的一层
            <code>server.mjs</code>，顺带用 <code>ws</code> 挂了 WebSocket——私信因此是实时推送，而非轮询。
          </p>
          <h3>数据</h3>
          <p>
            全部状态收敛进一个 SQLite 文件（<code>better-sqlite3</code>，同步 API + 事务）；
            全文检索直接用 FTS5，触发器维护索引，文章增删改无需手动同步。
            数据库与上传文件落在挂载的持久卷上，重新部署也不丢数据。
          </p>
          <h3>安全与处理</h3>
          <p>
            bcrypt 存密码，session cookie 走 <code>httpOnly</code> + <code>sameSite=lax</code>；
            头像经 sharp 自动旋转、居中裁剪为 256×256 的 WebP，上传后先进人工审核队列；
            正文用 marked 渲染，写作页带工具栏、实时预览和本地草稿自动保存。
          </p>
          <h3>部署</h3>
          <p>
            代码托管在 GitHub，推送到 <code>main</code> 后由 Railway 自动构建运行，前置 Cloudflare 边缘缓存——
            静态资源缓存一年，匿名页面在边缘节点缓存 30 秒，登录态与私有路径自动绕过；
            站点另带 sitemap、明暗模式与移动端自适应。
          </p>
          <blockquote>一个仓库、一个进程、一个 .db 文件——够用，且好维护。</blockquote>
        </div>

        <aside class="changelog-aside" aria-label="站点更新日志">
          <h2 class="cl-title">🗓️ 更新日志</h2>
          <div class="changelog-cols">
            {changelog.map((e) => (
              <article class="cl-card" data-type={e.type}>
                <div class="cl-head">
                  <time datetime={e.date}>{e.date}</time>
                  <span class="cl-tag">{typeLabels[e.type]}</span>
                </div>
                <h3>{e.title}</h3>
                {e.detail && e.detail.length > 0 && (
                  <ul>
                    {e.detail.map((d) => <li>{d}</li>)}
                  </ul>
                )}
              </article>
            ))}
          </div>
          <p class="cl-more">…持续更新中</p>
        </aside>
      </div>
    </main>
    <Footer />
  </body>
</html>

<style>
  .about-page {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  .about-hero {
    text-align: center;
    padding: 1.5rem 0 2.2rem;
  }
  .avatar {
    width: 92px;
    height: 92px;
    margin: 0 auto 1.2rem;
    border-radius: 28px;
    background: linear-gradient(135deg, #8fb4c5 0%, #5f889d 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.4rem;
    color: #fff;
    box-shadow: 0 12px 30px rgba(95, 136, 157, 0.3);
    animation: fadeInUp 0.55s var(--ease);
  }
  .about-hero h1 { margin-bottom: 0.4rem; }
  .about-sub {
    color: var(--text-gray);
    font-size: 1rem;
    margin: 0;
  }
  .about-content {
    animation: fadeIn 0.5s var(--ease) 0.1s both;
  }
  .about-content blockquote {
    text-align: center;
    font-size: 1.05rem;
    color: var(--monet-blue-dark);
    background: var(--monet-blue-lighter);
  }

  /* 双栏：左内容 + 右更新日志 */
  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 400px;
    gap: 2.2rem;
    align-items: start;
    padding-bottom: 1.5rem;
  }

  /* ---- 更新日志（瀑布流） ---- */
  .changelog-aside {
    animation: fadeIn 0.5s var(--ease) 0.15s both;
  }
  .cl-title {
    font-size: 1.12rem;
    margin: 0 0 1rem;
    color: var(--monet-blue-dark);
  }
  .changelog-cols {
    columns: 2;
    column-gap: 1rem;
  }
  .cl-card {
    break-inside: avoid;
    margin: 0 0 1rem;
    background: var(--bg-white);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    padding: 0.9rem 1rem 1rem;
    transition: var(--transition);
  }
  .cl-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }
  .cl-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.45rem;
  }
  .cl-head time {
    font-size: 0.74rem;
    color: var(--text-light);
    font-variant-numeric: tabular-nums;
  }
  .cl-tag {
    font-size: 0.72rem;
    padding: 0.14rem 0.55rem;
    border-radius: var(--radius-pill);
    white-space: nowrap;
  }
  .cl-card[data-type='feat'] .cl-tag {
    color: var(--monet-blue-dark);
    background: var(--monet-blue-lighter);
  }
  .cl-card[data-type='fix'] .cl-tag {
    color: #cc6a3d;
    background: rgba(255, 165, 85, 0.14);
  }
  .cl-card[data-type='style'] .cl-tag {
    color: #8a63c3;
    background: rgba(160, 120, 220, 0.14);
  }
  .cl-card[data-type='perf'] .cl-tag {
    color: #2e8b8b;
    background: rgba(80, 190, 190, 0.14);
  }
  .cl-card[data-type='security'] .cl-tag {
    color: #3d8a4e;
    background: rgba(110, 190, 130, 0.16);
  }
  .cl-card h3 {
    font-size: 0.98rem;
    margin: 0 0 0.4rem;
    line-height: 1.4;
  }
  .cl-card ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .cl-card li {
    position: relative;
    padding-left: 0.9rem;
    font-size: 0.82rem;
    line-height: 1.55;
    color: var(--text-gray);
    margin-bottom: 0.2rem;
  }
  .cl-card li::before {
    content: '';
    position: absolute;
    left: 0.1rem;
    top: 0.52em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--monet-blue);
    opacity: 0.55;
  }
  .cl-more {
    text-align: center;
    color: var(--text-light);
    font-size: 0.82rem;
    margin: 0.2rem 0 0;
  }

  :global([data-theme="dark"]) .cl-card {
    background: rgba(22, 31, 36, 0.65);
    border-color: rgba(255, 255, 255, 0.08);
  }

  @media (max-width: 1080px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 1.6rem;
    }
    .changelog-cols { columns: 2; }
  }
  @media (max-width: 560px) {
    .about-page { padding: 0 1rem; }
    .changelog-cols { columns: 1; }
  }
</style>
