---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import { followQueries, userQueries, type User } from '../lib/db';

const user = Astro.locals.user as User | undefined;
if (!user) {
  return Astro.redirect('/login?redirect=/feed');
}

const feedPosts = followQueries.feed.all(user.id) as Array<{
  id: number;
  slug: string;
  title: string;
  description: string;
  created_at: number;
  author_name: string;
}>;

const followingCount = (followQueries.countFollowing.get(user.id) as { count: number }).count;
const title = `动态 - ${SITE_TITLE}`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <BaseHead title={title} description="我关注的人最近发布的文章动态。" />
    <link rel="canonical" href={new URL('/feed', Astro.site)} />
  </head>
  <body>
    <Header />
    <main class="feed-page">
      <header class="page-head">
        <h1>动态</h1>
        <p class="page-sub">
          {followingCount > 0
            ? `你关注了 ${followingCount} 位作者，这是他们最近发布的文章。`
            : '你还没有关注任何人，去作者主页点「+ 关注」就能在这里看到 TA 的新文章。'}
        </p>
      </header>

      {feedPosts.length === 0 ? (
        <div class="empty card">
          <div class="empty-icon">📡</div>
          <h2>暂无动态</h2>
          <p>
            {followingCount === 0
              ? '去文章页或归档页找找感兴趣的作者，关注后这里就会有动态啦。'
              : '你关注的人最近还没发新文章，过几天再来看看吧。'}
          </p>
          <a href="/blog" class="btn btn-primary">逛文章库</a>
          <a href="/archive" class="btn btn-outline">看归档</a>
        </div>
      ) : (
        <ul class="feed-list">
          {feedPosts.map((p, i) => (
            <li style={`animation-delay: ${Math.min(i, 12) * 50}ms`}>
              <a href={`/blog/${p.slug}/`} class="feed-card">
                <div class="feed-meta">
                  <span class="feed-author">✍️ {p.author_name}</span>
                  <time datetime={new Date(p.created_at).toISOString()}>
                    {new Date(p.created_at).toLocaleDateString('zh-CN', {
                      month: 'short',
                      day: 'numeric',
                    })}
                  </time>
                </div>
                <h3>{p.title}</h3>
                {p.description && <p class="feed-desc">{p.description}</p>}
                <span class="feed-read">阅读 →</span>
              </a>
            </li>
          ))}
        </ul>
      )}
    </main>

    <Footer />

    <style>
      .feed-page {
        max-width: var(--width-narrow, 720px);
        margin: 0 auto;
        padding: 2.5rem 1.2rem 3rem;
      }
      .page-head {
        margin-bottom: 2rem;
        padding-bottom: 1.2rem;
        border-bottom: 1px solid var(--border-light);
      }
      .page-head h1 {
        font-size: 1.9rem;
        font-weight: 800;
        color: var(--text-dark);
        margin: 0 0 0.4rem;
      }
      .page-sub {
        color: var(--text-light);
        font-size: 0.92rem;
        margin: 0;
      }
      .empty {
        text-align: center;
        padding: 3rem 1.5rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.6rem;
      }
      .empty-icon {
        font-size: 3rem;
        line-height: 1;
        margin-bottom: 0.4rem;
      }
      .empty h2 {
        margin: 0;
        font-size: 1.2rem;
        color: var(--text-dark);
      }
      .empty p {
        color: var(--text-light);
        font-size: 0.9rem;
        max-width: 380px;
        margin: 0 0 0.8rem;
      }
      .empty .btn {
        margin: 0 0.3rem;
      }
      .feed-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 0.9rem;
      }
      .feed-list li {
        animation: fadeInUp 0.45s var(--ease) both;
      }
      @keyframes fadeInUp {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
      }
      .feed-card {
        display: block;
        padding: 1.1rem 1.3rem;
        border: 1px solid var(--border-light);
        border-radius: var(--radius-lg, 14px);
        background: var(--bg-white);
        text-decoration: none;
        color: inherit;
        transition: var(--transition);
      }
      .feed-card:hover {
        border-color: var(--monet-blue-light);
        box-shadow: 0 6px 22px rgba(107, 148, 168, 0.12);
        transform: translateY(-2px);
      }
      .feed-meta {
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 0.8rem;
        color: var(--text-light);
        margin-bottom: 0.45rem;
      }
      .feed-author {
        color: var(--monet-blue-dark);
        font-weight: 600;
      }
      .feed-card h3 {
        margin: 0 0 0.35rem;
        font-size: 1.12rem;
        font-weight: 650;
        color: var(--text-dark);
        line-height: 1.4;
      }
      .feed-desc {
        margin: 0 0 0.6rem;
        color: var(--text-gray);
        font-size: 0.88rem;
        line-height: 1.55;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }
      .feed-read {
        font-size: 0.82rem;
        color: var(--monet-blue-dark);
        font-weight: 550;
      }
      @media (prefers-reduced-motion: reduce) {
        .feed-list li { animation: none; }
      }
      @media (max-width: 560px) {
        .feed-page { padding: 1.8rem 1rem 2.5rem; }
        .page-head h1 { font-size: 1.55rem; }
        .feed-card { padding: 1rem 1.05rem; }
        .feed-card h3 { font-size: 1.02rem; }
      }
    </style>
  </body>
</html>
