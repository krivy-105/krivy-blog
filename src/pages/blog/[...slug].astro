---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { postQueries } from '../../lib/db';
import { marked } from 'marked';

const slug = Astro.params.slug as string;
const post = postQueries.findBySlug.get(slug) as any;

if (!post || post.status !== 'approved') {
  return Astro.redirect('/blog');
}

const htmlContent = marked.parse(post.content) as string;
const author = post.author_name;
const currentUser = Astro.locals.user;
const dateStr = new Date(post.created_at).toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={`${post.title} - ${author}`} description={post.description || ''} />
  </head>
  <body>
    <Header />
    <main class="narrow">
      <a href="/blog" class="back-link">← 返回文章列表</a>

      <article>
        <header class="article-header">
          <h1 class="article-title">{post.title}</h1>
          {post.description && <p class="article-desc">{post.description}</p>}
          <div class="article-meta">
            <span class="author-chip">
              <span class="author-avatar">{author.slice(0, 1).toUpperCase()}</span>
              {author}
            </span>
            <time datetime={new Date(post.created_at).toISOString()}>{dateStr}</time>
          </div>
        </header>

        <div class="article-content prose" set:html={htmlContent} />

        <div class="article-actions">
          <a href="/blog" class="back-link">← 返回文章列表</a>
          {currentUser && currentUser.id !== post.author_id && (
            <a href={`/messages?user=${post.author_id}`} class="btn btn-outline btn-sm">
              💬 私信作者
            </a>
          )}
        </div>
      </article>
    </main>
    <Footer />
  </body>
</html>

<style>
  .back-link {
    display: inline-block;
    color: var(--text-gray);
    font-size: 0.9rem;
    margin-bottom: 1.6rem;
    transition: var(--transition);
  }
  .back-link:hover { color: var(--monet-blue-dark); transform: translateX(-3px); }

  .article-header {
    margin-bottom: 2.4rem;
    padding-bottom: 1.8rem;
    border-bottom: 1px solid var(--border-light);
    animation: fadeInUp 0.5s var(--ease);
  }
  .article-title {
    font-size: clamp(1.7rem, 4vw, 2.2rem);
    line-height: 1.35;
    margin-bottom: 0.8rem;
  }
  .article-desc {
    color: var(--text-gray);
    font-size: 1.02rem;
    line-height: 1.8;
    margin-bottom: 1.2rem;
  }
  .article-meta {
    display: flex;
    gap: 1rem;
    align-items: center;
    flex-wrap: wrap;
    font-size: 0.88rem;
    color: var(--text-light);
  }
  .author-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--monet-blue-dark);
    font-weight: 550;
  }
  .author-avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: linear-gradient(135deg, #8fb4c5, #6b94a8);
    color: #fff;
    font-size: 0.8rem;
    font-weight: 600;
  }

  .article-content {
    animation: fadeIn 0.55s var(--ease);
  }

  .article-actions {
    margin-top: 3rem;
    padding-top: 1.6rem;
    border-top: 1px solid var(--border-light);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .article-actions .back-link { margin-bottom: 0; }
</style>
