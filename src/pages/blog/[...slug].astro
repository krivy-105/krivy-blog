---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PostInteract from '../../components/PostInteract.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import Avatar from '../../components/Avatar.astro';
import { postQueries, tagQueries, viewQueries, seriesQueries, userQueries } from '../../lib/db';
import { renderMarkdown } from '../../lib/markdown';

const slug = Astro.params.slug as string;
const post = postQueries.findBySlug.get(slug) as any;

const currentUser = Astro.locals.user;
const isAdmin = currentUser?.role === 'admin';
const isOwner = currentUser?.id === post?.author_id;

// 未发布文章仅管理员可预览，其他访客回到列表
if (!post || (post.status !== 'approved' && !isAdmin)) {
  return Astro.redirect('/blog');
}

// 作者可管理自己的文章；管理员可下架他人已发布文章
const canEdit = isOwner;
const canDelete = isOwner || (isAdmin && post.status === 'approved');

const htmlContent = renderMarkdown(post.content);
const author = post.author_name;
const authorUser = userQueries.findByUsername.get(author) as { avatar: string | null } | undefined;
const interactionUser = currentUser
  ? { id: currentUser.id, username: currentUser.username, avatar: currentUser.avatar }
  : null;
const dateStr = new Date(post.created_at).toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// 字数与阅读时间（中文按字符算，约 400 字/分钟）
const wordCount = post.content.replace(/\s+/g, '').length;
const readMinutes = Math.max(1, Math.ceil(wordCount / 400));

// 文章标签
const tags = tagQueries.forPost.all(post.id) as { name: string }[];
// 当前浏览量（仅 approved 文章显示）
const viewCount = post.status === 'approved'
  ? (viewQueries.countForPost.get(post.id) as { count: number }).count
  : 0;
// 相关文章
const related = post.status === 'approved'
  ? (postQueries.findRelated.all(post.id, post.author_id, post.id, post.id) as any[])
  : [];

// 系列导航
const seriesInfo = post ? (seriesQueries.forPost.get(post.id) as any) : null;
let seriesNav: { series: any; total: number; order: number; prev: any; next: any } | null = null;
if (seriesInfo) {
  const { prev, next } = seriesQueries.neighbors(seriesInfo.id, seriesInfo.order_in_series);
  seriesNav = {
    series: seriesInfo,
    total: Number(seriesInfo.total || 0),
    order: Number(seriesInfo.order_in_series || 0),
    prev,
    next,
  };
}
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead
      title={`${post.title} - ${author}`}
      description={post.description || ''}
      type="article"
      publishedTime={new Date(post.created_at).toISOString()}
    />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: post.title,
      description: post.description || '',
      datePublished: new Date(post.created_at).toISOString(),
      dateModified: new Date(post.updated_at).toISOString(),
      author: { '@type': 'Person', name: author },
      mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).toString(),
    })} />
  </head>
  <body>
    <Header />
    <ReadingProgress />
    <main class="narrow">
      <a href={post.status === 'approved' ? '/blog' : '/admin'} class="back-link">
        {post.status === 'approved' ? '← 返回文章列表' : '← 返回管理后台'}
      </a>

      {seriesNav && post.status === 'approved' && (
        <div class="series-nav">
          <a href={`/series/${seriesNav.series.slug}/`} class="series-nav-head">
            <span class="series-nav-icon">📚</span>
            <div class="series-nav-head-main">
              <strong class="series-nav-title">{seriesNav.series.title}</strong>
              <span class="series-nav-progress">
                第 {seriesNav.order} / {seriesNav.total} 篇
              </span>
            </div>
            <span class="series-nav-chevron">›</span>
          </a>
          {(seriesNav.prev || seriesNav.next) && (
            <div class="series-pager">
              {seriesNav.prev ? (
                <a class="pager pager-prev" href={`/blog/${seriesNav.prev.slug}/`}>
                  <span class="pager-label">‹ 上一篇</span>
                  <span class="pager-title">{seriesNav.prev.title}</span>
                </a>
              ) : <span class="pager pager-disabled"><span class="pager-label">‹ 上一篇</span><span class="pager-title">已是第一篇</span></span>}
              {seriesNav.next ? (
                <a class="pager pager-next" href={`/blog/${seriesNav.next.slug}/`}>
                  <span class="pager-label">下一篇 ›</span>
                  <span class="pager-title">{seriesNav.next.title}</span>
                </a>
              ) : <span class="pager pager-disabled"><span class="pager-label">下一篇 ›</span><span class="pager-title">已是最后一篇</span></span>}
            </div>
          )}
        </div>
      )}

      {
        post.status !== 'approved' && (
          <div class={`review-banner review-${post.status}`} data-post-id={post.id}>
            <div class="review-banner-info">
              <strong>
                {post.status === 'pending' ? '⏳ 待审核文章预览' : '⛔ 已被驳回的文章'}
              </strong>
              <span>
                {post.status === 'pending'
                  ? '只有管理员能看到此页面，审核通过后才会公开发布。'
                  : '该文章已被驳回，不会公开展示。'}
              </span>
            </div>
            {post.status === 'pending' && (
              <div class="review-banner-actions">
                <button type="button" class="btn btn-primary btn-sm" data-review="approve">
                  ✓ 通过并发布
                </button>
                <button type="button" class="btn btn-outline btn-sm" data-review="reject">
                  驳回
                </button>
              </div>
            )}
          </div>
        )
      }

      <article>
        <header class="article-header">
          <h1 class="article-title">{post.title}</h1>
          {post.description && <p class="article-desc">{post.description}</p>}
          <div class="article-meta">
            <a href={`/users/${author}`} class="author-chip">
              <Avatar name={author} src={authorUser?.avatar} class="author-avatar" />
              {author}
            </a>
            <time datetime={new Date(post.created_at).toISOString()}>{dateStr}</time>
            {post.status === 'approved' && (
              <span class="view-count">👁 {viewCount}</span>
            )}
            {post.status === 'approved' && (
              <span class="read-info">📖 约 {wordCount} 字 · {readMinutes} 分钟</span>
            )}
          </div>
          {canDelete && (
            <div class="owner-toolbar" data-post-id={post.id}>
              {canEdit && <a class="owner-btn" href={`/edit/${post.id}`}>✏️ 编辑</a>}
              {isOwner
                ? <button type="button" class="owner-btn owner-btn-danger" data-action="owner-delete">🗑 删除</button>
                : <button type="button" class="owner-btn owner-btn-danger" data-action="admin-takedown">🛡 管理员下架</button>}
            </div>
          )}
          {tags.length > 0 && (
            <ul class="tag-list article-tags">
              {tags.map((t) => (
                <li><a class="tag-chip" href={`/tags/${t.name}/`}>{t.name}</a></li>
              ))}
            </ul>
          )}
        </header>

        <div class="article-content prose" set:html={htmlContent} />

        {
          post.status === 'approved' && related.length > 0 && (
            <section class="related">
              <h3>相关阅读</h3>
              <ul class="related-grid">
                {related.map((p) => (
                  <li>
                    <a class="related-card" href={`/blog/${p.slug}/`}>
                      <strong>{p.title}</strong>
                      {p.description && <div class="related-desc">{p.description}</div>}
                      <span class="related-author">✍️ {p.author_name}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        <TableOfContents />

        {
          post.status === 'approved' && (
            <PostInteract
              postId={post.id}
              slug={post.slug}
              title={post.title}
              user={interactionUser}
            />
          )
        }

        <div class="article-actions">
          <a href={post.status === 'approved' ? '/blog' : '/admin'} class="back-link">
            {post.status === 'approved' ? '← 返回文章列表' : '← 返回管理后台'}
          </a>
          {currentUser && currentUser.id !== post.author_id && (
            <a href={`/messages?user=${post.author_id}`} class="btn btn-outline btn-sm">
              💬 私信作者
            </a>
          )}
        </div>
      </article>
    </main>
    <Footer />

    {post.status === 'pending' && isAdmin && (
      <script>
        document.querySelectorAll<HTMLButtonElement>('[data-review]').forEach((btn) => {
          btn.addEventListener('click', async () => {
            const action = btn.dataset.review;
            const banner = btn.closest('.review-banner') as HTMLElement;
            const postId = banner.dataset.postId;
            if (action === 'reject' && !window.confirm('确认驳回这篇文章吗？驳回后不会公开发布。')) {
              return;
            }
            const buttons = banner.querySelectorAll('button');
            buttons.forEach((b) => (b.disabled = true));
            try {
              const res = await fetch(`/api/admin/posts/${postId}/${action}`, { method: 'POST' });
              const data = await res.json().catch(() => ({}));
              if (!res.ok) throw new Error(data.error || '操作失败');
              // 重载后服务端按最新状态渲染：通过即公开页，驳回则回管理后台
              if (action === 'approve') {
                window.location.reload();
              } else {
                window.location.href = '/admin';
              }
            } catch (e) {
              window.alert(e instanceof Error ? e.message : '网络错误，请重试');
              buttons.forEach((b) => (b.disabled = false));
            }
          });
        });
      </script>
    )}

    {post.status === 'approved' && (
      <script is:inline set:html={`fetch('/api/posts/${post.id}/view', { method: 'POST' }).catch(function () {});`} />
    )}

    {canDelete && (
      <script define:vars={{ ownerRedirect: `/users/${currentUser?.username ?? ''}` }}>
        const toolbar = document.querySelector('.owner-toolbar');
        toolbar?.querySelectorAll('button[data-action]').forEach((btn) => {
          btn.addEventListener('click', async () => {
            const postId = toolbar.dataset.postId;
            const isOwnerAction = btn.dataset.action === 'owner-delete';
            const tip = isOwnerAction
              ? '确认删除这篇文章？删除后将从站点消失且不可恢复。'
              : '确认以管理员身份下架这篇文章？下架后所有访客都无法查看。';
            if (!window.confirm(tip)) return;
            btn.disabled = true;
            try {
              const res = await fetch(`/api/posts/${postId}`, { method: 'DELETE' });
              const data = await res.json().catch(() => ({}));
              if (!res.ok) throw new Error(data.error || '删除失败');
              window.alert(data.message || '操作成功');
              window.location.href = isOwnerAction ? ownerRedirect : '/admin';
            } catch (e) {
              window.alert(e instanceof Error ? e.message : '网络错误，请重试');
              btn.disabled = false;
            }
          });
        });
      </script>
    )}

    <script>
      // 代码块复制按钮
      document.querySelectorAll('.article-content pre').forEach((pre) => {
        if (pre.querySelector('.code-copy-btn')) return;
        pre.style.position = 'relative';
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'code-copy-btn';
        btn.setAttribute('aria-label', '复制代码');
        btn.innerHTML =
          '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg><span class="cc-text">复制</span>';
        pre.appendChild(btn);
        btn.addEventListener('click', async () => {
          const code = pre.querySelector('code')?.textContent ?? pre.textContent ?? '';
          const textEl = btn.querySelector('.cc-text');
          let ok = false;
          try {
            await navigator.clipboard.writeText(code);
            ok = true;
          } catch {
            try {
              const ta = document.createElement('textarea');
              ta.value = code;
              ta.style.position = 'fixed';
              ta.style.top = '-9999px';
              document.body.appendChild(ta);
              ta.select();
              ok = document.execCommand('copy');
              ta.remove();
            } catch {}
          }
          if (ok) {
            btn.classList.add('is-copied');
            if (textEl) textEl.textContent = '已复制';
            setTimeout(() => {
              btn.classList.remove('is-copied');
              if (textEl) textEl.textContent = '复制';
            }, 1600);
          }
        });
      });
    </script>
  </body>
</html>

<style>
  .review-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding: 0.9rem 1.2rem;
    margin-bottom: 1.8rem;
    border-radius: var(--radius-lg);
    font-size: 0.9rem;
    animation: fadeInUp 0.45s var(--ease);
  }
  .review-banner strong {
    display: block;
    font-size: 0.95rem;
    margin-bottom: 0.15rem;
  }
  .review-banner span {
    font-size: 0.83rem;
    opacity: 0.85;
  }
  .review-banner-info {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }
  .review-banner-actions {
    display: flex;
    gap: 0.6rem;
    flex: none;
  }
  .review-pending {
    background: #fdf6e3;
    border: 1px solid #f0dfa3;
    color: #7a5d10;
  }
  .review-pending .btn-primary {
    background: #c9931f;
    border-color: #c9931f;
  }
  .review-pending .btn-primary:hover {
    background: #b3821a;
  }
  .review-rejected {
    background: #fdecee;
    border: 1px solid #f3c6cd;
    color: #8a2c33;
  }

  .back-link {
    display: inline-block;
    color: var(--text-gray);
    font-size: 0.9rem;
    margin-bottom: 1.6rem;
    transition: var(--transition);
  }
  .back-link:hover { color: var(--monet-blue-dark); transform: translateX(-3px); }

  /* 作者/管理员工具条 */
  .owner-toolbar {
    display: flex;
    justify-content: flex-end;
    gap: 0.5rem;
    margin: 0.7rem 0 0.2rem;
  }
  .owner-btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 5px 13px;
    font-size: 0.8rem;
    font-family: inherit;
    border-radius: var(--radius-pill);
    border: 1px solid transparent;
    background: var(--monet-blue-lighter);
    color: var(--monet-blue-dark);
    cursor: pointer;
    text-decoration: none;
    transition: all 0.2s var(--ease);
  }
  .owner-btn:hover { transform: translateY(-1px); background: var(--monet-blue-light); }
  .owner-btn-danger {
    color: #c85060;
    border-color: #f2d1d6;
    background: #fff5f7;
  }
  [data-theme="dark"] .owner-btn-danger {
    color: #f2a3ad;
    background: rgba(239, 111, 131, 0.12);
    border-color: rgba(239, 111, 131, 0.3);
  }
  .owner-btn-danger:hover {
    background: #ef6f83;
    color: #fff;
    border-color: #ef6f83;
  }

  .series-nav {
    background: var(--bg-white);
    border: 1px solid var(--monet-blue-lighter);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    margin-bottom: 1.8rem;
    animation: fadeInUp 0.45s var(--ease);
  }
  .series-nav-head {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.9rem 1.2rem;
    background: linear-gradient(90deg, var(--monet-blue-lighter) 0%, transparent 100%);
    text-decoration: none;
    color: inherit;
    transition: background 0.25s var(--ease);
  }
  .series-nav-head:hover { background: linear-gradient(90deg, var(--monet-blue-light) 0%, var(--monet-blue-lighter) 100%); }
  .series-nav-icon { font-size: 1.4rem; line-height: 1; }
  .series-nav-head-main { flex: 1; min-width: 0; }
  .series-nav-title {
    display: block;
    color: var(--monet-blue-dark);
    font-size: 0.98rem;
    margin-bottom: 2px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .series-nav-progress {
    font-size: 0.8rem;
    color: var(--text-light);
  }
  .series-nav-chevron {
    color: var(--monet-blue-dark);
    font-size: 1.4rem;
    font-weight: 300;
    line-height: 1;
  }
  .series-pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-top: 1px solid var(--border-light);
  }
  .pager {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 0.8rem 1.1rem;
    text-decoration: none;
    color: inherit;
    min-width: 0;
    transition: background 0.2s var(--ease);
  }
  a.pager:hover { background: var(--monet-blue-lighter); }
  .pager-prev { border-right: 1px solid var(--border-light); }
  .pager-next { text-align: right; }
  .pager-label {
    font-size: 0.74rem;
    color: var(--text-light);
    letter-spacing: 0.03em;
  }
  .pager-title {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-dark);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .pager-disabled { opacity: 0.45; cursor: default; }

  @media (max-width: 560px) {
    .series-pager { grid-template-columns: 1fr; }
    .pager-prev { border-right: none; border-bottom: 1px solid var(--border-light); }
    .pager-next { text-align: left; }
  }
  @media (prefers-reduced-motion: reduce) {
    .series-nav { animation: none !important; }
  }

  .article-header {
    margin-bottom: 2.4rem;
    padding-bottom: 1.8rem;
    border-bottom: 1px solid var(--border-light);
    animation: fadeInUp 0.5s var(--ease);
  }
  .article-title {
    font-size: clamp(1.7rem, 4vw, 2.2rem);
    line-height: 1.35;
    margin-bottom: 0.8rem;
  }
  .article-desc {
    color: var(--text-gray);
    font-size: 1.02rem;
    line-height: 1.8;
    margin-bottom: 1.2rem;
  }
  .article-meta {
    display: flex;
    gap: 1rem;
    align-items: center;
    flex-wrap: wrap;
    font-size: 0.88rem;
    color: var(--text-light);
  }
  .author-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--monet-blue-dark);
    font-weight: 550;
    transition: var(--transition);
  }
  .author-chip:hover {
    color: var(--monet-blue-deep);
  }
  .author-chip:hover .author-avatar {
    transform: scale(1.08);
    box-shadow: 0 4px 12px rgba(95, 136, 157, 0.35);
  }
  .author-avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: linear-gradient(135deg, #8fb4c5, #6b94a8);
    color: #fff;
    font-size: 0.8rem;
    font-weight: 600;
    transition: transform 0.25s var(--ease), box-shadow 0.25s var(--ease);
  }

  .article-content {
    animation: fadeIn 0.55s var(--ease);
  }

  /* 字数 / 阅读时间 */
  .read-info {
    color: var(--text-light);
    font-size: 0.82rem;
  }

  /* 代码块复制按钮 */
  .article-content pre {
    position: relative;
  }
  .code-copy-btn {
    position: absolute;
    top: 8px;
    right: 8px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 10px;
    border: 1px solid var(--border-light);
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.88);
    color: var(--text-gray);
    font-size: 0.74rem;
    font-family: inherit;
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.2s var(--ease), background 0.2s var(--ease), color 0.2s var(--ease);
    z-index: 2;
    backdrop-filter: blur(4px);
  }
  .article-content pre:hover .code-copy-btn {
    opacity: 1;
  }
  .code-copy-btn:hover {
    background: var(--monet-blue-lighter);
    color: var(--monet-blue-dark);
    border-color: var(--monet-blue-light);
  }
  .code-copy-btn.is-copied {
    background: #e3f6e8;
    color: #27ae60;
    border-color: #a8e0b8;
  }
  .code-copy-btn svg {
    width: 13px;
    height: 13px;
  }
  :global([data-theme="dark"]) .code-copy-btn {
    background: rgba(40, 50, 56, 0.82);
    color: var(--text-gray);
  }
  :global([data-theme="dark"]) .code-copy-btn:hover {
    background: var(--monet-blue-lighter);
  }
  :global([data-theme="dark"]) .code-copy-btn.is-copied {
    background: rgba(39, 174, 96, 0.18);
    color: #6ee7a3;
    border-color: rgba(39, 174, 96, 0.4);
  }
  /* 触屏设备常驻显示，无 hover */
  @media (hover: none) {
    .code-copy-btn { opacity: 1; }
  }

  .article-tags {
    margin-top: 1rem;
  }

  .related-desc {
    color: var(--text-gray);
    font-size: 0.82rem;
    line-height: 1.55;
    margin: 0.3rem 0 0.4rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .related-author {
    display: block;
    font-size: 0.78rem;
    color: var(--text-light);
    margin-top: 0.3rem;
  }
  .related-card strong {
    display: block;
    color: var(--text-dark);
    font-size: 0.92rem;
    line-height: 1.4;
  }

