---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PostInteract from '../../components/PostInteract.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { postQueries, tagQueries, viewQueries } from '../../lib/db';
import { marked } from 'marked';

const slug = Astro.params.slug as string;
const post = postQueries.findBySlug.get(slug) as any;

const currentUser = Astro.locals.user;
const isAdmin = currentUser?.role === 'admin';

// 未发布文章仅管理员可预览，其他访客回到列表
if (!post || (post.status !== 'approved' && !isAdmin)) {
  return Astro.redirect('/blog');
}

const htmlContent = marked.parse(post.content) as string;
const author = post.author_name;
const interactionUser = currentUser
  ? { id: currentUser.id, username: currentUser.username }
  : null;
const dateStr = new Date(post.created_at).toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// 文章标签
const tags = tagQueries.forPost.all(post.id) as { name: string }[];
// 当前浏览量（仅 approved 文章显示）
const viewCount = post.status === 'approved'
  ? (viewQueries.countForPost.get(post.id) as { count: number }).count
  : 0;
// 相关文章
const related = post.status === 'approved'
  ? (postQueries.findRelated.all(post.id, post.author_id, post.id, post.id) as any[])
  : [];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={`${post.title} - ${author}`} description={post.description || ''} />
  </head>
  <body>
    <Header />
    <ReadingProgress />
    <main class="narrow">
      <a href={post.status === 'approved' ? '/blog' : '/admin'} class="back-link">
        {post.status === 'approved' ? '← 返回文章列表' : '← 返回管理后台'}
      </a>

      {
        post.status !== 'approved' && (
          <div class={`review-banner review-${post.status}`} data-post-id={post.id}>
            <div class="review-banner-info">
              <strong>
                {post.status === 'pending' ? '⏳ 待审核文章预览' : '⛔ 已被驳回的文章'}
              </strong>
              <span>
                {post.status === 'pending'
                  ? '只有管理员能看到此页面，审核通过后才会公开发布。'
                  : '该文章已被驳回，不会公开展示。'}
              </span>
            </div>
            {post.status === 'pending' && (
              <div class="review-banner-actions">
                <button type="button" class="btn btn-primary btn-sm" data-review="approve">
                  ✓ 通过并发布
                </button>
                <button type="button" class="btn btn-outline btn-sm" data-review="reject">
                  驳回
                </button>
              </div>
            )}
          </div>
        )
      }

      <article>
        <header class="article-header">
          <h1 class="article-title">{post.title}</h1>
          {post.description && <p class="article-desc">{post.description}</p>}
          <div class="article-meta">
            <a href={`/users/${author}`} class="author-chip">
              <span class="author-avatar">{author.slice(0, 1).toUpperCase()}</span>
              {author}
            </a>
            <time datetime={new Date(post.created_at).toISOString()}>{dateStr}</time>
            {post.status === 'approved' && (
              <span class="view-count">👁 {viewCount}</span>
            )}
          </div>
          {tags.length > 0 && (
            <ul class="tag-list article-tags">
              {tags.map((t) => (
                <li><a class="tag-chip" href={`/tags/${t.name}/`}>{t.name}</a></li>
              ))}
            </ul>
          )}
        </header>

        <div class="article-content prose" set:html={htmlContent} />

        {
          post.status === 'approved' && related.length > 0 && (
            <section class="related">
              <h3>相关阅读</h3>
              <ul class="related-grid">
                {related.map((p) => (
                  <li>
                    <a class="related-card" href={`/blog/${p.slug}/`}>
                      <strong>{p.title}</strong>
                      {p.description && <div class="related-desc">{p.description}</div>}
                      <span class="related-author">✍️ {p.author_name}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        <TableOfContents />

        {
          post.status === 'approved' && (
            <PostInteract
              postId={post.id}
              slug={post.slug}
              title={post.title}
              user={interactionUser}
            />
          )
        }

        <div class="article-actions">
          <a href={post.status === 'approved' ? '/blog' : '/admin'} class="back-link">
            {post.status === 'approved' ? '← 返回文章列表' : '← 返回管理后台'}
          </a>
          {currentUser && currentUser.id !== post.author_id && (
            <a href={`/messages?user=${post.author_id}`} class="btn btn-outline btn-sm">
              💬 私信作者
            </a>
          )}
        </div>
      </article>
    </main>
    <Footer />

    {post.status === 'pending' && isAdmin && (
      <script>
        document.querySelectorAll<HTMLButtonElement>('[data-review]').forEach((btn) => {
          btn.addEventListener('click', async () => {
            const action = btn.dataset.review;
            const banner = btn.closest('.review-banner') as HTMLElement;
            const postId = banner.dataset.postId;
            if (action === 'reject' && !window.confirm('确认驳回这篇文章吗？驳回后不会公开发布。')) {
              return;
            }
            const buttons = banner.querySelectorAll('button');
            buttons.forEach((b) => (b.disabled = true));
            try {
              const res = await fetch(`/api/admin/posts/${postId}/${action}`, { method: 'POST' });
              const data = await res.json().catch(() => ({}));
              if (!res.ok) throw new Error(data.error || '操作失败');
              // 重载后服务端按最新状态渲染：通过即公开页，驳回则回管理后台
              if (action === 'approve') {
                window.location.reload();
              } else {
                window.location.href = '/admin';
              }
            } catch (e) {
              window.alert(e instanceof Error ? e.message : '网络错误，请重试');
              buttons.forEach((b) => (b.disabled = false));
            }
          });
        });
      </script>
    )}

    {post.status === 'approved' && (
      <script is:inline set:html={`fetch('/api/posts/${post.id}/view', { method: 'POST' }).catch(function () {});`} />
    )}
  </body>
</html>

<style>
  .review-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding: 0.9rem 1.2rem;
    margin-bottom: 1.8rem;
    border-radius: var(--radius-lg);
    font-size: 0.9rem;
    animation: fadeInUp 0.45s var(--ease);
  }
  .review-banner strong {
    display: block;
    font-size: 0.95rem;
    margin-bottom: 0.15rem;
  }
  .review-banner span {
    font-size: 0.83rem;
    opacity: 0.85;
  }
  .review-banner-info {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }
  .review-banner-actions {
    display: flex;
    gap: 0.6rem;
    flex: none;
  }
  .review-pending {
    background: #fdf6e3;
    border: 1px solid #f0dfa3;
    color: #7a5d10;
  }
  .review-pending .btn-primary {
    background: #c9931f;
    border-color: #c9931f;
  }
  .review-pending .btn-primary:hover {
    background: #b3821a;
  }
  .review-rejected {
    background: #fdecee;
    border: 1px solid #f3c6cd;
    color: #8a2c33;
  }

  .back-link {
    display: inline-block;
    color: var(--text-gray);
    font-size: 0.9rem;
    margin-bottom: 1.6rem;
    transition: var(--transition);
  }
  .back-link:hover { color: var(--monet-blue-dark); transform: translateX(-3px); }

  .article-header {
    margin-bottom: 2.4rem;
    padding-bottom: 1.8rem;
    border-bottom: 1px solid var(--border-light);
    animation: fadeInUp 0.5s var(--ease);
  }
  .article-title {
    font-size: clamp(1.7rem, 4vw, 2.2rem);
    line-height: 1.35;
    margin-bottom: 0.8rem;
  }
  .article-desc {
    color: var(--text-gray);
    font-size: 1.02rem;
    line-height: 1.8;
    margin-bottom: 1.2rem;
  }
  .article-meta {
    display: flex;
    gap: 1rem;
    align-items: center;
    flex-wrap: wrap;
    font-size: 0.88rem;
    color: var(--text-light);
  }
  .author-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--monet-blue-dark);
    font-weight: 550;
    transition: var(--transition);
  }
  .author-chip:hover {
    color: var(--monet-blue-deep);
  }
  .author-chip:hover .author-avatar {
    transform: scale(1.08);
    box-shadow: 0 4px 12px rgba(95, 136, 157, 0.35);
  }
  .author-avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: linear-gradient(135deg, #8fb4c5, #6b94a8);
    color: #fff;
    font-size: 0.8rem;
    font-weight: 600;
    transition: transform 0.25s var(--ease), box-shadow 0.25s var(--ease);
  }

  .article-content {
    animation: fadeIn 0.55s var(--ease);
  }

  .article-tags {
    margin-top: 1rem;
  }

  .related-desc {
    color: var(--text-gray);
    font-size: 0.82rem;
    line-height: 1.55;
    margin: 0.3rem 0 0.4rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .related-author {
    display: block;
    font-size: 0.78rem;
    color: var(--text-light);
    margin-top: 0.3rem;
  }
  .related-card strong {
    display: block;
    color: var(--text-dark);
    font-size: 0.92rem;
    line-height: 1.4;
  }

  .article-actions {
    margin-top: 3rem;
    padding-top: 1.6rem;
    border-top: 1px solid var(--border-light);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .article-actions .back-link { margin-bottom: 0; }
</style>
