---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import { postQueries, tagQueries, viewQueries } from '../../lib/db';

const PER_PAGE = 12;
const total = (postQueries.countApproved.get() as { count: number }).count;
const pageCount = Math.max(1, Math.ceil(total / PER_PAGE));
// URL ?page=N；非法值回落到第 1 页
const page = Math.min(pageCount, Math.max(1, Number(Astro.url.searchParams.get('page')) || 1));

const posts = postQueries.findApprovedPaged.all(PER_PAGE, (page - 1) * PER_PAGE) as any[];

// post_id -> tags
const tagRows = tagQueries.forPostList.all() as { post_id: number; tags: string | null }[];
const tagMap = new Map<number, string[]>();
for (const r of tagRows) {
  if (r.tags) tagMap.set(r.post_id, r.tags.split(','));
}

// post_id -> 浏览量
const viewRows = viewQueries.countForPostList.all() as { post_id: number; count: number }[];
const viewMap = new Map<number, number>();
for (const r of viewRows) viewMap.set(r.post_id, r.count);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={`全部文章 - ${SITE_TITLE}`} description="所有已发布的文章" />
  </head>
  <body>
    <Header />
    <main class="narrow">
      <header class="page-head">
        <h1>全部文章</h1>
        <p>
          {total > 0
            ? `共 ${total} 篇文章，慢慢读。${pageCount > 1 ? `第 ${page} / ${pageCount} 页` : ''}`
            : '还没有文章发布。'}
        </p>
      </header>

      {posts.length > 0 ? (
        <ul class="post-list">
          {posts.map((post, i) => (
            <li style={`animation-delay: ${i * 60}ms`}>
              <div class={`post-item${post.pinned_at ? ' is-pinned' : ''}`}>
                <a
                  href={`/blog/${post.slug}/`}
                  class="post-item-link"
                  aria-label={`阅读文章：${post.title}`}
                ></a>
                <div class="item-main">
                  {post.pinned_at && <span class="pin-badge">📌 置顶</span>}
                  <h2>{post.title}</h2>
                  {post.description && <p class="post-desc">{post.description}</p>}
                  {(tagMap.get(post.id) || []).length > 0 && (
                    <ul class="tag-list">
                      {tagMap.get(post.id)!.map((t) => (
                        <li><a class="tag-chip" href={`/tags/${t}/`}>{t}</a></li>
                      ))}
                    </ul>
                  )}
                </div>
                <div class="item-meta">
                  <time>{new Date(post.created_at).toLocaleDateString('zh-CN')}</time>
                  <a class="meta-author" href={`/users/${post.author_name}`}
                    >✍️ {post.author_name}</a
                  >
                  {viewMap.has(post.id) && (
                    <span class="view-count">👁 {viewMap.get(post.id)}</span>
                  )}
                </div>
              </div>
            </li>
          ))}
        </ul>
      ) : (
        <div class="empty-state card">
          <div class="empty-icon">🌧️</div>
          <p>暂无文章，过段时间再来看看吧。</p>
          <a href="/" class="btn btn-outline">返回首页</a>
        </div>
      )}

      {pageCount > 1 && (
        <nav class="pagination" aria-label="文章分页">
          {page > 1 ? (
            <a class="page-btn" href={`/blog?page=${page - 1}`} rel="prev">← 上一页</a>
          ) : (
            <span class="page-btn is-disabled">← 上一页</span>
          )}
          <span class="page-current">{page} / {pageCount}</span>
          {page < pageCount ? (
            <a class="page-btn" href={`/blog?page=${page + 1}`} rel="next">下一页 →</a>
          ) : (
            <span class="page-btn is-disabled">下一页 →</span>
          )}
        </nav>
      )}
    </main>
    <Footer />
  </body>
</html>

<style>
  .page-head {
    margin-bottom: 2.4rem;
  }
  .page-head h1 {
    margin-bottom: 0.4rem;
  }
  .page-head p {
    color: var(--text-gray);
    font-size: 0.95rem;
    margin: 0;
  }

  .pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: 2.2rem;
  }
  .page-btn {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 1.1rem;
    border: 1px solid var(--border-light);
    border-radius: var(--radius-pill);
    background: var(--bg-white);
    color: var(--monet-blue-dark);
    font-size: 0.9rem;
    text-decoration: none;
    transition: var(--transition);
  }
  a.page-btn:hover {
    border-color: var(--monet-blue);
    transform: translateY(-1px);
    box-shadow: var(--shadow-sm);
  }
  .page-btn.is-disabled {
    opacity: 0.45;
    pointer-events: none;
  }
  .page-current {
    color: var(--text-gray);
    font-size: 0.9rem;
  }

  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .post-list li {
    animation: fadeInUp 0.5s var(--ease) both;
  }
  .post-item {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
    padding: 1.4rem 1.6rem;
    background: var(--bg-white);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    color: inherit;
    transition: var(--transition);
  }
  .post-item:hover {
    transform: translateX(5px);
    box-shadow: var(--shadow-md);
    border-color: #d2e3eb;
  }
  .post-item-link {
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: inherit;
  }
  .item-main { flex: 1; min-width: 0; }
  .item-main h2 {
    margin: 0 0 0.4rem;
    font-size: 1.18rem;
    line-height: 1.45;
    transition: color 0.2s var(--ease);
  }
  .post-item:hover h2 { color: var(--monet-blue-dark); }
  .post-desc {
    color: var(--text-gray);
    font-size: 0.92rem;
    line-height: 1.7;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .item-meta {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.35rem;
    padding-top: 2px;
    font-size: 0.82rem;
    color: var(--text-light);
    white-space: nowrap;
  }
  .meta-author {
    position: relative;
    z-index: 1;
    color: var(--monet-blue-dark);
    font-weight: 500;
    transition: color 0.2s var(--ease);
  }
  .meta-author:hover { color: var(--monet-blue-deep); text-decoration: underline; }

  @media (max-width: 560px) {
    .page-head { margin-bottom: 1.6rem; }
    .post-list { gap: 0.85rem; }
    .post-item {
      flex-direction: column;
      gap: 0.6rem;
      padding: 1.2rem 1.15rem;
    }
    .item-main h2 { font-size: 1.1rem; }
    .item-meta {
      flex-direction: row;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.5rem 0.8rem;
      width: 100%;
      white-space: normal;
    }
    .meta-author {
      display: inline-flex;
      align-items: center;
      min-height: 32px;
      padding: 2px 4px;
    }
  }
</style>
