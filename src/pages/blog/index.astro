---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import { postQueries } from '../../lib/db';

const posts = postQueries.findApproved.all() as any[];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={`全部文章 - ${SITE_TITLE}`} description="所有已发布的文章" />
    <style>
      .page-title {
        font-size: 2rem;
        color: var(--text-dark);
        margin-bottom: 2rem;
        font-weight: 400;
      }
      .post-list {
        display: grid;
        gap: 1.25rem;
        list-style: none;
        padding: 0;
      }
      .post-item {
        display: block;
        padding: 1.5rem;
        border: 1px solid var(--border-light);
        border-radius: var(--radius-lg);
        background: var(--bg-white);
        text-decoration: none;
        color: inherit;
        transition: var(--transition);
      }
      .post-item:hover {
        transform: translateX(6px);
        box-shadow: var(--shadow-md);
        border-color: var(--monet-blue-light);
      }
      .post-item h2 {
        margin: 0 0 0.5rem;
        font-size: 1.25rem;
        transition: color 0.2s var(--ease);
      }
      .post-item:hover h2 { color: var(--monet-blue); }
      .post-meta {
        font-size: 0.85rem;
        color: var(--text-gray);
        margin-bottom: 0.5rem;
      }
      .post-desc {
        color: var(--text-gray);
        margin: 0;
        font-size: 0.95rem;
      }
      .empty {
        text-align: center;
        padding: 3rem;
        color: var(--text-gray);
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <h1 class="page-title">全部文章</h1>
      {posts.length > 0 ? (
        <ul class="post-list">
          {posts.map((post) => (
            <li>
              <a href={`/blog/${post.slug}/`} class="post-item">
                <h2>{post.title}</h2>
                <div class="post-meta">
                  {new Date(post.created_at).toLocaleDateString('zh-CN')} · {post.author_name}
                </div>
                {post.description && <p class="post-desc">{post.description}</p>}
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <div class="empty">暂无文章</div>
      )}
    </main>
    <Footer />
  </body>
</html>
