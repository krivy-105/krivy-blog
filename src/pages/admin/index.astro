---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { postQueries, userQueries } from '../../lib/db';
import { SITE_TITLE } from '../../consts';

const user = Astro.locals.user;
if (!user || user.role !== 'admin') {
  return Astro.redirect('/');
}

const pendingPosts = postQueries.findByStatus.all('pending') as any[];
const allPosts = postQueries.all.all() as any[];
const users = userQueries.list.all() as any[];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={`管理后台 - ${SITE_TITLE}`} description="博客管理后台" />
    <style>
      .admin-tabs {
        display: flex;
        gap: 0.5rem;
        margin-bottom: 1.5rem;
        border-bottom: 2px solid var(--border-light);
      }
      .admin-tab {
        padding: 0.75rem 1rem;
        background: none;
        border: none;
        cursor: pointer;
        font-size: 0.95rem;
        color: var(--text-gray);
        font-weight: 500;
        border-bottom: 2px solid transparent;
        margin-bottom: -2px;
        transition: var(--transition);
      }
      .admin-tab.active {
        color: var(--monet-blue);
        border-bottom-color: var(--monet-blue);
      }
      .tab-panel { display: none; }
      .tab-panel.active { display: block; }

      .table-card {
        background: var(--bg-white);
        border: 1px solid var(--border-light);
        border-radius: var(--radius-lg);
        overflow: hidden;
      }
      table {
        width: 100%;
        border-collapse: collapse;
      }
      th, td {
        padding: 12px 16px;
        text-align: left;
        border-bottom: 1px solid var(--border-light);
        font-size: 0.9rem;
      }
      th {
        background: var(--monet-blue-lighter);
        color: var(--text-dark);
        font-weight: 600;
      }
      tr:last-child td { border-bottom: none; }
      tr:hover { background: var(--monet-blue-lighter); }

      .action-btns {
        display: flex;
        gap: 0.5rem;
      }
      .btn-sm {
        padding: 5px 14px;
        font-size: 0.8rem;
      }
      .empty-row td {
        text-align: center;
        color: var(--text-gray);
        padding: 2rem;
      }
      .post-title {
        max-width: 300px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <h1 style="font-size:1.8rem; margin-bottom: 1rem;">🛠️ 管理后台</h1>

      <div class="admin-tabs">
        <button class="admin-tab active" data-tab="pending">待审核 ({pendingPosts.length})</button>
        <button class="admin-tab" data-tab="all">全部文章 ({allPosts.length})</button>
        <button class="admin-tab" data-tab="users">用户 ({users.length})</button>
      </div>

      <!-- 待审核 -->
      <div class="tab-panel active" id="panel-pending">
        <div class="table-card">
          <table>
            <thead>
              <tr><th>标题</th><th>作者</th><th>提交时间</th><th>操作</th></tr>
            </thead>
            <tbody>
              {pendingPosts.length === 0 ? (
                <tr class="empty-row"><td colspan="4">暂无待审核文章</td></tr>
              ) : pendingPosts.map((p) => (
                <tr>
                  <td class="post-title">{p.title}</td>
                  <td>{p.author_name}</td>
                  <td>{new Date(p.created_at).toLocaleDateString('zh-CN')}</td>
                  <td>
                    <div class="action-btns">
                      <button class="btn btn-primary btn-sm" onclick="reviewPost({p.id}, 'approve')">通过</button>
                      <button class="btn btn-outline btn-sm" onclick="reviewPost({p.id}, 'reject')">驳回</button>
                    </div>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <!-- 全部文章 -->
      <div class="tab-panel" id="panel-all">
        <div class="table-card">
          <table>
            <thead>
              <tr><th>标题</th><th>作者</th><th>状态</th><th>时间</th></tr>
            </thead>
            <tbody>
              {allPosts.length === 0 ? (
                <tr class="empty-row"><td colspan="4">暂无文章</td></tr>
              ) : allPosts.map((p) => (
                <tr>
                  <td class="post-title">
                    {p.status === 'approved' ? (
                      <a href={`/blog/${p.slug}/`}>{p.title}</a>
                    ) : p.title}
                  </td>
                  <td>{p.author_name}</td>
                  <td><span class={`tag tag-${p.status}`}>{p.status}</span></td>
                  <td>{new Date(p.created_at).toLocaleDateString('zh-CN')}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <!-- 用户列表 -->
      <div class="tab-panel" id="panel-users">
        <div class="table-card">
          <table>
            <thead>
              <tr><th>用户名</th><th>邮箱</th><th>角色</th><th>注册时间</th></tr>
            </thead>
            <tbody>
              {users.map((u) => (
                <tr>
                  <td>{u.username}</td>
                  <td>{u.email}</td>
                  <td><span class={`tag ${u.role === 'admin' ? 'tag-approved' : ''}`}>{u.role}</span></td>
                  <td>{new Date(u.created_at).toLocaleDateString('zh-CN')}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </main>
    <Footer />

    <script>
      const tabs = document.querySelectorAll('.admin-tab');
      tabs.forEach(tab => {
        tab.addEventListener('click', () => {
          tabs.forEach(t => t.classList.remove('active'));
          tab.classList.add('active');
          document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
          document.getElementById('panel-' + tab.dataset.tab).classList.add('active');
        });
      });

      async function reviewPost(id, action) {
        try {
          const res = await fetch(`/api/admin/posts/${id}/${action}`, { method: 'POST' });
          if (res.ok) {
            location.reload();
          } else {
            alert('操作失败');
          }
        } catch {
          alert('网络错误');
        }
      }
    </script>
  </body>
</html>
