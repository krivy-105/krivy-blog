---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { postQueries, userQueries } from '../../lib/db';
import { SITE_TITLE } from '../../consts';

const user = Astro.locals.user;
if (!user || user.role !== 'admin') {
  return Astro.redirect('/');
}

const pendingPosts = postQueries.findByStatus.all('pending') as any[];
const allPosts = postQueries.all.all() as any[];
const users = userQueries.list.all() as any[];

const statusLabel: Record<string, string> = {
  pending: '待审核',
  approved: '已发布',
  rejected: '已驳回',
};
const formatTime = (ts: number) =>
  new Date(ts).toLocaleString('zh-CN', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
    hour: '2-digit',
    minute: '2-digit',
  });
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={`管理后台 - ${SITE_TITLE}`} description="博客管理后台" />
    <style>
      .admin-tabs {
        display: flex;
        gap: 0.5rem;
        margin-bottom: 1.5rem;
        border-bottom: 2px solid var(--border-light);
      }
      .admin-tab {
        padding: 0.75rem 1rem;
        background: none;
        border: none;
        cursor: pointer;
        font-size: 0.95rem;
        color: var(--text-gray);
        font-weight: 500;
        border-bottom: 2px solid transparent;
        margin-bottom: -2px;
        transition: var(--transition);
      }
      .admin-tab.active {
        color: var(--monet-blue);
        border-bottom-color: var(--monet-blue);
      }
      .tab-panel { display: none; }
      .tab-panel.active { display: block; }

      .table-card {
        background: var(--bg-white);
        border: 1px solid var(--border-light);
        border-radius: var(--radius-lg);
        overflow: hidden;
      }
      table {
        width: 100%;
        border-collapse: collapse;
      }
      th, td {
        padding: 12px 16px;
        text-align: left;
        border-bottom: 1px solid var(--border-light);
        font-size: 0.9rem;
      }
      th {
        background: var(--monet-blue-lighter);
        color: var(--text-dark);
        font-weight: 600;
      }
      tr:last-child td { border-bottom: none; }
      tr:hover { background: var(--monet-blue-lighter); }

      .action-btns {
        display: flex;
        gap: 0.5rem;
      }
      .btn-sm {
        padding: 5px 14px;
        font-size: 0.8rem;
      }
      .empty-row td {
        text-align: center;
        color: var(--text-gray);
        padding: 2rem;
      }
      .post-title {
        max-width: 300px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <h1 style="font-size:1.8rem; margin-bottom: 1rem;">🛠️ 管理后台</h1>

      <div class="admin-tabs">
        <button class="admin-tab active" data-tab="pending">待审核 ({pendingPosts.length})</button>
        <button class="admin-tab" data-tab="all">全部文章 ({allPosts.length})</button>
        <button class="admin-tab" data-tab="users">用户 ({users.length})</button>
      </div>

      <!-- 待审核 -->
      <div class="tab-panel active" id="panel-pending">
        <div class="table-card">
          <table>
            <thead>
              <tr><th>标题</th><th>作者</th><th>提交时间</th><th>操作</th></tr>
            </thead>
            <tbody>
              {pendingPosts.length === 0 ? (
                <tr class="empty-row">
                  <td colspan="4">
                    暂无待审核文章，新提交的文章会出现在这里
                    <div style="margin-top:0.6rem;">
                      <a href="/write" class="btn btn-outline btn-sm">去写文章</a>
                    </div>
                  </td>
                </tr>
              ) : pendingPosts.map((p) => (
                <tr>
                  <td class="post-title">
                    <a href={`/blog/${p.slug}/`} title="点开预览全文后审核">{p.title}</a>
                  </td>
                  <td>
                    <a href={`/users/${p.author_name}`}>{p.author_name}</a>
                  </td>
                  <td>{formatTime(p.created_at)}</td>
                  <td>
                    <div class="action-btns">
                      <a href={`/blog/${p.slug}/`} class="btn btn-ghost btn-sm">预览</a>
                      <button class="btn btn-primary btn-sm" data-review-post={p.id} data-review-action="approve">通过</button>
                      <button class="btn btn-outline btn-sm" data-review-post={p.id} data-review-action="reject">驳回</button>
                    </div>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <!-- 全部文章 -->
      <div class="tab-panel" id="panel-all">
        <div class="table-card">
          <table>
            <thead>
              <tr><th>标题</th><th>作者</th><th>状态</th><th>提交时间</th></tr>
            </thead>
            <tbody>
              {allPosts.length === 0 ? (
                <tr class="empty-row"><td colspan="4">暂无文章</td></tr>
              ) : allPosts.map((p) => (
                <tr>
                  <td class="post-title">
                    <a href={`/blog/${p.slug}/`} title="管理员预览">{p.title}</a>
                  </td>
                  <td>
                    <a href={`/users/${p.author_name}`}>{p.author_name}</a>
                  </td>
                  <td><span class={`tag tag-${p.status}`}>{statusLabel[p.status] || p.status}</span></td>
                  <td>{formatTime(p.created_at)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <!-- 用户列表 -->
      <div class="tab-panel" id="panel-users">
        <div class="table-card">
          <table>
            <thead>
              <tr><th>用户名</th><th>邮箱</th><th>角色</th><th>注册时间</th></tr>
            </thead>
            <tbody>
              {users.map((u) => (
                <tr>
                  <td>{u.username}</td>
                  <td>{u.email}</td>
                  <td><span class={`tag ${u.role === 'admin' ? 'tag-approved' : ''}`}>{u.role === 'admin' ? '管理员' : '用户'}</span></td>
                  <td>{new Date(u.created_at).toLocaleDateString('zh-CN')}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </main>
    <Footer />

    <script>
      const tabs = document.querySelectorAll('.admin-tab');
      tabs.forEach(tab => {
        tab.addEventListener('click', () => {
          tabs.forEach(t => t.classList.remove('active'));
          tab.classList.add('active');
          document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
          document.getElementById('panel-' + tab.dataset.tab).classList.add('active');
        });
      });

      // 通过 / 驳回（事件委托），驳回需二次确认
      document.querySelectorAll('button[data-review-post]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const id = btn.dataset.reviewPost;
          const action = btn.dataset.reviewAction;
          if (action === 'reject' && !window.confirm('确认驳回这篇文章吗？驳回后不会公开发布。')) {
            return;
          }
          const row = btn.closest('tr');
          row?.querySelectorAll('button').forEach((b) => (b.disabled = true));
          try {
            const res = await fetch(`/api/admin/posts/${id}/${action}`, { method: 'POST' });
            const data = await res.json().catch(() => ({}));
            if (!res.ok) throw new Error(data.error || '操作失败');
            location.reload();
          } catch (e) {
            window.alert(e instanceof Error ? e.message : '网络错误，请重试');
            row?.querySelectorAll('button').forEach((b) => (b.disabled = false));
          }
        });
      });
    </script>
  </body>
</html>
