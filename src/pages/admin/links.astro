---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';
import { linkQueries } from '../../lib/db';

const user = Astro.locals.user;
if (!user || user.role !== 'admin') {
  return Astro.redirect('/');
}

const links = linkQueries.list.all() as {
  id: number;
  name: string;
  url: string;
  description: string | null;
  sort: number;
  created_at: number;
}[];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={`友链管理 - ${SITE_TITLE}`} description="友链管理后台" />
    <style>
      .page-head { margin-bottom: 1.4rem; }
      .page-head h1 { margin-bottom: 0.4rem; }
      .page-head p { color: var(--text-gray); font-size: 0.92rem; margin: 0; }

      .links-form {
        background: var(--bg-white);
        border: 1px solid var(--border-light);
        border-radius: var(--radius-lg);
        padding: 1.2rem 1.4rem;
        margin-bottom: 1.6rem;
      }
      .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.8rem;
        margin-bottom: 0.7rem;
      }
      .form-field label {
        display: block;
        font-size: 0.82rem;
        color: var(--text-gray);
        margin-bottom: 0.3rem;
      }
      .form-field input {
        width: 100%;
        padding: 8px 10px;
        border: 1.5px solid var(--border-light);
        border-radius: var(--radius-md);
        font-size: 0.9rem;
        font-family: inherit;
        background: var(--bg-white);
        color: var(--text-dark);
        box-sizing: border-box;
        transition: border-color 0.2s var(--ease);
      }
      .form-field input:focus {
        outline: none;
        border-color: var(--monet-blue);
        box-shadow: 0 0 0 3px rgba(107, 148, 168, 0.18);
      }
      .form-actions {
        display: flex;
        align-items: center;
        gap: 0.8rem;
        margin-top: 0.6rem;
      }
      .form-msg {
        font-size: 0.86rem;
      }
      .form-msg-success { color: #27ae60; }
      .form-msg-error { color: #e74c3c; }

      .links-table {
        background: var(--bg-white);
        border: 1px solid var(--border-light);
        border-radius: var(--radius-lg);
        overflow: hidden;
      }
      .links-table table { width: 100%; border-collapse: collapse; }
      .links-table th,
      .links-table td {
        padding: 10px 14px;
        text-align: left;
        border-bottom: 1px solid var(--border-light);
        font-size: 0.88rem;
      }
      .links-table th { background: var(--monet-blue-lighter); font-weight: 600; }
      .links-table tr:last-child td { border-bottom: none; }
      .links-table tr:hover { background: var(--monet-blue-lighter); }
      .link-url {
        color: var(--monet-blue-dark);
        word-break: break-all;
      }
      .empty-row { text-align: center; color: var(--text-gray); padding: 1.5rem; }

      @media (max-width: 560px) {
        .form-row { grid-template-columns: 1fr; }
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <a href="/admin" class="back-link">← 返回管理后台</a>
      <header class="page-head">
        <h1>🔗 友链管理</h1>
        <p>新增、删除首页公开的友情链接。</p>
      </header>

      <form class="links-form" id="linkForm">
        <div class="form-row">
          <div class="form-field">
            <label for="name">名称 *</label>
            <input id="name" name="name" type="text" placeholder="站点名称" required maxlength="50" />
          </div>
          <div class="form-field">
            <label for="url">URL *</label>
            <input id="url" name="url" type="url" placeholder="https://example.com" required />
          </div>
        </div>
        <div class="form-row">
          <div class="form-field">
            <label for="description">描述（可选）</label>
            <input id="description" name="description" type="text" placeholder="一句话描述" maxlength="200" />
          </div>
          <div class="form-field">
            <label for="sort">排序（数字越小越靠前）</label>
            <input id="sort" name="sort" type="number" placeholder="0" value="0" />
          </div>
        </div>
        <div class="form-actions">
          <button type="submit" class="btn btn-primary">新增友链</button>
          <span id="formMsg" class="form-msg"></span>
        </div>
      </form>

      <div class="links-table">
        <table>
          <thead>
            <tr><th>名称</th><th>URL</th><th>描述</th><th>排序</th><th>操作</th></tr>
          </thead>
          <tbody>
            {links.length === 0 ? (
              <tr><td colspan="5" class="empty-row">暂无友链，使用上方表单新增第一条</td></tr>
            ) : links.map((l) => (
              <tr data-id={l.id}>
                <td>{l.name}</td>
                <td><a class="link-url" href={l.url} target="_blank" rel="noopener">{l.url}</a></td>
                <td>{l.description || '—'}</td>
                <td>{l.sort}</td>
                <td>
                  <button class="btn btn-outline btn-sm del-btn" data-id={l.id}>删除</button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </main>
    <Footer />

    <style>
      .back-link {
        display: inline-block;
        color: var(--text-gray);
        font-size: 0.9rem;
        margin-bottom: 1rem;
      }
      .back-link:hover { color: var(--monet-blue-dark); }
      .btn-sm { padding: 5px 14px; font-size: 0.8rem; }
    </style>

    <script>
      const form = document.getElementById('linkForm') as HTMLFormElement;
      const msgEl = document.getElementById('formMsg');

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        msgEl.textContent = '';
        msgEl.className = 'form-msg';
        const formData = new FormData(form);
        try {
          const res = await fetch('/api/admin/links', { method: 'POST', body: formData });
          const data = await res.json().catch(() => ({}));
          if (res.ok) {
            msgEl.textContent = data.message || '已新增';
            msgEl.classList.add('form-msg-success');
            setTimeout(() => location.reload(), 800);
          } else {
            msgEl.textContent = data.error || '新增失败';
            msgEl.classList.add('form-msg-error');
          }
        } catch {
          msgEl.textContent = '网络错误';
          msgEl.classList.add('form-msg-error');
        }
      });

      document.querySelectorAll<HTMLButtonElement>('.del-btn').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const id = btn.dataset.id;
          if (!id) return;
          if (!window.confirm('确认删除这条友链吗？')) return;
          btn.disabled = true;
          try {
            const res = await fetch('/api/admin/links', {
              method: 'DELETE',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ id: Number(id) }),
            });
            const data = await res.json().catch(() => ({}));
            if (!res.ok) throw new Error(data.error || '删除失败');
            location.reload();
          } catch (e) {
            window.alert(e instanceof Error ? e.message : '网络错误，请重试');
            btn.disabled = false;
          }
        });
      });
    </script>
  </body>
</html>
