---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';
import { reportQueries } from '../../lib/db';

const user = Astro.locals.user;
if (!user || user.role !== 'admin') {
  return Astro.redirect('/');
}

interface ReportRow {
  id: number;
  reason: string;
  created_at: number;
  status: string;
  comment_id: number;
  comment_content: string;
  post_id: number;
  comment_user_id: number;
  comment_author: string;
  reporter_id: number;
  reporter_name: string;
  post_slug: string | null;
  post_title: string | null;
}

const reports = reportQueries.pendingList.all() as ReportRow[];

function timeAgo(ts: number): string {
  const diff = Date.now() - ts;
  const min = 60 * 1000;
  const hr = 60 * min;
  const day = 24 * hr;
  if (diff < min) return '刚刚';
  if (diff < hr) return `${Math.floor(diff / min)} 分钟前`;
  if (diff < day) return `${Math.floor(diff / hr)} 小时前`;
  if (diff < 7 * day) return `${Math.floor(diff / day)} 天前`;
  return new Date(ts).toLocaleDateString('zh-CN', { month: 'short', day: 'numeric' });
}
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <BaseHead title={`举报处理 - ${SITE_TITLE}`} description="评论举报审核后台" />
    <style>
      .page-head { margin-bottom: 1.4rem; padding-bottom: 1rem; border-bottom: 1px solid var(--border-light); }
      .page-head h1 { margin: 0 0 0.4rem; font-size: 1.6rem; }
      .page-head p { color: var(--text-gray); font-size: 0.92rem; margin: 0; }

      .report-list {
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }
      .report-card {
        background: var(--bg-white);
        border: 1px solid var(--border-light);
        border-left: 4px solid #e0a92e;
        border-radius: var(--radius-lg);
        padding: 1.1rem 1.3rem;
      }
      .report-meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.6rem;
        font-size: 0.82rem;
        color: var(--text-light);
        margin-bottom: 0.6rem;
      }
      .report-tag {
        background: rgba(224, 169, 46, 0.15);
        color: #b8860b;
        padding: 2px 8px;
        border-radius: 999px;
        font-weight: 600;
      }
      .report-quote {
        margin: 0 0 0.8rem;
        padding: 0.55rem 0.8rem;
        background: var(--monet-blue-lighter);
        border-left: 3px solid var(--monet-blue-light);
        border-radius: 4px;
        font-size: 0.88rem;
        line-height: 1.55;
        color: var(--text-dark);
      }
      .report-reason {
        margin: 0 0 0.9rem;
        font-size: 0.9rem;
        color: var(--text-gray);
        line-height: 1.5;
      }
      .report-reason strong { color: var(--text-dark); }
      .report-actions {
        display: flex;
        gap: 0.6rem;
        flex-wrap: wrap;
      }
      .empty {
        text-align: center;
        padding: 3rem 1rem;
        background: var(--bg-white);
        border: 1px solid var(--border-light);
        border-radius: var(--radius-lg);
        color: var(--text-gray);
      }
      .empty-icon { font-size: 2.4rem; margin-bottom: 0.4rem; }
      .empty p { margin: 0.4rem 0 0; font-size: 0.9rem; }

      @media (max-width: 560px) {
        .report-card { padding: 0.9rem 1rem; }
        .report-meta { font-size: 0.78rem; gap: 0.4rem; }
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <a href="/admin" class="back-link">← 返回管理后台</a>
      <header class="page-head">
        <h1>🚩 评论举报处理</h1>
        <p>
          {reports.length > 0
            ? `当前有 ${reports.length} 条待处理举报。`
            : '暂无待处理的举报，社区一片清净。'}
        </p>
      </header>

      {reports.length === 0 ? (
        <div class="empty">
          <div class="empty-icon">✨</div>
          <p>暂无待处理的举报</p>
        </div>
      ) : (
        <ul class="report-list">
          {reports.map((r) => (
            <li class="report-card" data-id={r.id}>
              <div class="report-meta">
                <span class="report-tag">待处理</span>
                <span>举报人：<strong>{r.reporter_name}</strong></span>
                <span>评论作者：<strong>{r.comment_author}</strong></span>
                <span>{timeAgo(r.created_at)}</span>
              </div>
              <blockquote class="report-quote">
                {r.comment_content}
                {r.post_slug && (
                  <a href={`/blog/${r.post_slug}/#comment-${r.comment_id}`} target="_blank" rel="noopener">
                    → 前往评论
                  </a>
                )}
              </blockquote>
              <p class="report-reason">
                <strong>举报理由：</strong>{r.reason}
              </p>
              <div class="report-actions">
                <button class="btn btn-primary btn-sm act-btn" data-id={r.id} data-action="approve">
                  举报成立 · 隐藏评论
                </button>
                <button class="btn btn-outline btn-sm act-btn" data-id={r.id} data-action="reject">
                  驳回
                </button>
              </div>
            </li>
          ))}
        </ul>
      )}
    </main>
    <Footer />

    <style>
      .back-link {
        display: inline-block;
        color: var(--text-gray);
        font-size: 0.9rem;
        margin-bottom: 1rem;
      }
      .back-link:hover { color: var(--monet-blue-dark); }
      .btn-sm { padding: 6px 14px; font-size: 0.8rem; min-height: 36px; }
      .report-list { list-style: none; padding: 0; margin: 0; }
      .report-quote a {
        display: inline-block;
        margin-left: 0.6rem;
        font-size: 0.78rem;
        color: var(--monet-blue-dark);
        text-decoration: none;
      }
      .report-quote a:hover { text-decoration: underline; }
    </style>

    <script define:vars={{}}>
      document.querySelectorAll<HTMLButtonElement>('.act-btn').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const id = btn.dataset.id;
          const action = btn.dataset.action;
          if (!id || !action) return;
          const actionText = action === 'approve' ? '隐藏该评论' : '驳回该举报';
          if (!window.confirm(`确认${actionText}吗？`)) return;
          btn.disabled = true;
          try {
            const res = await fetch(`/api/admin/reports/${id}/${action}`, { method: 'POST' });
            const data = await res.json().catch(() => ({}));
            if (!res.ok) throw new Error(data.error || '处理失败');
            // 移除该卡片
            const card = btn.closest('.report-card');
            card?.remove();
            // 同步隐藏 Header 上的 pending-reports badge（由轮询自然刷新）
            const sub = document.querySelector('.page-head p');
            const rest = document.querySelectorAll('.report-card').length;
            if (sub) sub.textContent = rest > 0 ? `当前有 ${rest} 条待处理举报。` : '暂无待处理的举报，社区一片清净。';
            if (rest === 0) {
              const list = document.querySelector('.report-list');
              list?.remove();
              const empty = document.createElement('div');
              empty.className = 'empty';
              empty.innerHTML = '<div class="empty-icon">✨</div><p>暂无待处理的举报</p>';
              list?.parentNode?.appendChild(empty);
            }
          } catch (e) {
            window.alert(e instanceof Error ? e.message : '网络错误，请重试');
            btn.disabled = false;
          }
        });
      });
    </script>
  </body>
</html>
