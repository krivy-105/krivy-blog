---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import {
  db,
  userQueries,
  postQueries,
  likeQueries,
  commentQueries,
  type User,
} from '../../lib/db';

const username = Astro.params.username as string;
const profile = userQueries.findByUsername.get(username) as User | undefined;

if (!profile) {
  Astro.response.status = 404;
}

const currentUser = Astro.locals.user;
const isSelf = currentUser?.id === profile?.id;

let posts: any[] = [];
let stats = { posts: 0, likes: 0, comments: 0 };
const likeMap = new Map<number, number>();
const commentMap = new Map<number, number>();

// 本人可见的审核中文稿（他人访问时为空）
let reviewPosts: any[] = [];
if (profile && isSelf) {
  reviewPosts = (postQueries.findByAuthor.all(profile.id) as any[]).filter(
    (p) => p.status !== 'approved'
  );
}

if (profile) {
  posts = postQueries.findApprovedByAuthor.all(profile.id) as any[];
  stats = {
    posts: posts.length,
    likes: (likeQueries.totalReceivedByAuthor.get(profile.id) as { count: number }).count,
    comments: (commentQueries.totalReceivedByAuthor.get(profile.id) as { count: number }).count,
  };

  if (posts.length > 0) {
    const ids = posts.map((p) => p.id);
    const placeholders = ids.map(() => '?').join(',');
    (
      db
        .prepare(`SELECT post_id, COUNT(*) AS c FROM post_likes WHERE post_id IN (${placeholders}) GROUP BY post_id`)
        .all(...ids) as { post_id: number; c: number }[]
    ).forEach((r) => likeMap.set(r.post_id, r.c));
    (
      db
        .prepare(`SELECT post_id, COUNT(*) AS c FROM comments WHERE post_id IN (${placeholders}) GROUP BY post_id`)
        .all(...ids) as { post_id: number; c: number }[]
    ).forEach((r) => commentMap.set(r.post_id, r.c));
  }
}

const joinDate = profile
  ? new Date(profile.created_at).toLocaleDateString('zh-CN', { year: 'numeric', month: 'long' })
  : '';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead
      title={profile ? `${profile.username} 的主页 - ${SITE_TITLE}` : `用户不存在 - ${SITE_TITLE}`}
      description={profile?.bio || `${profile?.username ?? ''} 的个人主页`}
    />
  </head>
  <body>
    <Header />
    <main class="wide">
      {
        !profile ? (
          <div class="not-found card">
            <div class="nf-icon">🌫️</div>
            <h1>没有这位用户</h1>
            <p>你寻找的用户不存在，或已改名。</p>
            <a href="/blog" class="btn btn-primary">去看看文章</a>
          </div>
        ) : (
          <>
            <!-- 个人资料卡 -->
            <section class="profile-card">
              <div class="profile-banner" aria-hidden="true">
                <span class="blob blob-1"></span>
                <span class="blob blob-2"></span>
                <span class="blob blob-3"></span>
              </div>
              <div class="profile-inner">
                <div class="profile-avatar">{profile.username.slice(0, 1).toUpperCase()}</div>
                <div class="profile-main">
                  <div class="profile-name-row">
                    <h1>{profile.username}</h1>
                    {profile.role === 'admin' && <span class="role-badge">管理员</span>}
                  </div>

                  {isSelf ? (
                    <div class="bio-edit">
                      <p class="profile-bio" id="bioText">
                        {profile.bio || '这个人很神秘，还没有填写简介。'}
                      </p>
                      <div class="bio-editor" id="bioEditor" hidden>
                        <textarea id="bioInput" maxlength="200" rows="3" placeholder="介绍一下自己吧（最多 200 字）" set:text={profile.bio || ''}></textarea>
                        <div class="bio-actions">
                          <span class="bio-tip" id="bioTip"></span>
                          <div class="bio-btns">
                            <button type="button" class="btn btn-ghost btn-sm" id="bioCancel">取消</button>
                            <button type="button" class="btn btn-primary btn-sm" id="bioSave">保存</button>
                          </div>
                        </div>
                      </div>
                      <button type="button" class="bio-edit-btn" id="bioEditBtn">✎ 编辑简介</button>
                    </div>
                  ) : (
                    <p class="profile-bio">{profile.bio || '这个人很神秘，还没有填写简介。'}</p>
                  )}

                  <div class="profile-meta">
                    <span class="meta-item">加入于 {joinDate}</span>
                  </div>
                </div>

                <div class="profile-side">
                  <div class="stat-grid">
                    <div class="stat">
                      <span class="stat-num">{stats.posts}</span>
                      <span class="stat-label">文章</span>
                    </div>
                    <div class="stat">
                      <span class="stat-num stat-heart">{stats.likes}</span>
                      <span class="stat-label">获赞</span>
                    </div>
                    <div class="stat">
                      <span class="stat-num">{stats.comments}</span>
                      <span class="stat-label">评论</span>
                    </div>
                  </div>
                  {!isSelf && currentUser && (
                    <a href={`/messages?user=${profile.id}`} class="btn btn-outline btn-sm dm-btn">
                      💬 私信 TA
                    </a>
                  )}
                  {!currentUser && (
                    <a href="/login" class="btn btn-outline btn-sm dm-btn">登录后互动</a>
                  )}
                </div>
              </div>
            </section>

            {/* 审核中的稿件（仅本人可见） */}
            {isSelf && reviewPosts.length > 0 && (
              <section class="review-posts">
                <h2 class="section-title">我的稿件审核状态</h2>
                <ul class="rp-list">
                  {reviewPosts.map((p) => (
                    <li class:list={['rp-item', `rp-${p.status}`]}>
                      <span class="rp-title">{p.title}</span>
                      <span class="rp-meta">
                        <span class:list={['tag', `tag-${p.status}`]}>
                          {p.status === 'pending' ? '⏳ 审核中' : '⛔ 已驳回'}
                        </span>
                        <time>{new Date(p.created_at).toLocaleDateString('zh-CN')}</time>
                      </span>
                    </li>
                  ))}
                </ul>
                <p class="rp-hint">
                  {currentUser?.role === 'admin' ? (
                    <>
                      你是管理员，可直接
                      <a href="/admin" class="rp-link">前往管理后台审核 →</a>
                    </>
                  ) : (
                    '文章通过审核后会公开展示在下方，驳回后可修改内容重新投稿。'
                  )}
                </p>
              </section>
            )}

            <!-- TA 的文章 -->
            <section class="user-posts">
              <h2 class="section-title">
                {isSelf ? '我发布的文章' : `TA 的文章${posts.length ? `（${posts.length}）` : ''}`}
              </h2>

              {posts.length === 0 ? (
                <div class="empty-state card">
                  <div class="empty-icon">🪶</div>
                  <p>{isSelf ? '你还没有已发布的文章，去写第一篇吧。' : 'TA 还没有发布文章。'}</p>
                  {isSelf && <a href="/write" class="btn btn-primary">写文章</a>}
                </div>
              ) : (
                <ul class="up-list">
                  {posts.map((p, i) => (
                    <li style={`animation-delay: ${Math.min(i, 10) * 60}ms`}>
                      <a href={`/blog/${p.slug}/`} class="up-card">
                        <div class="up-main">
                          <h3>{p.title}</h3>
                          {p.description && <p class="up-desc">{p.description}</p>}
                          <div class="up-foot">
                            <time>{new Date(p.created_at).toLocaleDateString('zh-CN')}</time>
                            <span class="up-stats">
                              <span class="up-like">♥ {likeMap.get(p.id) ?? 0}</span>
                              <span class="up-comment">💬 {commentMap.get(p.id) ?? 0}</span>
                            </span>
                          </div>
                        </div>
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </section>
          </>
        )
      }
    </main>
    <Footer />

    {isSelf && (
      <script>
        const editBtn = document.getElementById('bioEditBtn');
        const editor = document.getElementById('bioEditor') as HTMLElement | null;
        const text = document.getElementById('bioText');
        const input = document.getElementById('bioInput') as HTMLTextAreaElement | null;
        const saveBtn = document.getElementById('bioSave');
        const cancelBtn = document.getElementById('bioCancel');
        const tip = document.getElementById('bioTip');

        editBtn?.addEventListener('click', () => {
          editor?.removeAttribute('hidden');
          text?.setAttribute('hidden', '');
          editBtn.setAttribute('hidden', '');
          input?.focus();
        });
        cancelBtn?.addEventListener('click', () => {
          editor?.setAttribute('hidden', '');
          text?.removeAttribute('hidden');
          editBtn.removeAttribute('hidden');
          if (input && text) input.value = text.textContent?.trim() || '';
          if (tip) tip.textContent = '';
        });
        saveBtn?.addEventListener('click', async () => {
          const bio = (input?.value || '').trim();
          if (bio.length > 200) {
            if (tip) tip.textContent = '简介最长 200 字';
            return;
          }
          saveBtn.setAttribute('disabled', 'true');
          try {
            const res = await fetch('/api/profile', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ bio }),
            });
            const data = await res.json();
            if (!res.ok) throw new Error(data.error || '保存失败');
            if (text) {
              text.textContent = data.bio || '这个人很神秘，还没有填写简介。';
              text.classList.toggle('is-empty', !data.bio);
            }
            editor?.setAttribute('hidden', '');
            text?.removeAttribute('hidden');
            editBtn.removeAttribute('hidden');
            if (tip) tip.textContent = '';
          } catch (e) {
            if (tip) tip.textContent = e instanceof Error ? e.message : '保存失败';
          } finally {
            saveBtn.removeAttribute('disabled');
          }
        });
      </script>
    )}
  </body>
</html>

<style>
  main.wide {
    max-width: var(--width-wide);
  }

  .not-found {
    text-align: center;
    padding: 4rem 2rem;
    margin-top: 2rem;
  }
  .nf-icon {
    font-size: 3rem;
    margin-bottom: 0.8rem;
  }
  .not-found p {
    color: var(--text-gray);
    margin-bottom: 1.6rem;
  }

  /* ---------- 资料卡 ---------- */
  .profile-card {
    position: relative;
    margin-top: 1.6rem;
    background: var(--bg-white);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    animation: fadeInUp 0.55s var(--ease) both;
  }
  .profile-banner {
    position: relative;
    height: 132px;
    background: linear-gradient(120deg, #bcd5e0 0%, #8fb4c5 48%, #a9c8d4 100%);
    overflow: hidden;
  }
  .blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(2px);
    opacity: 0.5;
    animation: blobFloat 11s ease-in-out infinite;
  }
  .blob-1 {
    width: 190px;
    height: 190px;
    left: -40px;
    top: -90px;
    background: radial-gradient(circle at 35% 35%, #eaf3f7, #7fa6b8);
  }
  .blob-2 {
    width: 150px;
    height: 150px;
    right: 12%;
    bottom: -100px;
    background: radial-gradient(circle at 40% 40%, #f3f8fb, #6b94a8);
    animation-delay: -3.5s;
  }
  .blob-3 {
    width: 90px;
    height: 90px;
    right: -20px;
    top: -30px;
    background: radial-gradient(circle at 40% 40%, #f7c9d3, #ef6f83);
    opacity: 0.35;
    animation-delay: -7s;
  }
  @keyframes blobFloat {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(14px, 10px) scale(1.08); }
  }

  .profile-inner {
    display: flex;
    align-items: flex-start;
    gap: 1.6rem;
    padding: 0 2rem 1.8rem;
    margin-top: -44px;
  }
  .profile-avatar {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 96px;
    height: 96px;
    border-radius: 50%;
    background: linear-gradient(145deg, #9dbfcd, #5f889d);
    color: #fff;
    font-size: 2.2rem;
    font-weight: 650;
    border: 4px solid var(--bg-white);
    box-shadow: var(--shadow-md);
    transition: transform 0.35s var(--ease), box-shadow 0.35s var(--ease);
  }
  .profile-card:hover .profile-avatar {
    transform: translateY(-3px) scale(1.03);
    box-shadow: 0 14px 30px rgba(95, 136, 157, 0.3);
  }
  .profile-main {
    flex: 1;
    min-width: 0;
    padding-top: 3.2rem;
  }
  .profile-name-row {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-bottom: 0.5rem;
  }
  .profile-name-row h1 {
    margin: 0;
    font-size: 1.55rem;
  }
  .role-badge {
    padding: 0.15rem 0.65rem;
    border-radius: 999px;
    background: var(--monet-blue-light);
    color: var(--monet-blue-dark);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }
  .profile-bio {
    margin: 0 0 0.7rem;
    color: var(--text-gray);
    font-size: 0.95rem;
    line-height: 1.8;
    word-break: break-word;
    white-space: pre-wrap;
  }
  .profile-bio.is-empty {
    color: var(--text-light);
  }
  .profile-meta {
    font-size: 0.83rem;
    color: var(--text-light);
  }

  .bio-edit-btn {
    border: none;
    background: none;
    padding: 0;
    margin-top: 0.3rem;
    color: var(--monet-blue-dark);
    font-size: 0.84rem;
    font-family: inherit;
    cursor: pointer;
    transition: color 0.2s var(--ease);
  }
  .bio-edit-btn:hover { color: var(--monet-blue-deep); text-decoration: underline; }
  .bio-editor textarea {
    width: 100%;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    font-family: inherit;
    font-size: 0.92rem;
    line-height: 1.7;
    resize: vertical;
    color: var(--text-dark);
  }
  .bio-editor textarea:focus {
    outline: none;
    border-color: var(--monet-blue);
    box-shadow: 0 0 0 3px rgba(107, 148, 168, 0.15);
  }
  .bio-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 0.5rem;
  }
  .bio-tip { font-size: 0.8rem; color: #d2604e; }
  .bio-btns { display: flex; gap: 0.5rem; }

  .profile-side {
    flex: none;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.8rem;
    padding-top: 3.2rem;
    min-width: 230px;
  }
  .stat-grid {
    display: flex;
    background: var(--monet-blue-lighter);
    border-radius: var(--radius-lg);
    padding: 0.8rem 0.4rem;
  }
  .stat {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15rem;
  }
  .stat-num {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-dark);
    font-variant-numeric: tabular-nums;
  }
  .stat-heart { color: var(--heart); }
  .stat-label {
    font-size: 0.76rem;
    color: var(--text-light);
    letter-spacing: 0.05em;
  }
  .dm-btn {
    width: 100%;
    justify-content: center;
  }

  /* ---------- 审核状态 ---------- */
  .review-posts {
    margin-top: 2.2rem;
  }
  .rp-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }
  .rp-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    padding: 0.9rem 1.2rem;
    background: var(--bg-white);
    border: 1px solid var(--border-light);
    border-left-width: 4px;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    animation: fadeInUp 0.45s var(--ease) both;
  }
  .rp-pending { border-left-color: #e0a92e; }
  .rp-rejected { border-left-color: #d76a74; }
  .rp-title {
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--text-dark);
  }
  .rp-meta {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    font-size: 0.8rem;
    color: var(--text-light);
  }
  .rp-hint {
    margin: 0.8rem 0 0;
    font-size: 0.84rem;
    color: var(--text-light);
  }
  .rp-link { font-weight: 600; }

  /* ---------- 文章列表 ---------- */
  .user-posts {
    margin-top: 2.6rem;
  }
  .section-title {
    font-size: 1.2rem;
    margin-bottom: 1.1rem;
    padding-left: 0.2rem;
  }
  .up-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.1rem;
  }
  .up-list li {
    animation: fadeInUp 0.5s var(--ease) both;
  }
  .up-card {
    display: block;
    height: 100%;
    padding: 1.3rem 1.5rem;
    background: var(--bg-white);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    color: inherit;
    transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease), border-color 0.3s var(--ease);
  }
  .up-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: #d2e3eb;
  }
  .up-main h3 {
    font-size: 1.08rem;
    margin-bottom: 0.45rem;
    transition: color 0.2s var(--ease);
  }
  .up-card:hover h3 { color: var(--monet-blue-dark); }
  .up-desc {
    color: var(--text-gray);
    font-size: 0.88rem;
    line-height: 1.7;
    margin: 0 0 0.9rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .up-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.8rem;
    color: var(--text-light);
  }
  .up-stats {
    display: inline-flex;
    gap: 0.8rem;
  }
  .up-like { color: var(--heart); font-weight: 600; }
  .up-comment { color: var(--monet-blue-dark); }

  .empty-state {
    text-align: center;
    padding: 3rem 2rem;
  }
  .empty-icon {
    font-size: 2.4rem;
    margin-bottom: 0.6rem;
  }
  .empty-state p {
    color: var(--text-gray);
    margin-bottom: 1.3rem;
  }

  @media (max-width: 820px) {
    .profile-inner {
      flex-direction: column;
      gap: 1rem;
      padding: 0 1.3rem 1.5rem;
    }
    .profile-main,
    .profile-side {
      padding-top: 0;
      min-width: 0;
      width: 100%;
    }
    .profile-avatar {
      width: 80px;
      height: 80px;
      font-size: 1.8rem;
    }
    .up-list {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .profile-card,
    .up-list li { animation: none !important; }
    .blob { animation: none !important; }
    .profile-avatar,
    .up-card { transition: none !important; }
  }
</style>
