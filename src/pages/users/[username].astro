---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import Avatar from '../../components/Avatar.astro';
import { SITE_TITLE } from '../../consts';
import {
  db,
  userQueries,
  postQueries,
  likeQueries,
  commentQueries,
  bookmarkQueries,
  followQueries,
  type User,
} from '../../lib/db';

const username = Astro.params.username as string;
const profile = userQueries.findByUsername.get(username) as User | undefined;

if (!profile) {
  Astro.response.status = 404;
}

const currentUser = Astro.locals.user;
const isSelf = currentUser?.id === profile?.id;

let posts: any[] = [];
let stats = { posts: 0, likes: 0, comments: 0 };
const likeMap = new Map<number, number>();
const commentMap = new Map<number, number>();

// 本人可见的审核中文稿（他人访问时为空）
let reviewPosts: any[] = [];
if (profile && isSelf) {
  reviewPosts = (postQueries.findByAuthor.all(profile.id) as any[]).filter(
    (p) => p.status !== 'approved'
  );
}

// 本人收藏的文章（仅自己可见）
let bookmarkPosts: any[] = [];
if (profile && isSelf) {
  bookmarkPosts = bookmarkQueries.listByUser.all(profile.id) as any[];
}

// 关注数据：profile 的粉丝数 / 关注数；当前用户是否关注了 profile
let followerCount = 0;
let followingCount = 0;
let isFollowing = false;
if (profile) {
  followerCount = (followQueries.countFollowers.get(profile.id) as { count: number }).count;
  followingCount = (followQueries.countFollowing.get(profile.id) as { count: number }).count;
  if (currentUser && !isSelf) {
    isFollowing = !!followQueries.find.get(currentUser.id, profile.id);
  }
}

if (profile) {
  posts = postQueries.findApprovedByAuthor.all(profile.id) as any[];
  stats = {
    posts: posts.length,
    likes: (likeQueries.totalReceivedByAuthor.get(profile.id) as { count: number }).count,
    comments: (commentQueries.totalReceivedByAuthor.get(profile.id) as { count: number }).count,
  };

  if (posts.length > 0) {
    const ids = posts.map((p) => p.id);
    const placeholders = ids.map(() => '?').join(',');
    (
      db
        .prepare(`SELECT post_id, COUNT(*) AS c FROM post_likes WHERE post_id IN (${placeholders}) GROUP BY post_id`)
        .all(...ids) as { post_id: number; c: number }[]
    ).forEach((r) => likeMap.set(r.post_id, r.c));
    (
      db
        .prepare(`SELECT post_id, COUNT(*) AS c FROM comments WHERE post_id IN (${placeholders}) GROUP BY post_id`)
        .all(...ids) as { post_id: number; c: number }[]
    ).forEach((r) => commentMap.set(r.post_id, r.c));
  }
}

const joinDate = profile
  ? new Date(profile.created_at).toLocaleDateString('zh-CN', { year: 'numeric', month: 'long' })
  : '';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead
      title={profile ? `${profile.username} 的主页 - ${SITE_TITLE}` : `用户不存在 - ${SITE_TITLE}`}
      description={profile?.bio || `${profile?.username ?? ''} 的个人主页`}
    />
  </head>
  <body>
    <Header />
    <main class="wide">
      {
        !profile ? (
          <div class="not-found card">
            <div class="nf-icon">🌫️</div>
            <h1>没有这位用户</h1>
            <p>你寻找的用户不存在，或已改名。</p>
            <a href="/blog" class="btn btn-primary">去看看文章</a>
          </div>
        ) : (
          <>
            <!-- 个人资料卡 -->
            <section class="profile-card">
              <div class="profile-banner" aria-hidden="true">
                <span class="blob blob-1"></span>
                <span class="blob blob-2"></span>
                <span class="blob blob-3"></span>
              </div>
              <div class="profile-inner">
                {isSelf ? (
                  <div class="profile-avatar-wrap">
                    <button
                      type="button"
                      class="profile-avatar profile-avatar-editable"
                      id="avatarUploadBtn"
                      aria-label="更换头像"
                      title="点击更换头像"
                    >
                      {profile.avatar ? (
                        <img class="profile-avatar-photo" src={profile.avatar} alt={`${profile.username} 的头像`} />
                      ) : (
                        <span class="profile-avatar-initial">{profile.username.slice(0, 1).toUpperCase()}</span>
                      )}
                      <span class="avatar-mask"><span>📷 更换头像</span></span>
                    </button>
                    {profile.avatar_status === 'pending' && (
                      <span class="avatar-status-badge" title="新头像审核中">审核中</span>
                    )}
                    <input type="file" id="avatarInput" accept="image/png,image/jpeg,image/webp,image/gif" hidden />
                    {profile.avatar_status === 'pending' && (
                      <p class="avatar-upload-tip is-pending" role="status">
                        ⏳ 新头像已提交，等待管理员审核，通过后自动生效
                      </p>
                    )}
                    {profile.avatar_status === 'rejected' && (
                      <p class="avatar-upload-tip is-error" role="status">
                        上次提交的头像未通过审核，仍展示原头像，可重新上传
                      </p>
                    )}
                    <p class="avatar-upload-tip" id="avatarTip" role="status" hidden></p>
                  </div>
                ) : (
                  <Avatar name={profile.username} src={profile.avatar} class="profile-avatar" />
                )}
                <div class="profile-main">
                  <div class="profile-name-row">
                    <h1>{profile.username}</h1>
                    {profile.role === 'admin' && <span class="role-badge">管理员</span>}
                  </div>

                  {isSelf ? (
                    <div class="bio-edit">
                      <p class="profile-bio" id="bioText">
                        {profile.bio || '这个人很神秘，还没有填写简介。'}
                      </p>
                      <div class="bio-editor" id="bioEditor" hidden>
                        <textarea id="bioInput" maxlength="200" rows="3" placeholder="介绍一下自己吧（最多 200 字）" set:text={profile.bio || ''}></textarea>
                        <div class="bio-actions">
                          <span class="bio-tip" id="bioTip"></span>
                          <div class="bio-btns">
                            <button type="button" class="btn btn-ghost btn-sm" id="bioCancel">取消</button>
                            <button type="button" class="btn btn-primary btn-sm" id="bioSave">保存</button>
                          </div>
                        </div>
                      </div>
                      <button type="button" class="bio-edit-btn" id="bioEditBtn">✎ 编辑简介</button>
                    </div>
                  ) : (
                    <p class="profile-bio">{profile.bio || '这个人很神秘，还没有填写简介。'}</p>
                  )}

                  <div class="profile-meta">
                    <span class="meta-item">加入于 {joinDate}</span>
                  </div>
                </div>

                <div class="profile-side">
                  <div class="stat-grid">
                    <div class="stat">
                      <span class="stat-num">{stats.posts}</span>
                      <span class="stat-label">文章</span>
                    </div>
                    <div class="stat">
                      <span class="stat-num stat-heart">{stats.likes}</span>
                      <span class="stat-label">获赞</span>
                    </div>
                    <div class="stat">
                      <span class="stat-num">{stats.comments}</span>
                      <span class="stat-label">评论</span>
                    </div>
                    <div class="stat">
                      <span class="stat-num">{followingCount}</span>
                      <span class="stat-label">关注</span>
                    </div>
                    <div class="stat">
                      <span class="stat-num">{followerCount}</span>
                      <span class="stat-label">粉丝</span>
                    </div>
                  </div>
                  {!isSelf && currentUser && (
                    <div class="profile-actions">
                      <button
                        type="button"
                        class="btn btn-sm follow-btn"
                        id="followBtn"
                        data-username={profile.username}
                        aria-pressed={isFollowing}
                      >
                        <span class="follow-text">{isFollowing ? '已关注' : '+ 关注'}</span>
                      </button>
                      <a href={`/messages?user=${profile.id}`} class="btn btn-outline btn-sm dm-btn">
                        💬 私信
                      </a>
                    </div>
                  )}
                  {!currentUser && (
                    <a href="/login" class="btn btn-outline btn-sm dm-btn">登录后互动</a>
                  )}
                </div>
              </div>
            </section>

            {/* 审核中的稿件（仅本人可见） */}
            {isSelf && reviewPosts.length > 0 && (
              <section class="review-posts">
                <h2 class="section-title">我的稿件审核状态</h2>
                <ul class="rp-list">
                  {reviewPosts.map((p) => (
                    <li class:list={['rp-item', `rp-${p.status}`]}>
                      <span class="rp-title">{p.title}</span>
                      <span class="rp-meta">
                        <span class:list={['tag', `tag-${p.status}`]}>
                          {p.status === 'pending' ? '⏳ 审核中' : '⛔ 已驳回'}
                        </span>
                        <time>{new Date(p.created_at).toLocaleDateString('zh-CN')}</time>
                      </span>
                    </li>
                  ))}
                </ul>
                <p class="rp-hint">
                  {currentUser?.role === 'admin' ? (
                    <>
                      你是管理员，可直接
                      <a href="/admin" class="rp-link">前往管理后台审核 →</a>
                    </>
                  ) : (
                    '文章通过审核后会公开展示在下方，驳回后可修改内容重新投稿。'
                  )}
                </p>
              </section>
            )}

            <!-- TA 的文章 -->
            <section class="user-posts">
              <h2 class="section-title">
                {isSelf ? '我发布的文章' : `TA 的文章${posts.length ? `（${posts.length}）` : ''}`}
              </h2>

              {posts.length === 0 ? (
                <div class="empty-state card">
                  <div class="empty-icon">🪶</div>
                  <p>{isSelf ? '你还没有已发布的文章，去写第一篇吧。' : 'TA 还没有发布文章。'}</p>
                  {isSelf && <a href="/write" class="btn btn-primary">写文章</a>}
                </div>
              ) : (
                <ul class="up-list">
                  {posts.map((p, i) => (
                    <li style={`animation-delay: ${Math.min(i, 10) * 60}ms`}>
                      <div class="up-card" data-post-id={p.id}>
                        <a href={`/blog/${p.slug}/`} class="up-main">
                          <div>
                            <h3>{p.title}</h3>
                            {p.description && <p class="up-desc">{p.description}</p>}
                            <div class="up-foot">
                              <time>{new Date(p.created_at).toLocaleDateString('zh-CN')}</time>
                              <span class="up-stats">
                                <span class="up-like">♥ {likeMap.get(p.id) ?? 0}</span>
                                <span class="up-comment">💬 {commentMap.get(p.id) ?? 0}</span>
                              </span>
                            </div>
                          </div>
                        </a>
                        {isSelf && (
                          <div class="up-actions">
                            <a href={`/edit/${p.id}`} class="up-btn up-btn-edit" title="编辑文章" data-action="edit">
                              ✎ 编辑
                            </a>
                            <button type="button" class="up-btn up-btn-del" title="删除文章" data-action="delete" data-id={p.id}>
                              🗑 删除
                            </button>
                          </div>
                        )}
                      </div>
                    </li>
                  ))}
                </ul>
              )}
            </section>

            {/* 我的收藏（仅本人可见） */}
            {isSelf && (
              <section class="user-bookmarks">
                <h2 class="section-title">
                  我的收藏{bookmarkPosts.length ? `（${bookmarkPosts.length}）` : ''}
                </h2>
                {bookmarkPosts.length === 0 ? (
                  <div class="empty-state card">
                    <div class="empty-icon">⭐</div>
                    <p>还没有收藏文章，看到喜欢的文章点 ⭐ 即可收藏。</p>
                  </div>
                ) : (
                  <ul class="up-list">
                    {bookmarkPosts.map((p, i) => (
                      <li style={`animation-delay: ${Math.min(i, 10) * 60}ms`}>
                        <div class="up-card">
                          <a href={`/blog/${p.slug}/`} class="up-main">
                            <div>
                              <h3>{p.title}</h3>
                              {p.description && <p class="up-desc">{p.description}</p>}
                              <div class="up-foot">
                                <span class="up-author">✍️ {p.author_name}</span>
                                <span class="up-bookmarked-at">
                                  收藏于 {new Date(p.bookmarked_at).toLocaleDateString('zh-CN')}
                                </span>
                              </div>
                            </div>
                          </a>
                        </div>
                      </li>
                    ))}
                  </ul>
                )}
              </section>
            )}
          </>
        )
      }
    </main>
    <Footer />

    {isSelf && (
      <script>
        const editBtn = document.getElementById('bioEditBtn');
        const editor = document.getElementById('bioEditor') as HTMLElement | null;
        const text = document.getElementById('bioText');
        const input = document.getElementById('bioInput') as HTMLTextAreaElement | null;
        const saveBtn = document.getElementById('bioSave');
        const cancelBtn = document.getElementById('bioCancel');
        const tip = document.getElementById('bioTip');

        // ---------- 头像上传 ----------
        const avatarBtn = document.getElementById('avatarUploadBtn');
        const avatarInput = document.getElementById('avatarInput') as HTMLInputElement | null;
        const avatarTip = document.getElementById('avatarTip');
        const showAvatarTip = (msg: string, kind: '' | 'ok' | 'error' = '') => {
          if (!avatarTip) return;
          avatarTip.textContent = msg;
          avatarTip.classList.toggle('is-ok', kind === 'ok');
          avatarTip.classList.toggle('is-error', kind === 'error');
          avatarTip.removeAttribute('hidden');
        };
        avatarBtn?.addEventListener('click', () => avatarInput?.click());
        avatarInput?.addEventListener('change', async () => {
          const file = avatarInput.files?.[0];
          if (!file) return;
          if (file.size > 5 * 1024 * 1024) {
            showAvatarTip('图片不能超过 5MB', 'error');
            avatarInput.value = '';
            return;
          }
          showAvatarTip('上传处理中…');
          const fd = new FormData();
          fd.append('avatar', file);
          try {
            const res = await fetch('/api/profile', { method: 'POST', body: fd });
            const data = await res.json();
            if (!res.ok) throw new Error(data.error || '上传失败');
            if (data.pending) {
              showAvatarTip('已提交，等待管理员审核，通过后自动生效…', 'ok');
              // 刷新后展示「审核中」状态；线上头像仍是旧图
              window.setTimeout(() => window.location.reload(), 1200);
              return;
            }
            showAvatarTip('头像已更新，正在刷新…', 'ok');
            // 刷新后 Header、评论区等所有头像位置都会拿到新地址（?v= 已变化）
            window.setTimeout(() => window.location.reload(), 700);
          } catch (e) {
            showAvatarTip(e instanceof Error ? e.message : '上传失败', 'error');
            avatarInput.value = '';
          }
        });

        editBtn?.addEventListener('click', () => {
          editor?.removeAttribute('hidden');
          text?.setAttribute('hidden', '');
          editBtn.setAttribute('hidden', '');
          input?.focus();
        });
        cancelBtn?.addEventListener('click', () => {
          editor?.setAttribute('hidden', '');
          text?.removeAttribute('hidden');
          editBtn.removeAttribute('hidden');
          if (input && text) input.value = text.textContent?.trim() || '';
          if (tip) tip.textContent = '';
        });
        saveBtn?.addEventListener('click', async () => {
          const bio = (input?.value || '').trim();
          if (bio.length > 200) {
            if (tip) tip.textContent = '简介最长 200 字';
            return;
          }
          saveBtn.setAttribute('disabled', 'true');
          try {
            const res = await fetch('/api/profile', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ bio }),
            });
            const data = await res.json();
            if (!res.ok) throw new Error(data.error || '保存失败');
            if (text) {
              text.textContent = data.bio || '这个人很神秘，还没有填写简介。';
              text.classList.toggle('is-empty', !data.bio);
            }
            editor?.setAttribute('hidden', '');
            text?.removeAttribute('hidden');
            editBtn.removeAttribute('hidden');
            if (tip) tip.textContent = '';
          } catch (e) {
            if (tip) tip.textContent = e instanceof Error ? e.message : '保存失败';
          } finally {
            saveBtn.removeAttribute('disabled');
          }
        });

        // 文章删除（事件委托）
        document.addEventListener('click', async (e) => {
          const target = e.target as HTMLElement;
          const btn = target.closest?.('[data-action="delete"]') as HTMLButtonElement | null;
          if (!btn) return;
          const id = btn.dataset.id;
          if (!id) return;
          if (!window.confirm('确认删除这篇文章？删除后不可恢复。')) return;
          btn.setAttribute('disabled', 'true');
          try {
            const res = await fetch(`/api/posts/${id}`, { method: 'DELETE' });
            const data = await res.json();
            if (!res.ok) throw new Error(data.error || '删除失败');
            const card = btn.closest('.up-card')?.closest('li');
            card?.style.setProperty('transition', 'all .3s var(--ease)');
            card?.style.setProperty('transform', 'translateY(8px) scale(.96)');
            card?.style.setProperty('opacity', '0');
            setTimeout(() => card?.remove(), 280);
          } catch (err) {
            window.alert(err instanceof Error ? err.message : '删除失败');
            btn.removeAttribute('disabled');
          }
        });
      </script>
    )}

    {!isSelf && currentUser && (
      <script>
        const followBtn = document.getElementById('followBtn');
        followBtn?.addEventListener('click', async () => {
          if (followBtn.dataset.loading === '1') return;
          followBtn.dataset.loading = '1';
          const username = followBtn.dataset.username;
          const textEl = followBtn.querySelector('.follow-text');
          const wasFollowing = followBtn.getAttribute('aria-pressed') === 'true';
          // 乐观更新
          followBtn.classList.toggle('is-following', !wasFollowing);
          followBtn.setAttribute('aria-pressed', String(!wasFollowing));
          if (textEl) textEl.textContent = !wasFollowing ? '已关注' : '+ 关注';
          try {
            const res = await fetch(`/api/users/${username}/follow`, { method: 'POST' });
            const data = await res.json();
            if (!res.ok) throw new Error(data.error || '操作失败');
            followBtn.classList.toggle('is-following', data.following);
            followBtn.setAttribute('aria-pressed', String(data.following));
            if (textEl) textEl.textContent = data.following ? '已关注' : '+ 关注';
            // 更新粉丝数显示
            const stats = document.querySelectorAll('.stat-num');
            // profile-side 里第 5 个 stat-num 是粉丝数
            const followerStat = document.querySelectorAll('.profile-side .stat')[4]?.querySelector('.stat-num');
            if (followerStat) followerStat.textContent = String(data.followers);
            // 当前用户的关注数（在 Header 没有，这里不更新）
          } catch (e) {
            // 回滚
            followBtn.classList.toggle('is-following', wasFollowing);
            followBtn.setAttribute('aria-pressed', String(wasFollowing));
            if (textEl) textEl.textContent = wasFollowing ? '已关注' : '+ 关注';
            alert(e instanceof Error ? e.message : '操作失败');
          } finally {
            followBtn.dataset.loading = '';
          }
        });
      </script>
    )}
  </body>
</html>

<style>
  main.wide {
    max-width: var(--width-wide);
  }

  .not-found {
    text-align: center;
    padding: 4rem 2rem;
    margin-top: 2rem;
  }
  .nf-icon {
    font-size: 3rem;
    margin-bottom: 0.8rem;
  }
  .not-found p {
    color: var(--text-gray);
    margin-bottom: 1.6rem;
  }

  /* ---------- 资料卡 ---------- */
  .profile-card {
    position: relative;
    margin-top: 1.6rem;
    background: var(--bg-white);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    animation: fadeInUp 0.55s var(--ease) both;
  }
  .profile-banner {
    position: relative;
    height: 132px;
    background: linear-gradient(120deg, #bcd5e0 0%, #8fb4c5 48%, #a9c8d4 100%);
    overflow: hidden;
  }
  .blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(2px);
    opacity: 0.5;
    animation: blobFloat 11s ease-in-out infinite;
  }
  .blob-1 {
    width: 190px;
    height: 190px;
    left: -40px;
    top: -90px;
    background: radial-gradient(circle at 35% 35%, #eaf3f7, #7fa6b8);
  }
  .blob-2 {
    width: 150px;
    height: 150px;
    right: 12%;
    bottom: -100px;
    background: radial-gradient(circle at 40% 40%, #f3f8fb, #6b94a8);
    animation-delay: -3.5s;
  }
  .blob-3 {
    width: 90px;
    height: 90px;
    right: -20px;
    top: -30px;
    background: radial-gradient(circle at 40% 40%, #f7c9d3, #ef6f83);
    opacity: 0.35;
    animation-delay: -7s;
  }
  @keyframes blobFloat {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(14px, 10px) scale(1.08); }
  }

  .profile-inner {
    display: flex;
    align-items: flex-start;
    gap: 1.6rem;
    padding: 0 2rem 1.8rem;
    margin-top: -44px;
  }
  .profile-avatar {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 96px;
    height: 96px;
    border-radius: 50%;
    background: linear-gradient(145deg, #9dbfcd, #5f889d);
    color: #fff;
    font-size: 2.2rem;
    font-weight: 650;
    border: 4px solid var(--bg-white);
    box-shadow: var(--shadow-md);
    transition: transform 0.35s var(--ease), box-shadow 0.35s var(--ease);
  }
  .profile-card:hover .profile-avatar {
    transform: translateY(-3px) scale(1.03);
    box-shadow: 0 14px 30px rgba(95, 136, 157, 0.3);
  }
  /* 头像上传入口（仅本人主页） */
  .profile-avatar-wrap {
    flex: none;
    position: relative;
  }
  .profile-avatar-editable {
    padding: 0;
    border: 4px solid var(--bg-white);
    font-family: inherit;
    overflow: hidden;
    cursor: pointer;
  }
  .profile-avatar-initial { line-height: 1; }
  .profile-avatar-photo {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
  }
  .avatar-mask {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(22, 33, 41, 0.48);
    color: #fff;
    font-size: 0.72rem;
    font-weight: 600;
    line-height: 1.3;
    opacity: 0;
    transition: opacity 0.25s var(--ease);
    pointer-events: none;
  }
