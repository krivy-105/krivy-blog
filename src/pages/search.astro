---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { SITE_TITLE } from '../consts';
import { sanitizeQuery, searchPosts, highlightText } from '../lib/search';

const rawQ = (Astro.url.searchParams.get('q') || '').trim();
const safeQ = sanitizeQuery(rawQ);
const terms = safeQ.split(' ').filter(Boolean).slice(0, 5);

// 检索逻辑统一在 lib/search.ts：FTS5 先查，中文子串用 LIKE 兜底。
// 返回的 preview 已经是转义过的 HTML（只保留 <mark>），可以放心 set:html。
const results = safeQ ? searchPosts(safeQ, 50) : [];

const formatDate = (ts: number) =>
  new Date(ts).toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' });

const highlightTitle = (text: string) => highlightText(text, terms);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={`搜索${rawQ ? '：' + rawQ : ''} - ${SITE_TITLE}`} description="站内文章搜索" />
  </head>
  <body>
    <Header />
    <main class="narrow">
      <header class="page-head">
        <h1><Icon name="search" size={22} /> 搜索文章</h1>
        <p>在全部已发布文章中检索标题、摘要和正文。</p>
      </header>

      <form class="search-form" action="/search" method="GET" role="search">
        <input
          type="search"
          name="q"
          class="search-input"
          placeholder="关键词，例如：Astro / Markdown / 部署"
          value={rawQ}
          autocomplete="off"
          aria-label="搜索关键词"
        />
        <button type="submit" class="btn btn-primary">搜索</button>
      </form>

      {rawQ ? (
        <p class="search-status">
          {results.length > 0
            ? `找到 ${results.length} 条与 “${rawQ}” 相关的结果`
            : `没有找到与 “${rawQ}” 相关的文章`}
        </p>
      ) : (
        <div class="empty-state card">
          <div class="empty-icon"><Icon name="search" size={32} /></div>
          <p>输入关键词，从标题、摘要和正文中查找。</p>
        </div>
      )}

      {results.length > 0 && (
        <ul class="post-list search-results">
          {results.map((r, i) => (
            <li style={`animation-delay: ${i * 50}ms`}>
              <div class="post-item search-item">
                <a
                  href={`/blog/${r.slug}/`}
                  class="post-item-link"
                  aria-label={`阅读文章：${r.title}`}
                ></a>
                <div class="item-main">
                  <h2 set:html={highlightTitle(r.title)} />
                  <p class="search-preview" set:html={r.preview} />
                </div>
                <div class="item-meta">
                  <a class="meta-author" href={`/users/${r.author_name}`}><Icon name="pen" size={13} /> {r.author_name}</a>
                  <time>{formatDate(r.created_at)}</time>
                </div>
              </div>
            </li>
          ))}
        </ul>
      )}
    </main>
    <Footer />

    <style>
      .page-head { margin-bottom: 1.6rem; }
      .page-head h1 { margin-bottom: 0.4rem; }
      .page-head p { color: var(--text-gray); font-size: 0.95rem; margin: 0; }

      .search-form {
        display: flex;
        gap: 0.6rem;
        margin-bottom: 1.2rem;
      }
      .search-input {
        flex: 1;
        padding: 10px 14px;
        border: 1.5px solid var(--border-light);
        border-radius: var(--radius-md);
        background: var(--glass-bg);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        color: var(--text-dark);
        font-size: 0.95rem;
        font-family: inherit;
        transition: var(--transition);
      }
      .search-input:focus {
        outline: none;
        border-color: var(--monet-blue);
        box-shadow: 0 0 0 3px rgba(107, 148, 168, 0.18);
      }
      .search-status {
        margin: 0 0 1.2rem;
        font-size: 0.9rem;
        color: var(--text-gray);
      }
      .search-preview {
        color: var(--text-gray);
        font-size: 0.9rem;
        line-height: 1.7;
        margin: 0.3rem 0 0;
      }
      .search-item :global(mark) {
        background: rgba(224, 169, 46, 0.25);
        color: inherit;
        padding: 0 2px;
        border-radius: 3px;
      }
      .search-item .item-meta {
        flex-direction: column;
        align-items: flex-end;
      }
      @media (max-width: 560px) {
        .search-form { flex-direction: column; }
        .search-item { flex-direction: column; gap: 0.6rem; }
        .search-item .item-meta { flex-direction: row; align-items: center; }
      }
    </style>
  </body>
</html>
