---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MarkdownToolbar from '../components/MarkdownToolbar.astro';
import { SITE_TITLE } from '../consts';
import { seriesQueries } from '../lib/db';

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/login');
}

const mySeries = seriesQueries.listByAuthor.all(user.id) as any[];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={`写文章 - ${SITE_TITLE}`} description="撰写新文章" />
    <style>
      .page-head { margin-bottom: 1.8rem; }
      .page-head h1 { margin-bottom: 0.35rem; }
      .page-head p { color: var(--text-gray); font-size: 0.92rem; margin: 0; }
      .write-container {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
        min-height: 70vh;
      }
      .write-panel, .preview-panel {
        background: var(--bg-white);
        border: 1px solid var(--border-light);
        border-radius: var(--radius-lg);
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
      }
      .panel-title {
        font-size: 0.9rem;
        color: var(--text-gray);
        margin-bottom: 1rem;
        font-weight: 500;
      }
      .form-group input,
      .form-group textarea,
      .form-group select {
        width: 100%;
        padding: 10px 12px;
        border: 1.5px solid var(--border-light);
        border-radius: var(--radius-md);
        outline: none;
        font-size: 0.95rem;
        font-family: inherit;
        transition: border-color 0.2s var(--ease);
        box-sizing: border-box;
        background: var(--bg-white);
        color: inherit;
      }
      .form-group input:focus,
      .form-group textarea:focus,
      .form-group select:focus {
        border-color: var(--monet-blue);
      }
      .form-group { margin-bottom: 0.9rem; }
      .field-label {
        display: block;
        font-size: 0.82rem;
        color: var(--text-light);
        margin-bottom: 5px;
        font-weight: 500;
      }
      .series-row {
        display: grid;
        grid-template-columns: 1.6fr 1fr;
        gap: 0.9rem;
      }
      .new-series-box {
        padding: 0.9rem 1rem;
        background: var(--monet-blue-lighter);
        border: 1px dashed var(--monet-blue-light);
        border-radius: var(--radius-md);
      }
      .new-series-box .field-label { color: var(--monet-blue-dark); }
      @media (max-width: 600px) {
        .series-row { grid-template-columns: 1fr; }
      }
      #content {
        flex: 1;
        min-height: 400px;
        resize: vertical;
        line-height: 1.6;
      }
      .preview-content {
        flex: 1;
        overflow-y: auto;
      }
      .preview-content > :first-child { margin-top: 0; }
      .submit-row {
        margin-top: 1rem;
        display: flex;
        gap: 1rem;
        align-items: center;
      }
      .msg {
        font-size: 0.9rem;
      }
      .msg-success { color: #27ae60; }
      .msg-error { color: #e74c3c; }
      .schedule-group {
        display: flex;
        align-items: center;
        gap: 0.7rem;
        flex-wrap: wrap;
        padding: 0.7rem 0.9rem;
        background: var(--monet-blue-lighter);
        border: 1px dashed var(--monet-blue-light);
        border-radius: var(--radius-md);
      }
      .schedule-toggle {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.88rem;
        color: var(--monet-blue-dark);
        cursor: pointer;
      }
      .schedule-input {
        padding: 6px 10px;
        border: 1.5px solid var(--border-light);
        border-radius: var(--radius-md);
        background: var(--bg-white);
        color: inherit;
        font-family: inherit;
        font-size: 0.88rem;
      }
      .schedule-input:disabled { opacity: 0.45; }
      .schedule-hint { color: var(--text-light); font-size: 0.76rem; }
      @media (max-width: 768px) {
        .write-container { grid-template-columns: 1fr; }
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <header class="page-head">
        <h1>✍️ 写文章</h1>
        <p>支持 Markdown 语法，提交后经管理员审核即可发布。</p>
      </header>
      <div class="write-container">
        <div class="write-panel">
          <div class="panel-title">编辑</div>
          <form id="writeForm">
            <div class="form-group">
              <input type="text" name="title" placeholder="文章标题" required maxlength="100" />
            </div>
            <div class="form-group">
              <input type="text" name="description" placeholder="一句话描述（可选）" maxlength="200" />
            </div>
            <div class="form-group">
              <input type="text" name="tags" placeholder="标签，用逗号或空格分隔（可选，最多5个）" maxlength="100" />
            </div>
            <div class="form-group series-row">
              <div class="series-left">
                <label class="field-label" for="seriesId">所属系列</label>
                <select id="seriesId" name="series_id">
                  <option value="">不加入系列</option>
                  {mySeries.map((s) => (
                    <option value={s.id}>{s.title}（{s.post_count ?? 0}篇）</option>
                  ))}
                  <option value="__new__">+ 新建系列…</option>
                </select>
              </div>
              <div class="series-right">
                <label class="field-label" for="seriesOrder">系列中的序号</label>
                <input type="number" id="seriesOrder" name="series_order" min="0" placeholder="留空=自动追加" />
              </div>
            </div>
            <div class="form-group new-series-box" id="newSeriesBox" hidden>
              <label class="field-label">新建系列</label>
              <input type="text" name="series_new_title" placeholder="新系列名称（必填）" maxlength="80" />
              <input type="text" name="series_new_desc" placeholder="新系列简介（可选）" maxlength="200" style="margin-top:8px;" />
            </div>
            <div class="form-group" style="flex:1; display:flex; flex-direction:column;">
              <MarkdownToolbar />
              <textarea id="content" name="content" placeholder="用 Markdown 书写正文..." required></textarea>
            </div>
            <div class="form-group schedule-group">
              <label class="schedule-toggle">
                <input type="checkbox" id="scheduleChk" />
                <span>🕐 定时发布</span>
              </label>
              <input
                type="datetime-local"
                name="publish_at"
                id="publishAt"
                class="schedule-input"
                disabled
              />
              <small class="schedule-hint">到点自动发布；留空则提交后进入审核队列。</small>
            </div>
            <div class="submit-row">
              <button type="submit" class="btn btn-primary">提交审核</button>
              <span id="submitMsg" class="msg"></span>
            </div>
          </form>
        </div>

        <div class="preview-panel">
          <div class="panel-title">预览</div>
          <div id="preview" class="preview-content prose">
            <p style="color: var(--text-gray);">开始输入即可预览 Markdown 渲染效果</p>
          </div>
        </div>
      </div>
    </main>
    <Footer />

    <script>
      import { marked } from 'marked';

      const contentEl = document.getElementById('content') as HTMLTextAreaElement;
      const previewEl = document.getElementById('preview');
      const form = document.getElementById('writeForm') as HTMLFormElement;
      const msgEl = document.getElementById('submitMsg');
      const titleEl = form.querySelector('[name="title"]') as HTMLInputElement;
      const descEl = form.querySelector('[name="description"]') as HTMLInputElement;
      const seriesSel = form.querySelector('#seriesId') as HTMLSelectElement | null;
      const newBox = document.getElementById('newSeriesBox');
      seriesSel?.addEventListener('change', () => {
        if (!newBox) return;
        if (seriesSel.value === '__new__') {
          newBox.removeAttribute('hidden');
        } else {
          newBox.setAttribute('hidden', '');
        }
      });

      // 定时发布：勾选才启用时间框；禁用时不提交该字段
      const scheduleChk = document.getElementById('scheduleChk') as HTMLInputElement;
      const publishAt = document.getElementById('publishAt') as HTMLInputElement;
      scheduleChk.addEventListener('change', () => {
        publishAt.disabled = !scheduleChk.checked;
        if (scheduleChk.checked) {
          // 默认值：明天此刻
          const d = new Date(Date.now() + 24 * 3600 * 1000);
          d.setSeconds(0, 0);
          const pad = (n: number) => String(n).padStart(2, '0');
          publishAt.value =
            `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`;
        }
      });

      // 粘贴图片直传：剪贴板里的图片自动上传并在光标处插入 Markdown
      let uploadSeq = 0;
      contentEl.addEventListener('paste', async (e: ClipboardEvent) => {
        const items = e.clipboardData?.items;
        if (!items) return;
        for (const item of Array.from(items)) {
          if (!item.type.startsWith('image/')) continue;
          const file = item.getAsFile();
          if (!file) continue;
          e.preventDefault();
          const seq = ++uploadSeq;
          const placeholder = `\n\n![上传中…${seq}](#uploading-${seq})\n\n`;
          insertAtCursor(placeholder);
          try {
            const fd = new FormData();
            fd.append('image', file);
            const res = await fetch('/api/upload/image', { method: 'POST', body: fd });
            const data = await res.json();
            if (!res.ok) throw new Error(data.error || '上传失败');
            replaceText(`![上传中…${seq}](#uploading-${seq})`, `![图片](${data.url})`);
          } catch (err) {
            replaceText(placeholder.trim(), `<!-- 图片上传失败：${err instanceof Error ? err.message : '网络错误'} -->`);
          }
          break;
        }
      });

      function insertAtCursor(text: string) {
        const s = contentEl.selectionStart ?? contentEl.value.length;
        const en = contentEl.selectionEnd ?? s;
        contentEl.value = contentEl.value.slice(0, s) + text + contentEl.value.slice(en);
        contentEl.selectionStart = contentEl.selectionEnd = s + text.length;
        renderPreview();
        saveDraft();
      }
      function replaceText(from: string, to: string) {
        contentEl.value = contentEl.value.replace(from, to);
        renderPreview();
        saveDraft();
      }

      const STORAGE_KEY = 'writeDraft';
      const AUTOSAVE_INTERVAL = 15000; // 15s
      const DEBOUNCE = 2000; // 2s

      function snapshot() {
        return {
          title: titleEl.value,
          desc: descEl.value,
          content: contentEl.value,
          t: Date.now(),
        };
      }

      function saveDraft() {
        try {
          const cur = snapshot();
          // 任一字段有内容才保存
          if (!cur.title && !cur.desc && !cur.content) {
            localStorage.removeItem(STORAGE_KEY);
            return;
          }
          localStorage.setItem(STORAGE_KEY, JSON.stringify(cur));
        } catch {}
      }

      function renderPreview() {
        previewEl.innerHTML = marked.parse(contentEl.value) as string;
      }

      function restoreDraft(d: { title?: string; desc?: string; content?: string }) {
        titleEl.value = d.title || '';
        descEl.value = d.desc || '';
        contentEl.value = d.content || '';
        renderPreview();
      }

      // 启动时检查本地草稿
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (raw) {
          const saved = JSON.parse(raw);
          const cur = snapshot();
          const changed =
            saved.title !== cur.title ||
            saved.desc !== cur.desc ||
            saved.content !== cur.content;
          if (changed && (saved.title || saved.desc || saved.content)) {
            window
              .uiConfirm('检测到上次未提交的草稿，是否恢复？')
              .then((ok) => {
                if (ok) {
                  restoreDraft(saved);
                } else {
                  localStorage.removeItem(STORAGE_KEY);
                }
              });
          }
        }
      } catch {}

      contentEl.addEventListener('input', renderPreview);

      // debounce 2s 自动保存
      let debounceTimer: number | undefined;
      function debounceSave() {
        if (debounceTimer) window.clearTimeout(debounceTimer);
        debounceTimer = window.setTimeout(saveDraft, DEBOUNCE);
      }
      titleEl.addEventListener('input', debounceSave);
      descEl.addEventListener('input', debounceSave);
      contentEl.addEventListener('input', debounceSave);

      // 定时 15s 保存
      window.setInterval(saveDraft, AUTOSAVE_INTERVAL);

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        msgEl.textContent = '';
        msgEl.className = 'msg';
        const formData = new FormData(form);
        try {
          const res = await fetch('/api/posts', { method: 'POST', body: formData });
          const data = await res.json();
          if (res.ok) {
            // 提交成功后清空本地草稿
            try { localStorage.removeItem(STORAGE_KEY); } catch {}
            msgEl.textContent = data.message || '提交成功';
            msgEl.classList.add('msg-success');
            setTimeout(() => { window.location.href = '/'; }, 1500);
          } else {
            msgEl.textContent = data.error || '提交失败';
            msgEl.classList.add('msg-error');
          }
        } catch {
          msgEl.textContent = '网络错误';
          msgEl.classList.add('msg-error');
        }
      });
    </script>
  </body>
</html>
