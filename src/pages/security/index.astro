---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';
import { securityDocs, securityCategories, securityTags } from '../../lib/security-docs';

const docs = securityDocs;
const categories = securityCategories();
const tags = securityTags();

const description = '网安方向的学习笔记、实验记录与工具备忘：CTF、Web 安全、逆向、密码学、内网渗透。';

// 预处理搜索用的小写索引，避免前端每次输入都做字符串拼接
const searchable = docs.map((d) =>
  [d.title, d.summary, d.category, ...d.tags].join(' ').toLowerCase()
);

// 结构化数据在 frontmatter 里算好再交给模板。
// 注意：不要在 set:html 的表达式里引用 Astro——尤其别放进嵌套箭头函数里，
// 编译器可能识别不到该引用，就不会给组件注入 Astro，运行时直接 ReferenceError。
const siteOrigin = Astro.site ? Astro.site.origin : 'https://krivy.cyou';
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: '网安笔记',
  description,
  url: `${siteOrigin}/security`,
  inLanguage: 'zh-CN',
  hasPart: docs.map((d) => ({
    '@type': 'TechArticle',
    headline: d.title,
    url: `${siteOrigin}/security/${encodeURIComponent(d.slug)}`,
  })),
};
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={`网安笔记 - ${SITE_TITLE}`} description={description} />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
  </head>
  <body>
    <Header />

    <section class="sec-hero">
      <div class="hero-inner">
        <span class="hero-eyebrow">SECURITY NOTES</span>
        <h1>网安笔记</h1>
        <p class="hero-sub">
          CTF、Web 安全、逆向、密码学与内网渗透的学习记录。<br class="br-pc" />
          边学边记的原始文档，不定期更新。
        </p>
        <div class="hero-stats">
          <span class="stat"><strong>{docs.length}</strong> 篇文档</span>
          <span class="stat-dot">·</span>
          <span class="stat"><strong>{categories.length}</strong> 个方向</span>
          <span class="stat-dot">·</span>
          <span class="stat"><strong>{tags.length}</strong> 个标签</span>
        </div>
      </div>
    </section>

    <main>
      {docs.length > 0 ? (
        <>
          <section class="sec-tools">
            <div class="search-box">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="11" cy="11" r="7" /><path d="M21 21l-4.35-4.35" />
              </svg>
              <input
                type="search"
                id="docSearch"
                placeholder="搜索标题、摘要或标签…"
                aria-label="搜索网安文档"
                autocomplete="off"
              />
            </div>

            <div class="cat-filters" role="group" aria-label="按方向筛选">
              <button type="button" class="cat-chip is-active" data-cat="all">
                全部 <span class="chip-num">{docs.length}</span>
              </button>
              {categories.map((c) => (
                <button type="button" class="cat-chip" data-cat={c.name}>
                  {c.name} <span class="chip-num">{c.count}</span>
                </button>
              ))}
            </div>
          </section>

          <section class="doc-section">
            <ul class="doc-grid" id="docGrid">
              {docs.map((d, i) => (
                <li
                  class="doc-item"
                  data-cat={d.category}
                  data-search={searchable[i]}
                  style={`animation-delay: ${Math.min(i, 10) * 45}ms`}
                >
                  <div class="doc-card">
                    <a
                      href={`/security/${encodeURIComponent(d.slug)}`}
                      class="doc-link"
                      aria-label={`阅读：${d.title}`}
                    ></a>
                    <div class="doc-meta">
                      <span class="cat-badge">{d.category}</span>
                      {d.date && (
                        <time datetime={d.date}>
                          {new Date(d.date).toLocaleDateString('zh-CN', {
                            year: 'numeric',
                            month: 'long',
                            day: 'numeric',
                          })}
                        </time>
                      )}
                      <span class="doc-dot">·</span>
                      <span class="doc-min">{d.minutes} 分钟</span>
                    </div>
                    <h2>{d.title}</h2>
                    {d.summary && <p class="doc-summary">{d.summary}</p>}
                    {d.tags.length > 0 && (
                      <ul class="tag-list">
                        {d.tags.map((t) => (
                          <li><span class="tag-chip inline">#{t}</span></li>
                        ))}
                      </ul>
                    )}
                    <span class="read-more">
                      阅读
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M5 12h14M13 6l6 6-6 6" />
                      </svg>
                    </span>
                  </div>
                </li>
              ))}
            </ul>

            <p class="no-result" id="noResult" hidden>没有匹配的文档，换个关键词或切换方向试试。</p>
          </section>
        </>
      ) : (
        <div class="empty-state card">
          <div class="empty-icon">🛡️</div>
          <p>还没有网安文档。把 Markdown 文件放进 <code>src/data/security/</code> 就会出现在这里。</p>
        </div>
      )}
    </main>

    <Footer />

    <script>
      // 方向筛选 + 关键词搜索：纯前端过滤，避免每次输入都打服务端
      var grid = document.getElementById('docGrid');
      var items = grid ? Array.prototype.slice.call(grid.querySelectorAll('.doc-item')) : [];
      var chips = Array.prototype.slice.call(document.querySelectorAll('.cat-chip'));
      var search = document.getElementById('docSearch');
      var noResult = document.getElementById('noResult');
      var activeCat = 'all';

      function apply() {
        var q = (search && search.value ? search.value : '').trim().toLowerCase();
        var shown = 0;
        items.forEach(function (el) {
          var okCat = activeCat === 'all' || el.dataset.cat === activeCat;
          var okQ = !q || (el.dataset.search || '').indexOf(q) !== -1;
          var show = okCat && okQ;
          el.hidden = !show;
          if (show) shown++;
        });
        if (noResult) noResult.hidden = shown !== 0;
      }

      chips.forEach(function (btn) {
        btn.addEventListener('click', function () {
          activeCat = btn.dataset.cat || 'all';
          chips.forEach(function (b) { b.classList.toggle('is-active', b === btn); });
          apply();
        });
      });

      if (search) {
        search.addEventListener('input', apply);
        // 页面里别自动聚焦搜索框，跟顶栏保持一致的行为
        search.addEventListener('keydown', function (e) {
          if (e.key === 'Escape') { search.value = ''; apply(); }
        });
      }

      apply();
    </script>

    <style>
      /* ---------- 头部 ---------- */
      .sec-hero {
        position: relative;
        padding: 5rem 1.5rem 3.2rem;
        text-align: center;
        overflow: hidden;
        isolation: isolate;
      }
      .sec-hero::before {
        content: '';
        position: absolute;
        width: 460px;
        height: 460px;
        top: -180px;
        left: 50%;
        transform: translateX(-52%);
        border-radius: 50%;
        background: radial-gradient(circle, rgba(107, 148, 168, 0.26), transparent 68%);
        filter: blur(6px);
        pointer-events: none;
        z-index: -1;
      }
      .hero-inner { max-width: 720px; margin: 0 auto; animation: fadeInUp 0.6s var(--ease); }
      .hero-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.76rem;
        letter-spacing: 0.34em;
        color: var(--monet-blue-dark);
        font-weight: 650;
        margin-bottom: 1rem;
        padding: 0.35rem 0.9rem;
        border-radius: var(--radius-pill);
        background: color-mix(in srgb, var(--bg-white) 70%, transparent);
        border: 1px solid color-mix(in srgb, var(--monet-blue) 22%, transparent);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
      }
      .hero-eyebrow::before {
        content: '';
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: linear-gradient(135deg, #9fc3d2, #4f7b90);
        box-shadow: 0 0 0 4px rgba(79, 123, 144, 0.15);
      }
      .sec-hero h1 {
        font-size: clamp(2.1rem, 5vw, 2.9rem);
        margin-bottom: 0.9rem;
        letter-spacing: 0.02em;
        background: linear-gradient(135deg, var(--text-dark) 20%, var(--monet-blue-dark) 88%);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }
      :global([data-theme="dark"]) .sec-hero h1 {
        background: linear-gradient(135deg, #e8eef2 15%, #a8c7d4 90%);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }
      .hero-sub {
        color: var(--text-gray);
        font-size: clamp(0.95rem, 2vw, 1.06rem);
        line-height: 1.9;
        margin-bottom: 1.4rem;
      }
      .hero-stats {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        font-size: 0.86rem;
        color: var(--text-light);
      }
      .hero-stats strong { color: var(--monet-blue-dark); font-weight: 650; }
      .stat-dot { opacity: 0.5; }

      /* ---------- 工具栏 ---------- */
      .sec-tools {
        max-width: var(--width-wide);
        margin: 0 auto 2rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }
      .search-box {
        position: relative;
        display: flex;
        align-items: center;
        max-width: 420px;
      }
      .search-box svg {
        position: absolute;
        left: 13px;
        color: var(--text-light);
        pointer-events: none;
      }
      .search-box input {
        width: 100%;
        padding: 0.62rem 1rem 0.62rem 36px;
        font-family: inherit;
        font-size: 0.88rem;
        color: var(--text-dark);
        background: var(--glass-bg);
        border: 1px solid var(--glass-border);
        border-radius: var(--radius-pill);
        transition: var(--transition);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
      }
      .search-box input:focus {
        outline: none;
        border-color: var(--monet-blue);
        box-shadow: var(--ring);
      }
      .cat-filters {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
      }
      .cat-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        font-family: inherit;
        font-size: 0.82rem;
        padding: 0.42rem 0.85rem;
        border-radius: var(--radius-pill);
        border: 1px solid var(--border-light);
        background: var(--bg-white);
        color: var(--text-gray);
        cursor: pointer;
        transition: var(--transition);
      }
      .cat-chip:hover {
        border-color: var(--monet-blue);
        color: var(--monet-blue-dark);
        transform: translateY(-1px);
      }
      .cat-chip.is-active {
        background: var(--monet-blue);
        border-color: var(--monet-blue);
        color: #fff;
        box-shadow: 0 3px 10px rgba(95, 136, 157, 0.24);
      }
      .chip-num {
        font-size: 0.72rem;
        opacity: 0.75;
        font-variant-numeric: tabular-nums;
      }

      /* ---------- 文档网格 ---------- */
      .doc-section { max-width: var(--width-wide); margin: 0 auto; }
      .doc-grid {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(310px, 1fr));
        gap: 1.2rem;
      }
      .doc-item { animation: fadeInUp 0.5s var(--ease) both; }
      .doc-item[hidden] { display: none !important; }
      .doc-card {
        position: relative;
        display: flex;
        flex-direction: column;
        height: 100%;
        padding: 1.5rem 1.6rem;
        background: var(--glass-bg);
        border: 1px solid var(--glass-border);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-sm);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        overflow: hidden;
        transition: var(--transition);
      }
      .doc-card::before {
        content: '';
        position: absolute;
        inset: 0 auto auto 0;
        width: 100%;
        height: 3px;
        background: linear-gradient(90deg, transparent, rgba(95, 136, 157, 0.6), transparent);
        opacity: 0;
        transition: opacity 0.25s var(--ease);
      }
      .doc-card:hover {
        transform: translateY(-5px);
        box-shadow: var(--glow-soft);
        border-color: color-mix(in srgb, var(--monet-blue) 38%, var(--border-light));
      }
      .doc-card:hover::before { opacity: 1; }
      .doc-link {
        position: absolute;
        inset: 0;
        z-index: 0;
        border-radius: inherit;
      }
      .doc-meta {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.4rem;
        font-size: 0.78rem;
        color: var(--text-light);
        margin-bottom: 0.7rem;
      }
      .cat-badge {
        font-size: 0.72rem;
        font-weight: 600;
        padding: 0.16rem 0.6rem;
        border-radius: var(--radius-pill);
        color: #2e8b8b;
        background: rgba(80, 190, 190, 0.14);
      }
      .doc-dot { opacity: 0.6; }
      .doc-card h2 {
        font-size: 1.18rem;
        line-height: 1.45;
        margin: 0 0 0.55rem;
        color: var(--text-dark);
        transition: color 0.2s var(--ease);
      }
      .doc-card:hover h2 { color: var(--monet-blue-dark); }
      .doc-summary {
        color: var(--text-gray);
        font-size: 0.92rem;
        line-height: 1.7;
        margin: 0 0 1rem;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }
      .tag-list {
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem;
        padding: 0;
        margin: 0 0 1rem;
      }
      .tag-chip.inline {
        display: inline-flex;
        align-items: center;
        padding: 2px 9px;
        font-size: 0.72rem;
        border-radius: var(--radius-pill);
        background: var(--monet-blue-lighter);
        color: var(--monet-blue-dark);
      }
      .read-more {
        margin-top: auto;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        color: var(--monet-blue-dark);
        font-weight: 600;
        font-size: 0.86rem;
      }
      .read-more svg { transition: transform 0.25s var(--ease); }
      .doc-card:hover .read-more svg { transform: translateX(4px); }

      .no-result {
        text-align: center;
        color: var(--text-light);
        font-size: 0.9rem;
        padding: 2.4rem 0;
      }
      .no-result[hidden] { display: none; }

      @media (max-width: 560px) {
        .sec-hero { padding: 3.4rem 1.2rem 2.2rem; }
        .br-pc { display: none; }
        .sec-tools { margin-bottom: 1.4rem; }
        .search-box { max-width: none; }
        .doc-grid { grid-template-columns: 1fr; gap: 1rem; }
        .doc-card { padding: 1.3rem 1.25rem; }
        .doc-card h2 { font-size: 1.1rem; }
      }
    </style>
  </body>
</html>
