---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const user = Astro.locals.user;
if (user) {
  return Astro.redirect('/');
}
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title="登录 / 注册" description="登录或注册账号" />
  </head>
  <body>
    <Header />
    <main class="auth-wrapper">
      <div class="auth-card">
        <div class="auth-head">
          <span class="auth-mark">✦</span>
          <h1 id="authTitle">欢迎回来</h1>
          <p id="authSubtitle">登录后即可写文章、发私信</p>
        </div>

        <div class="auth-tabs" role="tablist">
          <button class="auth-tab active" data-tab="login" role="tab">登录</button>
          <button class="auth-tab" data-tab="register" role="tab">注册</button>
        </div>

        <!-- 登录表单 -->
        <form id="loginForm">
          <div class="form-group">
            <label>用户名或邮箱</label>
            <input type="text" name="identifier" placeholder="输入用户名或邮箱" autocomplete="username" required />
          </div>
          <div class="form-group">
            <label>密码</label>
            <input type="password" name="password" placeholder="输入密码" autocomplete="current-password" required />
          </div>
          <div class="error-msg" id="loginError"></div>
          <button type="submit" class="btn btn-primary btn-submit">登 录</button>
        </form>

        <!-- 注册表单 -->
        <form id="registerForm" style="display:none;">
          <div class="form-group">
            <label>用户名</label>
            <input type="text" name="username" placeholder="给自己起个名字" autocomplete="username" required />
          </div>
          <div class="form-group">
            <label>邮箱</label>
            <input type="email" name="email" placeholder="your@email.com" autocomplete="email" required />
          </div>
          <div class="form-group">
            <label>密码</label>
            <input type="password" name="password" placeholder="至少 6 位" autocomplete="new-password" required minlength="6" />
          </div>
          <div class="error-msg" id="registerError"></div>
          <button type="submit" class="btn btn-primary btn-submit">注册并登录</button>
        </form>
      </div>
    </main>
    <Footer />

    <script>
      const tabs = document.querySelectorAll('.auth-tab');
      const loginForm = document.getElementById('loginForm');
      const registerForm = document.getElementById('registerForm');
      const loginError = document.getElementById('loginError');
      const registerError = document.getElementById('registerError');
      const authTitle = document.getElementById('authTitle');
      const authSubtitle = document.getElementById('authSubtitle');

      function switchTab(target) {
        tabs.forEach((t) => t.classList.toggle('active', t.dataset.tab === target));
        if (target === 'login') {
          loginForm.style.display = 'block';
          registerForm.style.display = 'none';
          authTitle.textContent = '欢迎回来';
          authSubtitle.textContent = '登录后即可写文章、发私信';
        } else {
          loginForm.style.display = 'none';
          registerForm.style.display = 'block';
          authTitle.textContent = '创建账号';
          authSubtitle.textContent = '注册后可发表文章，审核通过即展示';
        }
        loginError.textContent = '';
        registerError.textContent = '';
      }

      tabs.forEach((tab) => tab.addEventListener('click', () => switchTab(tab.dataset.tab)));

      // 支持 /login?tab=register 直接打开注册
      if (new URLSearchParams(window.location.search).get('tab') === 'register') {
        switchTab('register');
      }

      loginForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        loginError.textContent = '';
        const formData = new FormData(loginForm);
        try {
          const res = await fetch('/api/login', { method: 'POST', body: formData });
          const data = await res.json();
          if (res.ok) {
            window.location.href = data.redirect || '/';
          } else {
            loginError.textContent = data.error || '登录失败';
          }
        } catch {
          loginError.textContent = '网络错误，请重试';
        }
      });

      registerForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        registerError.textContent = '';
        const formData = new FormData(registerForm);
        try {
          const res = await fetch('/api/register', { method: 'POST', body: formData });
          if (res.ok) {
            window.location.href = '/';
          } else {
            const data = await res.json();
            registerError.textContent = data.error || '注册失败';
          }
        } catch {
          registerError.textContent = '网络错误，请重试';
        }
      });
    </script>
  </body>
</html>

<style>
  .auth-wrapper {
    max-width: none;
    flex: 1;
    min-height: calc(100vh - 66px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 3rem 1.2rem;
  }
  .auth-card {
    background: var(--bg-white);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-xl);
    padding: 2.6rem 2.4rem 2.3rem;
    width: 100%;
    max-width: 420px;
    box-shadow: var(--shadow-lg);
    animation: fadeInUp 0.5s var(--ease);
  }
  .auth-head {
    text-align: center;
    margin-bottom: 1.7rem;
  }
  .auth-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    margin-bottom: 0.8rem;
    border-radius: 14px;
    background: linear-gradient(135deg, #8fb4c5, #5f889d);
    color: #fff;
    font-size: 1.2rem;
    box-shadow: 0 6px 18px rgba(95, 136, 157, 0.32);
  }
  .auth-head h1 {
    font-size: 1.45rem;
    margin-bottom: 0.3rem;
  }
  .auth-head p {
    color: var(--text-gray);
    font-size: 0.9rem;
    margin: 0;
  }

  .auth-tabs {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.7rem;
    padding: 4px;
    background: var(--monet-blue-lighter);
    border-radius: 999px;
  }
  .auth-tab {
    flex: 1;
    padding: 0.55rem 1rem;
    background: none;
    border: none;
    cursor: pointer;
    font-size: 0.93rem;
    color: var(--text-gray);
    font-weight: 550;
    font-family: inherit;
    border-radius: 999px;
    transition: var(--transition);
  }
  .auth-tab.active {
    background: var(--bg-white);
    color: var(--monet-blue-dark);
    box-shadow: 0 2px 8px rgba(63, 100, 120, 0.12);
  }

  .btn-submit {
    width: 100%;
    padding: 12px;
    margin-top: 0.3rem;
    letter-spacing: 0.15em;
  }
  .error-msg {
    color: #d05a4a;
    font-size: 0.85rem;
    margin: -0.4rem 0 0.7rem;
    min-height: 1.2rem;
    line-height: 1.4;
  }

  @media (max-width: 480px) {
    .auth-card { padding: 2rem 1.4rem 1.8rem; }
  }
</style>
