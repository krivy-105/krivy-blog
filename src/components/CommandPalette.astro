---
// 全站命令面板：⌘/Ctrl + K（或 /）唤起，即时搜索文章，键盘导航
---

<div class="cmdk-overlay" id="cmdkOverlay" hidden>
  <div class="cmdk-panel" role="dialog" aria-modal="true" aria-label="快捷搜索">
    <div class="cmdk-input-row">
      <svg class="cmdk-icon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="7"/><path d="M21 21l-4.35-4.35"/>
      </svg>
      <input
        type="search"
        id="cmdkInput"
        class="cmdk-input"
        placeholder="搜索文章标题、内容…"
        autocomplete="off"
        aria-label="搜索文章"
      />
      <kbd class="cmdk-kbd">ESC</kbd>
    </div>
    <ul class="cmdk-list" id="cmdkList" role="listbox">
      <li class="cmdk-hint">输入关键词开始搜索</li>
    </ul>
  </div>
</div>

<script>
  const overlay = document.getElementById('cmdkOverlay')!;
  const panel = overlay.querySelector<HTMLElement>('.cmdk-panel')!;
  const input = document.getElementById('cmdkInput') as HTMLInputElement;
  const list = document.getElementById('cmdkList')!;

  let items: { slug: string; title: string; author_name: string; description: string }[] = [];
  let active = -1;
  let debounce: number | undefined;
  let lastController: AbortController | null = null;

  const isMac = /mac|iphone|ipad/i.test(navigator.platform);
  const modKey = isMac ? 'metaKey' : 'ctrlKey';

  function open() {
    overlay.hidden = false;
    requestAnimationFrame(() => input.focus());
    document.body.style.overflow = 'hidden';
  }
  function close() {
    overlay.hidden = true;
    input.value = '';
    list.innerHTML = '<li class="cmdk-hint">输入关键词开始搜索</li>';
    items = [];
    active = -1;
    document.body.style.overflow = '';
  }

  document.addEventListener('keydown', (e) => {
    if ((e as KeyboardEvent)[modKey] && (e.key === 'k' || e.key === 'K')) {
      e.preventDefault();
      overlay.hidden ? open() : close();
      return;
    }
    // 在非输入状态下按 / 唤起（面板已打开时不重复触发）
    if (
      e.key === '/' &&
      overlay.hidden &&
      !(e.target instanceof HTMLInputElement) &&
      !(e.target instanceof HTMLTextAreaElement) &&
      !(e.target as HTMLElement).isContentEditable
    ) {
      e.preventDefault();
      open();
    }
    if (e.key === 'Escape' && !overlay.hidden) close();
  });

  overlay.addEventListener('click', (e) => {
    if (e.target === overlay) close();
  });

  function renderResults(rows: typeof items) {
    items = rows;
    active = rows.length ? 0 : -1;
    if (!rows.length) {
      list.innerHTML = '<li class="cmdk-hint">没有匹配的文章</li>';
      return;
    }
    list.innerHTML = '';
    rows.forEach((r, i) => {
      const li = document.createElement('li');
      li.className = 'cmdk-item' + (i === 0 ? ' is-active' : '');
      li.setAttribute('role', 'option');
      li.dataset.index = String(i);
      li.innerHTML = `
        <span class="cmdk-item-title"></span>
        <span class="cmdk-item-meta"></span>`;
      li.querySelector('.cmdk-item-title')!.textContent = r.title;
      li.querySelector('.cmdk-item-meta')!.textContent = r.author_name ? `✍️ ${r.author_name}` : '';
      li.addEventListener('click', () => {
        window.location.href = `/blog/${r.slug}/`;
      });
      list.appendChild(li);
    });
  }

  function setActive(next: number) {
    if (!items.length) return;
    active = (next + items.length) % items.length;
    list.querySelectorAll<HTMLElement>('.cmdk-item').forEach((el, i) => {
      el.classList.toggle('is-active', i === active);
      if (i === active) el.scrollIntoView({ block: 'nearest' });
    });
  }

  input.addEventListener('input', () => {
    if (debounce) window.clearTimeout(debounce);
    debounce = window.setTimeout(async () => {
      const q = input.value.trim();
      if (!q) {
        list.innerHTML = '<li class="cmdk-hint">输入关键词开始搜索</li>';
        items = [];
        active = -1;
        return;
      }
      lastController?.abort();
      lastController = new AbortController();
      try {
        const res = await fetch(`/api/search?q=${encodeURIComponent(q)}`, {
          signal: lastController.signal,
        });
        if (res.ok) renderResults(await res.json());
      } catch {
        /* abort 或网络抖动时忽略 */
      }
    }, 160);
  });

  input.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      setActive(active + 1);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      setActive(active - 1);
    } else if (e.key === 'Enter') {
      e.preventDefault();
      const target = items[active];
      if (target) window.location.href = `/blog/${target.slug}/`;
    }
  });
</script>

<style>
  .cmdk-overlay {
    position: fixed;
    inset: 0;
    z-index: 10000;
    background: rgba(15, 22, 27, 0.45);
    backdrop-filter: blur(3px);
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 12vh 1rem 2rem;
    animation: cmdk-fade 0.15s var(--ease);
  }
  .cmdk-overlay[hidden] {
    display: none;
  }
  @keyframes cmdk-fade {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  .cmdk-panel {
    width: 100%;
    max-width: 600px;
    background: var(--bg-white);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-lg);
    box-shadow: 0 24px 70px rgba(20, 40, 55, 0.28);
    overflow: hidden;
    animation: cmdk-pop 0.16s var(--ease);
  }
  @keyframes cmdk-pop {
    from { transform: translateY(-10px) scale(0.98); opacity: 0.6; }
    to { transform: translateY(0) scale(1); opacity: 1; }
  }
  .cmdk-input-row {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.9rem 1.1rem;
    border-bottom: 1px solid var(--border-light);
  }
  .cmdk-icon { color: var(--text-light); flex-shrink: 0; }
  .cmdk-input {
    flex: 1;
    border: none;
    outline: none;
    background: transparent;
    font-size: 1rem;
    font-family: inherit;
    color: inherit;
  }
  .cmdk-input::-webkit-search-cancel-button { display: none; }
  .cmdk-kbd {
    font-size: 0.68rem;
    color: var(--text-light);
    border: 1px solid var(--border-light);
    border-radius: 5px;
    padding: 0.12rem 0.42rem;
    flex-shrink: 0;
  }
  .cmdk-list {
    list-style: none;
    margin: 0;
    padding: 0.4rem;
    max-height: 52vh;
    overflow-y: auto;
  }
  .cmdk-hint {
    padding: 1.1rem 0.8rem;
    text-align: center;
    color: var(--text-light);
    font-size: 0.88rem;
  }
  .cmdk-item {
    display: flex;
    flex-direction: column;
    gap: 0.18rem;
    padding: 0.62rem 0.8rem;
    border-radius: var(--radius-md);
    cursor: pointer;
  }
  .cmdk-item.is-active {
    background: var(--monet-blue-lighter);
  }
  .cmdk-item-title {
    font-size: 0.93rem;
    color: var(--text-dark);
    line-height: 1.45;
  }
  .cmdk-item-meta {
    font-size: 0.76rem;
    color: var(--text-light);
  }
  :global([data-theme="dark"]) .cmdk-panel {
    background: #1a252c;
    border-color: rgba(255, 255, 255, 0.1);
  }
  :global([data-theme="dark"]) .cmdk-item.is-active {
    background: rgba(143, 180, 197, 0.18);
  }
</style>
