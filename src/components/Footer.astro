---
import { SITE_TITLE } from '../consts';
const today = new Date();
---

<footer>
  <div class="footer-content">
    <p class="footer-title">{SITE_TITLE}</p>
    <p class="footer-text">用心记录，慢慢生长。</p>
    <p class="copyright">&copy; {today.getFullYear()} {SITE_TITLE}. All rights reserved.</p>
  </div>
</footer>

<style>
  footer {
    margin-top: 4rem;
    padding: 3rem 1.5rem 2rem;
    background: var(--monet-blue-lighter);
    border-top: 1px solid var(--border-light);
    text-align: center;
  }
  .footer-content {
    max-width: 960px;
    margin: 0 auto;
  }
  .footer-title {
    font-size: 1.1rem;
    color: var(--monet-blue);
    font-weight: 600;
    margin-bottom: 0.5rem;
  }
  .footer-text {
    color: var(--text-gray);
    font-size: 0.9rem;
    margin-bottom: 1rem;
  }
  .copyright {
    color: var(--text-light);
    font-size: 0.8rem;
    margin: 0;
  }
</style>
