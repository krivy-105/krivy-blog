---
import { SITE_TITLE } from '../consts';
const today = new Date();
---

<footer>
  <div class="footer-inner">
    <div class="footer-brand">
      <span class="footer-name">{SITE_TITLE}</span>
      <span class="footer-dot">·</span>
      <span class="footer-domain">krivy.cyou</span>
    </div>
    <p class="footer-slogan">用心记录，慢慢生长。</p>
    <ul class="footer-links" aria-label="页脚快捷链接">
      <li><a href="/security" class="footer-link">🛡️ 网安笔记</a></li>
      <li><a href="/now" class="footer-link">🌤️ Now</a></li>
      <li><a href="/moments" class="footer-link">✨ 说说</a></li>
      <li><a href="/guestbook" class="footer-link">💌 留言板</a></li>
      <li><a href="/tags" class="footer-link">🏷️ 标签</a></li>
      <li><a href="/archive" class="footer-link">📅 归档</a></li>
      <li><a href="/links" class="footer-link">🔗 友链</a></li>
      <li><a href="/about" class="footer-link">🛠️ 关于</a></li>
    </ul>
    <p class="copyright">&copy; {today.getFullYear()} {SITE_TITLE}. All rights reserved.</p>
  </div>
</footer>

<style>
  footer {
    margin-top: auto;
    padding: 2.8rem 1.5rem 2.2rem;
    border-top: 1px solid color-mix(in srgb, var(--border-light) 85%, transparent);
    text-align: center;
    background:
      radial-gradient(720px 180px at 50% 0%, rgba(126, 166, 184, 0.10), transparent 70%),
      color-mix(in srgb, var(--bg-body) 72%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    transition: background 0.3s var(--ease);
  }
  :global([data-theme="dark"]) footer {
    background:
      radial-gradient(720px 180px at 50% 0%, rgba(143, 180, 197, 0.08), transparent 70%),
      color-mix(in srgb, var(--bg-body) 72%, transparent);
  }
  .footer-inner {
    max-width: var(--width-wide);
    margin: 0 auto;
  }
  .footer-brand {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    margin-bottom: 0.5rem;
  }
  .footer-name {
    font-size: 1.02rem;
    color: var(--monet-blue-dark);
    font-weight: 650;
  }
  .footer-dot { color: var(--text-light); }
  .footer-domain {
    font-size: 0.88rem;
    color: var(--text-gray);
    letter-spacing: 0.03em;
  }
  .footer-slogan {
    color: var(--text-gray);
    font-size: 0.9rem;
    margin-bottom: 0.75rem;
  }
  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0 0 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.4rem 0.25rem;
  }
  .footer-link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 6px 12px;
    border-radius: var(--radius-pill);
    color: var(--monet-blue-dark);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 500;
    border: 1px solid transparent;
    transition: all 0.25s var(--ease);
  }
  .footer-link:hover {
    background: var(--glass-bg);
    border-color: color-mix(in srgb, var(--monet-blue) 22%, transparent);
    transform: translateY(-1px);
    box-shadow: var(--shadow-sm);
  }
  .copyright {
    color: var(--text-light);
    font-size: 0.78rem;
    margin: 0;
  }
  @media (max-width: 560px) {
    .footer-links { gap: 0.3rem 0.1rem; }
    .footer-link { padding: 5px 10px; font-size: 0.8rem; }
  }
</style>
