---
import { commentQueries, likeQueries, shareQueries } from '../lib/db';

interface Props {
  postId: number;
  slug: string;
  title: string;
  user?: { id: number; username: string } | null;
}

const { postId, slug, title, user } = Astro.props;

const likes = (likeQueries.countForPost.get(postId) as { count: number }).count;
const comments = commentQueries.findByPost.all(postId) as {
  id: number;
  content: string;
  created_at: number;
  user_id: number;
  username: string;
}[];
const shares = (shareQueries.countForPost.get(postId) as { count: number }).count;
const liked = user ? !!likeQueries.find.get(user.id, postId) : false;

const shareUrl = new URL(`/blog/${slug}/`, Astro.site).href;

const formatDate = (ts: number) =>
  new Date(ts).toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });

---

<div
  class="post-interact"
  data-post-id={postId}
  data-share-url={shareUrl}
  data-share-title={title}
  data-username={user?.username ?? ''}
>
  <!-- 互动操作条 -->
  <div class="interact-bar">
    {
      user ? (
        <button type="button" class={`act act-like${liked ? ' is-liked' : ''}`} id="piLikeBtn" aria-pressed={liked}>
          <span class="like-anchor">
            <svg class="ic-heart" viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
              />
            </svg>
            <span class="like-ring"></span>
          </span>
          <span class="act-text">赞</span>
          <span class="act-count" id="piLikeCount">{likes}</span>
        </button>
      ) : (
        <a href="/login" class="act act-like" title="登录后即可点赞">
          <span class="like-anchor">
            <svg class="ic-heart" viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
              />
            </svg>
          </span>
          <span class="act-text">赞</span>
          <span class="act-count">{likes}</span>
        </a>
      )
    }

    <a href="#piComments" class="act act-comment">
      <svg class="ic" viewBox="0 0 24 24" aria-hidden="true">
        <path
          d="M21 6h-2v9H6v2c0 .55.45 1 1 1h11l4 4V7c0-.55-.45-1-1-1zm-4 6V3c0-.55-.45-1-1-1H3c-.55 0-1 .45-1 1v14l4-4h10c.55 0 1-.45 1-1z"
        />
      </svg>
      <span class="act-text">评论</span>
      <span class="act-count" id="piCommentCount">{comments.length}</span>
    </a>

    <button type="button" class="act act-share" id="piShareBtn">
      <svg class="ic" viewBox="0 0 24 24" aria-hidden="true">
        <path
          d="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.5-.31 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65 0 1.61 1.31 2.92 2.92 2.92s2.92-1.31 2.92-2.92-1.31-2.92-2.92-2.92z"
        />
      </svg>
      <span class="act-text">转发</span>
      <span class="act-count" id="piShareCount">{shares}</span>
    </button>
  </div>

  <!-- 评论区 -->
  <section class="comments" id="piComments">
    <h3 class="comments-title">
      评论
      <span class="comments-num" id="piCommentNum">{comments.length}</span>
    </h3>

    {
      user ? (
        <form class="comment-form" id="piCommentForm">
          <span class="comment-avatar">{user.username.slice(0, 1).toUpperCase()}</span>
          <div class="comment-field">
            <textarea
              id="piCommentInput"
              name="content"
              rows="3"
              maxlength="500"
              placeholder="留下你的想法……（Enter 换行，Ctrl/⌘ + Enter 发送）"
            ></textarea>
            <div class="comment-form-foot">
              <span class="comment-tip" id="piCommentTip"></span>
              <button type="submit" class="btn btn-primary btn-sm">发表评论</button>
            </div>
          </div>
        </form>
      ) : (
        <div class="comment-login card">
          <span>登录后即可参与评论</span>
          <a href="/login" class="btn btn-primary btn-sm">去登录 / 注册</a>
        </div>
      )
    }

    <ul class="comment-list" id="piCommentList">
      {
        comments.map((c, i) => (
          <li class="comment-item" style={`animation-delay: ${Math.min(i, 12) * 50}ms`}>
            <a href={`/users/${c.username}`} class="comment-avatar-link" title={`@${c.username} 的主页`}>
              <span class="comment-avatar">{c.username.slice(0, 1).toUpperCase()}</span>
            </a>
            <div class="comment-body">
              <div class="comment-head">
                <a href={`/users/${c.username}`} class="comment-user">{c.username}</a>
                <time datetime={new Date(c.created_at).toISOString()}>{formatDate(c.created_at)}</time>
              </div>
              <p class="comment-text">{c.content}</p>
            </div>
          </li>
        ))
      }
    </ul>
    {comments.length === 0 && <p class="comment-empty" id="piCommentEmpty">还没有评论，来做第一个发声的人吧。</p>}
  </section>

  <!-- 轻提示 -->
  <div class="pi-toast" id="piToast" role="status" aria-live="polite"></div>
</div>

<script>
  const root = document.querySelector('.post-interact') as HTMLElement | null;
  if (root) {
    const postId = Number(root.dataset.postId);
    const shareUrl = root.dataset.shareUrl!;
    const shareTitle = root.dataset.shareTitle!;
    const username = root.dataset.username || '';
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const toastEl = root.querySelector<HTMLElement>('#piToast')!;
    let toastTimer: ReturnType<typeof setTimeout> | undefined;
    function toast(msg: string) {
      toastEl.textContent = msg;
      toastEl.classList.add('is-show');
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => toastEl.classList.remove('is-show'), 2200);
    }

    function bump(el: HTMLElement) {
      el.classList.remove('is-bump');
      void el.offsetWidth; // 重启动画
      el.classList.add('is-bump');
    }

    // ---------- 点赞 ----------
    const likeBtn = root.querySelector<HTMLButtonElement>('#piLikeBtn');
    const likeCount = root.querySelector<HTMLElement>('#piLikeCount');

    function spawnHearts() {
      if (prefersReduced) return;
      const anchor = likeBtn!.querySelector('.like-anchor') as HTMLElement;
      const colors = ['#ef6f83', '#f58da0', '#e26d5c', '#f4a259', '#7ea6b8'];
      const total = 8;
      for (let i = 0; i < total; i++) {
        const p = document.createElement('span');
        p.className = 'like-particle';
        const angle = (Math.PI * (0.15 + 0.7 * (i / (total - 1)))) + Math.PI; // 向上扇形
        const dist = 34 + Math.random() * 26;
        p.style.setProperty('--tx', `${Math.cos(angle) * dist}px`);
        p.style.setProperty('--ty', `${Math.sin(angle) * dist}px`);
        p.style.setProperty('--rot', `${(Math.random() - 0.5) * 90}deg`);
        p.style.setProperty('--delay', `${i * 18}ms`);
        p.style.setProperty('--c', colors[i % colors.length]);
        p.innerHTML =
          '<svg viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>';
        anchor.appendChild(p);
        p.addEventListener('animationend', () => p.remove());
      }
    }

    likeBtn?.addEventListener('click', async () => {
      if (likeBtn.dataset.loading === '1') return;
      likeBtn.dataset.loading = '1';
      // 乐观更新，失败回滚
      const wasLiked = likeBtn.classList.contains('is-liked');
      likeBtn.classList.toggle('is-liked', !wasLiked);
      likeBtn.setAttribute('aria-pressed', String(!wasLiked));
      let current = Number(likeCount?.textContent || 0);
      current += wasLiked ? -1 : 1;
      if (likeCount) likeCount.textContent = String(Math.max(0, current));
      if (!wasLiked) {
        likeBtn.classList.remove('is-pop');
        void likeBtn.offsetWidth;
        likeBtn.classList.add('is-pop');
        spawnHearts();
      }
      if (likeCount) bump(likeCount);

      try {
        const res = await fetch(`/api/posts/${postId}/like`, { method: 'POST' });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || '操作失败');
        likeBtn.classList.toggle('is-liked', data.liked);
        likeBtn.setAttribute('aria-pressed', String(data.liked));
        if (likeCount) likeCount.textContent = String(data.likes);
        if (likeCount) bump(likeCount);
      } catch (e) {
        likeBtn.classList.toggle('is-liked', wasLiked);
        likeBtn.setAttribute('aria-pressed', String(wasLiked));
        if (likeCount) likeCount.textContent = String(Math.max(0, current + (wasLiked ? 1 : -1)));
        toast(e instanceof Error ? e.message : '操作失败，请稍后再试');
      } finally {
        likeBtn.dataset.loading = '';
      }
    });

    // ---------- 评论 ----------
    const form = root.querySelector<HTMLFormElement>('#piCommentForm');
    const input = root.querySelector<HTMLTextAreaElement>('#piCommentInput');
    const list = root.querySelector<HTMLUListElement>('#piCommentList');
    const commentCount = root.querySelector<HTMLElement>('#piCommentCount');
    const commentNum = root.querySelector<HTMLElement>('#piCommentNum');
    const emptyHint = root.querySelector<HTMLElement>('#piCommentEmpty');
    const tip = root.querySelector<HTMLElement>('#piCommentTip');

    function relativeTime(ts: number): string {
      const diff = Date.now() - ts;
      const min = 60 * 1000;
      if (diff < min) return '刚刚';
      if (diff < 60 * min) return `${Math.floor(diff / min)} 分钟前`;
      if (diff < 24 * 60 * min) return `${Math.floor(diff / (60 * min))} 小时前`;
      if (diff < 30 * 24 * 60 * min) return `${Math.floor(diff / (24 * 60 * min))} 天前`;
      return new Date(ts).toLocaleDateString('zh-CN');
    }

    function createCommentNode(c: {
      id: number | bigint;
      username: string;
      content: string;
      created_at: number;
    }, fresh = false) {
      const li = document.createElement('li');
      li.className = 'comment-item' + (fresh ? ' is-fresh' : '');

      const avatarLink = document.createElement('a');
      avatarLink.href = `/users/${encodeURIComponent(c.username)}`;
      avatarLink.className = 'comment-avatar-link';
      const av = document.createElement('span');
      av.className = 'comment-avatar';
      av.textContent = c.username.slice(0, 1).toUpperCase();
      avatarLink.appendChild(av);

      const body = document.createElement('div');
      body.className = 'comment-body';
      const head = document.createElement('div');
      head.className = 'comment-head';
      const userLink = document.createElement('a');
      userLink.href = `/users/${encodeURIComponent(c.username)}`;
      userLink.className = 'comment-user';
      userLink.textContent = c.username;
      const time = document.createElement('time');
      time.dateTime = new Date(c.created_at).toISOString();
      time.textContent = fresh ? '刚刚' : relativeTime(c.created_at);
      head.append(userLink, time);

      const text = document.createElement('p');
      text.className = 'comment-text';
      text.textContent = c.content; // 以文本渲染，天然防 XSS

      body.append(head, text);
      li.append(avatarLink, body);
      return li;
    }

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const content = input!.value.trim();
      if (!content) {
        tip!.textContent = '说点什么再发送吧';
        input!.focus();
        return;
      }
      const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      btn.disabled = true;
      tip!.textContent = '';
      try {
        const res = await fetch(`/api/posts/${postId}/comments`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ content }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || '评论失败');
        emptyHint?.remove();
        list!.prepend(createCommentNode(data.comment, true));
        input!.value = '';
        const n = Number(commentCount?.textContent || 0) + 1;
        if (commentCount) commentCount.textContent = String(n);
        if (commentNum) {
          commentNum.textContent = String(n);
          bump(commentNum);
        }
        toast('评论已发布');
      } catch (err) {
        tip!.textContent = err instanceof Error ? err.message : '评论失败，请稍后再试';
      } finally {
        btn.disabled = false;
      }
    });

    input?.addEventListener('keydown', (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
        e.preventDefault();
        form?.requestSubmit();
      }
    });

    // ---------- 转发 ----------
    const shareBtn = root.querySelector<HTMLButtonElement>('#piShareBtn');
    const shareCount = root.querySelector<HTMLElement>('#piShareCount');
    let shared = false;

    async function recordShare() {
      if (shared) return;
      shared = true;
      try {
        const res = await fetch(`/api/posts/${postId}/share`, { method: 'POST' });
        const data = await res.json();
        if (res.ok && shareCount) {
          shareCount.textContent = String(data.shares);
          bump(shareCount);
        }
      } catch {
        shared = false;
      }
    }

    // 复制兜底：clipboard API 在页面失焦或非安全上下文下可能被拒绝
    async function copyText(text: string): Promise<boolean> {
      // 页面失焦/隐藏时 clipboard API 会被拒绝（控制台还会打印错误），直接走兜底方案
      const canUseClipboard =
        !!navigator.clipboard &&
        document.visibilityState === 'visible' &&
        document.hasFocus?.() !== false;
      if (canUseClipboard) {
        try {
          await navigator.clipboard!.writeText(text);
          return true;
        } catch {
          /* 继续尝试 legacy 方案 */
        }
      }
      try {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.setAttribute('readonly', '');
        ta.style.position = 'fixed';
        ta.style.top = '-999px';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        const done = document.execCommand('copy');
        ta.remove();
        return done;
      } catch {
        return false;
      }
    }

    shareBtn?.addEventListener('click', async () => {
      shareBtn.classList.remove('is-pop');
      void shareBtn.offsetWidth;
      shareBtn.classList.add('is-pop');
      try {
        if (navigator.share) {
          await navigator.share({ title: shareTitle, url: shareUrl });
          toast('感谢分享');
          recordShare();
          return;
        }
      } catch (err) {
        // 用户取消系统分享面板时不提示、不计次数
        if ((err as Error)?.name === 'AbortError') return;
      }
      const copied = await copyText(shareUrl);
      if (copied) {
        toast('链接已复制，快去分享吧');
        recordShare();
      } else {
        window.prompt('复制以下链接进行转发：', shareUrl);
        recordShare();
      }
    });
  }
</script>

<style is:global>
  .post-interact {
    margin-top: 2.6rem;
  }

  /* ---------- 操作条 ---------- */
  .interact-bar {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.7rem 0.9rem;
    background: var(--bg-white);
    border: 1px solid var(--border-light);
    border-radius: 999px;
    box-shadow: var(--shadow-sm);
    position: sticky;
    bottom: 1.1rem;
    z-index: 20;
  }
  .act {
    display: inline-flex;
    align-items: center;
    gap: 0.42rem;
    padding: 0.5rem 1rem;
    border: none;
    background: transparent;
    border-radius: 999px;
    color: var(--text-gray);
    font-size: 0.92rem;
    font-weight: 550;
    font-family: inherit;
    cursor: pointer;
    transition:
      color 0.25s var(--ease),
      background 0.25s var(--ease),
      transform 0.25s var(--ease);
  }
  .act:hover {
    background: var(--monet-blue-lighter);
    color: var(--monet-blue-dark);
  }
  .act:active { transform: scale(0.94); }
  .act .ic,
  .act .ic-heart {
    width: 19px;
    height: 19px;
    flex: none;
  }
  .act .ic { fill: currentColor; }
  .act-count {
    min-width: 1.2em;
    text-align: center;
    font-variant-numeric: tabular-nums;
    font-size: 0.86rem;
  }
  .act-count.is-bump {
    animation: countBump 0.35s var(--ease);
  }
  @keyframes countBump {
    0% { transform: translateY(0); }
    40% { transform: translateY(-3px) scale(1.25); color: var(--monet-blue-deep); }
    100% { transform: translateY(0); }
  }

  /* ---------- 点赞 ---------- */
  .like-anchor {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
  }
  .ic-heart {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    transition: fill 0.25s var(--ease), stroke 0.25s var(--ease);
    transform-origin: center;
    z-index: 1;
  }
  .act-like.is-liked {
    color: var(--heart, #ef6f83);
  }
  .act-like.is-liked:hover {
    color: #e25770;
    background: #fdf0f3;
  }
  .act-like.is-liked .ic-heart {
    fill: var(--heart, #ef6f83);
    stroke: var(--heart, #ef6f83);
  }
  .act-like.is-pop {
    animation: likePop 0.45s var(--ease);
  }
  @keyframes likePop {
    0% { transform: scale(1); }
    35% { transform: scale(1.22); }
    55% { transform: scale(0.92); }
    75% { transform: scale(1.06); }
    100% { transform: scale(1); }
  }
  .like-ring {
    position: absolute;
    inset: -5px;
    border-radius: 50%;
    border: 2px solid var(--heart, #ef6f83);
    opacity: 0;
    pointer-events: none;
  }
  .act-like.is-liked .like-ring {
    animation: ringPulse 0.6s var(--ease);
  }
  @keyframes ringPulse {
    0% { transform: scale(0.6); opacity: 0.55; }
    100% { transform: scale(1.9); opacity: 0; }
  }
  .like-particle {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 11px;
    height: 11px;
    margin: -5.5px 0 0 -5.5px;
    pointer-events: none;
    z-index: 0;
    animation: particleFly 0.75s var(--ease) forwards;
    animation-delay: var(--delay, 0ms);
    opacity: 0;
  }
  .like-particle svg {
    width: 100%;
    height: 100%;
    fill: var(--c, #ef6f83);
    display: block;
  }
  @keyframes particleFly {
    0% {
      opacity: 0;
      transform: translate(0, 0) scale(0.4) rotate(0deg);
    }
    15% { opacity: 1; }
    100% {
      opacity: 0;
      transform: translate(var(--tx, 0), var(--ty, -40px)) scale(1.05) rotate(var(--rot, 0deg));
    }
  }

  /* ---------- 转发按钮回弹 ---------- */
  .act-share.is-pop {
    animation: likePop 0.45s var(--ease);
  }

  /* ---------- 评论区 ---------- */
  .comments {
    margin-top: 2.4rem;
  }
  .comments-title {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-size: 1.15rem;
    margin-bottom: 1.2rem;
  }
  .comments-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.5em;
    height: 1.5em;
    padding: 0 0.4em;
    border-radius: 999px;
    background: var(--monet-blue-light);
    color: var(--monet-blue-dark);
    font-size: 0.8rem;
    font-weight: 600;
  }
  .comments-num.is-bump {
    animation: countBump 0.35s var(--ease);
  }

  .comment-form {
    display: flex;
    gap: 0.8rem;
    margin-bottom: 1.8rem;
    align-items: flex-start;
  }
  .comment-field {
    flex: 1;
    min-width: 0;
  }
  .comment-form textarea {
    width: 100%;
    resize: vertical;
    padding: 0.75rem 0.95rem;
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    background: var(--bg-white);
    font-family: inherit;
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--text-dark);
    transition: border-color 0.2s var(--ease), box-shadow 0.2s var(--ease);
  }
  .comment-form textarea:focus {
    outline: none;
    border-color: var(--monet-blue);
    box-shadow: 0 0 0 3px rgba(107, 148, 168, 0.15);
  }
  .comment-form-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 0.55rem;
  }
  .comment-tip {
    font-size: 0.82rem;
    color: #d2604e;
  }
  .comment-login {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 1.1rem 1.3rem;
    margin-bottom: 1.8rem;
    color: var(--text-gray);
    font-size: 0.92rem;
  }

  .comment-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .comment-item {
    display: flex;
    gap: 0.75rem;
    padding: 1.05rem 0;
    border-bottom: 1px dashed var(--border-light);
    animation: commentIn 0.45s var(--ease) both;
  }
