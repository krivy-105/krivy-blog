---
import { commentQueries, likeQueries, shareQueries, bookmarkQueries, reportQueries } from '../lib/db';
import Avatar from './Avatar.astro';

interface Props {
  postId: number;
  slug: string;
  title: string;
  user?: { id: number; username: string; avatar?: string | null } | null;
}

const { postId, slug, title, user } = Astro.props;

const likes = (likeQueries.countForPost.get(postId) as { count: number }).count;
const comments = commentQueries.findThreadedByPost(postId, 'hot') as any[];
const totalComments = (commentQueries.countForPost.get(postId) as { count: number }).count;
const shares = (shareQueries.countForPost.get(postId) as { count: number }).count;
const liked = user ? !!likeQueries.find.get(user.id, postId) : false;
const bookmarks = (bookmarkQueries.countForPost.get(postId) as { count: number }).count;
const bookmarked = user ? !!bookmarkQueries.find.get(user.id, postId) : false;

// 预先查每个评论当前用户是否点过赞（列表用）
const likedCommentIds = new Set<number>();
const reportedCommentIds = new Set<number>();
if (user) {
  // 收集所有展平后的 comment id（顶层 + 回复）
  const ids: number[] = [];
  const walk = (arr: any[]) => {
    for (const c of arr) {
      ids.push(c.id);
      if (c.replies?.length) walk(c.replies);
    }
  };
  walk(comments);
  if (ids.length) {
    const rows = commentQueries.likedByUser(user.id, ids);
    for (const r of rows) likedCommentIds.add(r.comment_id);
    const rrows = reportQueries.reportedByUser(user.id, ids);
    for (const r of rrows) reportedCommentIds.add(r.comment_id);
  }
}

const shareUrl = new URL(`/blog/${slug}/`, Astro.site).href;

const formatDate = (ts: number) =>
  new Date(ts).toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
---

<div
  class="post-interact"
  data-post-id={postId}
  data-share-url={shareUrl}
  data-share-title={title}
  data-username={user?.username ?? ''}
  data-user-id={user?.id ?? ''}
>
  <!-- 互动操作条 -->
  <div class="interact-bar">
    {
      user ? (
        <button type="button" class={`act act-like${liked ? ' is-liked' : ''}`} id="piLikeBtn" aria-pressed={liked}>
          <span class="like-anchor">
            <svg class="ic-heart" viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
              />
            </svg>
            <span class="like-ring"></span>
          </span>
          <span class="act-text">赞</span>
          <span class="act-count" id="piLikeCount">{likes}</span>
        </button>
      ) : (
        <a href="/login" class="act act-like" title="登录后即可点赞">
          <span class="like-anchor">
            <svg class="ic-heart" viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
              />
            </svg>
          </span>
          <span class="act-text">赞</span>
          <span class="act-count">{likes}</span>
        </a>
      )
    }

    <a href="#piComments" class="act act-comment">
      <svg class="ic" viewBox="0 0 24 24" aria-hidden="true">
        <path
          d="M21 6h-2v9H6v2c0 .55.45 1 1 1h11l4 4V7c0-.55-.45-1-1-1zm-4 6V3c0-.55-.45-1-1-1H3c-.55 0-1 .45-1 1v14l4-4h10c.55 0 1-.45 1-1z"
        />
      </svg>
      <span class="act-text">评论</span>
      <span class="act-count" id="piCommentCount">{totalComments}</span>
    </a>

    <button type="button" class="act act-share" id="piShareBtn">
      <svg class="ic" viewBox="0 0 24 24" aria-hidden="true">
        <path
          d="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.5-.31 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65 0 1.61 1.31 2.92 2.92 2.92s2.92-1.31 2.92-2.92-1.31-2.92-2.92-2.92z"
        />
      </svg>
      <span class="act-text">转发</span>
      <span class="act-count" id="piShareCount">{shares}</span>
    </button>

    {
      user ? (
        <button type="button" class={`act act-bookmark${bookmarked ? ' is-bookmarked' : ''}`} id="piBookmarkBtn" aria-pressed={bookmarked}>
          <svg class="ic ic-bookmark" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M17 3H7c-1.1 0-2 .9-2 2v16l7-3 7 3V5c0-1.1-.9-2-2-2z" />
          </svg>
          <span class="act-text">收藏</span>
          <span class="act-count" id="piBookmarkCount">{bookmarks}</span>
        </button>
      ) : (
        <a href="/login" class="act act-bookmark" title="登录后即可收藏">
          <svg class="ic ic-bookmark" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M17 3H7c-1.1 0-2 .9-2 2v16l7-3 7 3V5c0-1.1-.9-2-2-2z" />
          </svg>
          <span class="act-text">收藏</span>
          <span class="act-count">{bookmarks}</span>
        </a>
      )
    }
  </div>

  <!-- 评论区 -->
  <section class="comments" id="piComments">
    <div class="comments-head">
      <h3 class="comments-title">
        评论
        <span class="comments-num" id="piCommentNum">{totalComments}</span>
      </h3>
      <div class="sort-tabs" role="tablist" aria-label="评论排序">
        <button type="button" class="sort-tab is-active" role="tab" data-sort="hot" aria-selected="true">
          🔥 最热
        </button>
        <button type="button" class="sort-tab" role="tab" data-sort="new" aria-selected="false">
          ⏱ 最新
        </button>
      </div>
    </div>

    {
      user ? (
        <form class="comment-form" id="piCommentForm" data-parent-id="" data-reply-to-user-id="">
          <a
            href={user ? `/users/${user.username}` : '/login'}
            class="comment-avatar-link"
            title={`@${user.username} 的主页`}
          >
            <Avatar name={user.username} src={user.avatar} class="comment-avatar" />
          </a>
          <div class="comment-field">
            <div class="reply-to-banner" id="piReplyBanner" hidden>
              <span class="reply-to-label">回复</span>
              <span class="reply-to-user" id="piReplyToUser"></span>
              <button type="button" class="reply-cancel" id="piCancelReply" aria-label="取消回复">×</button>
            </div>
            <textarea
              id="piCommentInput"
              name="content"
              rows="3"
              maxlength="500"
              placeholder="留下你的想法……（Enter 换行，Ctrl/⌘ + Enter 发送）"
            ></textarea>
            <div class="comment-form-foot">
              <span class="comment-tip" id="piCommentTip"></span>
              <button type="submit" class="btn btn-primary btn-sm" id="piCommentSubmit">发表评论</button>
            </div>
          </div>
        </form>
      ) : (
        <div class="comment-login card">
          <span>登录后即可参与评论</span>
          <a href="/login" class="btn btn-primary btn-sm">去登录 / 注册</a>
        </div>
      )
    }

    <ul class="comment-list" id="piCommentList">
      {
        comments.map((c, i) => (
          <li
            class="comment-item"
            data-comment-id={c.id}
            style={`animation-delay: ${Math.min(i, 12) * 50}ms`}
          >
            <a href={`/users/${c.username}`} class="comment-avatar-link" title={`@${c.username} 的主页`}>
              <Avatar name={c.username} src={c.avatar} class="comment-avatar" />
            </a>
            <div class="comment-body">
              <div class="comment-head">
                <a href={`/users/${c.username}`} class="comment-user">{c.username}</a>
                <time datetime={new Date(c.created_at).toISOString()}>{formatDate(c.created_at)}</time>
              </div>
              <p class="comment-text">{c.content}</p>
              <div class="comment-actions" data-comment-id={c.id} data-author-id={c.user_id} data-author-name={c.username}>
                <button type="button" class="cact cact-reply" aria-label={`回复 ${c.username}`}>
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 17 4 12 9 7"></polyline><path d="M20 18v-2a4 4 0 0 0-4-4H4"></path></svg>
                  回复
                </button>
                <button type="button" class={`cact cact-like${likedCommentIds.has(c.id) ? ' is-liked' : ''}`} aria-label="点赞评论">
                  <svg class="cact-like-ic" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                  </svg>
                  <span class="cact-like-count">{c.like_count ?? 0}</span>
                </button>
                {user && c.user_id !== user.id && (
                  <button
                    type="button"
                    class={`cact cact-report${reportedCommentIds.has(c.id) ? ' is-reported' : ''}`}
                    aria-label="举报评论"
                    data-comment-id={c.id}
                    data-reported={reportedCommentIds.has(c.id) ? '1' : '0'}
                  >
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V4s-1 1-4 1-5-2-8-2-4 1-4 1z"/>
                      <line x1="4" y1="22" x2="4" y2="15"/>
                    </svg>
                    <span>{reportedCommentIds.has(c.id) ? '已举报' : '举报'}</span>
                  </button>
                )}
              </div>
              {
                Array.isArray(c.replies) && c.replies.length > 0 && (
                  <ul class="reply-list">
                    {c.replies.map((r: any) => (
                      <li class="reply-item" data-comment-id={r.id} data-author-id={r.user_id} data-author-name={r.username}>
                        <a href={`/users/${r.username}`} class="reply-avatar-link">
                          <Avatar name={r.username} src={r.avatar} class="reply-avatar" />
                        </a>
                        <div class="reply-body">
                          <div class="reply-head">
                            <a href={`/users/${r.username}`} class="reply-user">{r.username}</a>
                            {r.reply_to_username && r.reply_to_username !== c.username && (
                              <>
                                <span class="reply-arrow">回复</span>
                                <a href={`/users/${r.reply_to_username}`} class="reply-to">@{r.reply_to_username}</a>
                              </>
                            )}
                            <time datetime={new Date(r.created_at).toISOString()}>{formatDate(r.created_at)}</time>
                          </div>
                          <p class="reply-text">{r.content}</p>
                          <div class="reply-actions" data-comment-id={r.id} data-author-id={r.user_id} data-author-name={r.username} data-parent-id={c.id}>
                            <button type="button" class="cact cact-reply sm" aria-label={`回复 ${r.username}`}>
                              <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 17 4 12 9 7"></polyline><path d="M20 18v-2a4 4 0 0 0-4-4H4"></path></svg>
                              回复
                            </button>
                            <button type="button" class="cact cact-like sm" aria-label="点赞回复">
                              <svg class="cact-like-ic" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                              </svg>
                              <span class="cact-like-count">{r.like_count ?? 0}</span>
                            </button>
                            {user && r.user_id !== user.id && (
                              <button
                                type="button"
                                class={`cact cact-report sm${reportedCommentIds.has(r.id) ? ' is-reported' : ''}`}
                                aria-label="举报回复"
                                data-comment-id={r.id}
                                data-reported={reportedCommentIds.has(r.id) ? '1' : '0'}
                              >
                                <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                  <path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V4s-1 1-4 1-5-2-8-2-4 1-4 1z"/>
                                  <line x1="4" y1="22" x2="4" y2="15"/>
                                </svg>
                                <span>{reportedCommentIds.has(r.id) ? '已举报' : '举报'}</span>
                              </button>
                            )}
                          </div>
                        </div>
                      </li>
                    ))}
                  </ul>
                )
              }
            </div>
          </li>
        ))
      }
    </ul>
    {totalComments === 0 && <p class="comment-empty" id="piCommentEmpty">还没有评论，来做第一个发声的人吧。</p>}
  </section>

  <!-- 轻提示 -->
  <div class="pi-toast" id="piToast" role="status" aria-live="polite"></div>
</div>

<script>
  const root = document.querySelector('.post-interact') as HTMLElement | null;
  if (root) {
    const postId = Number(root.dataset.postId);
    const shareUrl = root.dataset.shareUrl!;
    const shareTitle = root.dataset.shareTitle!;
    const username = root.dataset.username || '';
    const userId = Number(root.dataset.userId) || 0;
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const toastEl = root.querySelector<HTMLElement>('#piToast')!;
    let toastTimer: ReturnType<typeof setTimeout> | undefined;
    function toast(msg: string) {
      toastEl.textContent = msg;
      toastEl.classList.add('is-show');
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => toastEl.classList.remove('is-show'), 2200);
    }

    function bump(el: HTMLElement) {
      el.classList.remove('is-bump');
      void el.offsetWidth;
      el.classList.add('is-bump');
    }

    // ---------- 举报评论（事件委托） ----------
    root.addEventListener('click', async (e: Event) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.cact-report');
      if (!btn) return;
      if (!userId) {
        window.location.href = '/login';
        return;
      }
      if (btn.dataset.reported === '1' || btn.dataset.loading === '1') return;
      const reason = window.prompt('请填写举报理由（必填，最长 200 字）：');
      if (reason === null) return;
      if (!reason.trim()) {
        toast('举报理由不能为空');
        return;
      }
      const cid = btn.dataset.commentId;
      btn.dataset.loading = '1';
      try {
        const res = await fetch(`/api/comments/${cid}/report`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ reason: reason.trim().slice(0, 200) }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error || '举报失败');
        btn.dataset.reported = '1';
        btn.classList.add('is-reported');
        const span = btn.querySelector('span:last-child');
        if (span) span.textContent = '已举报';
        toast('已提交举报，等待管理员处理');
      } catch (err) {
        toast(err instanceof Error ? err.message : '网络错误');
      } finally {
        btn.dataset.loading = '0';
      }
    });

    // ---------- 点赞 ----------
    const likeBtn = root.querySelector<HTMLButtonElement>('#piLikeBtn');
    const likeCount = root.querySelector<HTMLElement>('#piLikeCount');

    function spawnHearts() {
      if (prefersReduced) return;
      const anchor = likeBtn!.querySelector('.like-anchor') as HTMLElement;
      const colors = ['#ef6f83', '#f58da0', '#e26d5c', '#f4a259', '#7ea6b8'];
      const total = 8;
      for (let i = 0; i < total; i++) {
        const p = document.createElement('span');
        p.className = 'like-particle';
        const angle = (Math.PI * (0.15 + 0.7 * (i / (total - 1)))) + Math.PI;
        const dist = 34 + Math.random() * 26;
        p.style.setProperty('--tx', `${Math.cos(angle) * dist}px`);
        p.style.setProperty('--ty', `${Math.sin(angle) * dist}px`);
        p.style.setProperty('--rot', `${(Math.random() - 0.5) * 90}deg`);
        p.style.setProperty('--delay', `${i * 18}ms`);
        p.style.setProperty('--c', colors[i % colors.length]);
        p.innerHTML =
          '<svg viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>';
        anchor.appendChild(p);
        p.addEventListener('animationend', () => p.remove());
      }
    }

    likeBtn?.addEventListener('click', async () => {
      if (likeBtn.dataset.loading === '1') return;
      likeBtn.dataset.loading = '1';
      const wasLiked = likeBtn.classList.contains('is-liked');
      likeBtn.classList.toggle('is-liked', !wasLiked);
      likeBtn.setAttribute('aria-pressed', String(!wasLiked));
      let current = Number(likeCount?.textContent || 0);
      current += wasLiked ? -1 : 1;
      if (likeCount) likeCount.textContent = String(Math.max(0, current));
      if (!wasLiked) {
        likeBtn.classList.remove('is-pop');
        void likeBtn.offsetWidth;
        likeBtn.classList.add('is-pop');
        spawnHearts();
      }
      if (likeCount) bump(likeCount);

      try {
        const res = await fetch(`/api/posts/${postId}/like`, { method: 'POST' });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || '操作失败');
        likeBtn.classList.toggle('is-liked', data.liked);
        likeBtn.setAttribute('aria-pressed', String(data.liked));
        if (likeCount) likeCount.textContent = String(data.likes);
        if (likeCount) bump(likeCount);
      } catch (e) {
        likeBtn.classList.toggle('is-liked', wasLiked);
        likeBtn.setAttribute('aria-pressed', String(wasLiked));
        if (likeCount) likeCount.textContent = String(Math.max(0, current + (wasLiked ? 1 : -1)));
        toast(e instanceof Error ? e.message : '操作失败，请稍后再试');
      } finally {
        likeBtn.dataset.loading = '';
      }
    });

    // ---------- 评论 ----------
    const form = root.querySelector<HTMLFormElement>('#piCommentForm');
    const input = root.querySelector<HTMLTextAreaElement>('#piCommentInput');
    const list = root.querySelector<HTMLUListElement>('#piCommentList');
    const commentCount = root.querySelector<HTMLElement>('#piCommentCount');
    const commentNum = root.querySelector<HTMLElement>('#piCommentNum');
    const emptyHint = root.querySelector<HTMLElement>('#piCommentEmpty');
    const tip = root.querySelector<HTMLElement>('#piCommentTip');
    const replyBanner = root.querySelector<HTMLElement>('#piReplyBanner');
    const replyToUser = root.querySelector<HTMLElement>('#piReplyToUser');
    const cancelReplyBtn = root.querySelector<HTMLButtonElement>('#piCancelReply');

    function relativeTime(ts: number): string {
      const diff = Date.now() - ts;
      const min = 60 * 1000;
      if (diff < min) return '刚刚';
      if (diff < 60 * min) return `${Math.floor(diff / min)} 分钟前`;
      if (diff < 24 * 60 * min) return `${Math.floor(diff / (60 * min))} 小时前`;
      if (diff < 30 * 24 * 60 * min) return `${Math.floor(diff / (24 * 60 * min))} 天前`;
      return new Date(ts).toLocaleDateString('zh-CN');
    }

    function formatLocalDate(ts: number) {
      return new Date(ts).toLocaleDateString('zh-CN', {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
      });
    }

    function setReplyContext(parentId: number | '', replyUserId: number | '', replyToUname: string) {
      if (!form) return;
      form.dataset.parentId = String(parentId || '');
      form.dataset.replyToUserId = String(replyUserId || '');
      if (parentId && replyToUname) {
        replyBanner!.hidden = false;
        replyToUser!.textContent = `@${replyToUname}`;
        input!.focus();
      } else {
        replyBanner!.hidden = true;
        replyToUser!.textContent = '';
      }
    }

    cancelReplyBtn?.addEventListener('click', () => {
      setReplyContext('', '', '');
    });

    // 绑定：回复按钮 / 评论点赞（顶层 + 回复里都有）
    function bindCommentInteractions(scope: ParentNode = root) {
      scope.querySelectorAll<HTMLElement>('.comment-actions, .reply-actions').forEach((wrap) => {
        const cid = Number(wrap.dataset.commentId);
        const authorId = Number(wrap.dataset.authorId);
        const authorName = String(wrap.dataset.authorName || '');
        const parentId = wrap.dataset.parentId ? Number(wrap.dataset.parentId) : 0;
        const replyBtn = wrap.querySelector<HTMLButtonElement>('.cact-reply');
        const likeBtnC = wrap.querySelector<HTMLButtonElement>('.cact-like');
        const likeCountC = likeBtnC?.querySelector<HTMLElement>('.cact-like-count');

        replyBtn?.addEventListener('click', () => {
          if (!userId) {
            window.location.href = '/login';
            return;
          }
          // 对于回复项，挂的 parent 是顶层 comment id
          const realParent = parentId ? parentId : cid;
          // reply_to_user_id = 被点击项作者
          setReplyContext(realParent, authorId, authorName);
          // 视觉滚到输入框
          input?.focus({ preventScroll: false });
          form?.scrollIntoView({ behavior: prefersReduced ? 'auto' : 'smooth', block: 'center' });
        });

        likeBtnC?.addEventListener('click', async () => {
          if (!userId) {
            window.location.href = '/login';
            return;
          }
          if (likeBtnC.dataset.loading === '1') return;
          likeBtnC.dataset.loading = '1';
          const wasLiked = likeBtnC.classList.contains('is-liked');
          const cur = Number(likeCountC?.textContent || 0);
          const next = Math.max(0, cur + (wasLiked ? -1 : 1));
          likeBtnC.classList.toggle('is-liked', !wasLiked);
          if (likeCountC) likeCountC.textContent = String(next);
          if (likeCountC) bump(likeCountC);

          try {
            const res = await fetch(`/api/comments/${cid}/like`, { method: 'POST' });
            const data = await res.json();
            if (!res.ok) throw new Error(data.error || '操作失败');
            likeBtnC.classList.toggle('is-liked', data.liked);
            if (likeCountC) likeCountC.textContent = String(data.likes);
          } catch (e) {
            likeBtnC.classList.toggle('is-liked', wasLiked);
            if (likeCountC) likeCountC.textContent = String(cur);
            toast(e instanceof Error ? e.message : '操作失败');
          } finally {
            likeBtnC.dataset.loading = '';
          }
        });
      });
    }
    bindCommentInteractions(root);

    function createCommentNode(c: {
      id: number | bigint;
      username: string;
      avatar?: string | null;
      content: string;
      created_at: number;
      parent_id?: number | null;
      reply_to_username?: string | null;
      like_count?: number;
      replies?: any[];
    }, fresh = false, mode: 'top' | 'reply' = 'top', threadRootEl?: HTMLElement | null) {
      const li = document.createElement('li');
      if (mode === 'top') {
        li.className = 'comment-item' + (fresh ? ' is-fresh' : '');
        li.dataset.commentId = String(c.id);
      } else {
        li.className = 'reply-item' + (fresh ? ' is-fresh' : '');
        li.dataset.commentId = String(c.id);
      }

      const avatarLink = document.createElement('a');
      avatarLink.href = `/users/${encodeURIComponent(c.username)}`;
      avatarLink.className = mode === 'top' ? 'comment-avatar-link' : 'reply-avatar-link';
      const avatarClass = mode === 'top' ? 'comment-avatar' : 'reply-avatar';
      if (c.avatar) {
        const img = document.createElement('img');
        img.className = `md-avatar ${avatarClass}`;
        img.src = c.avatar;
        img.alt = `${c.username} 的头像`;
        img.loading = 'lazy';
        img.decoding = 'async';
        avatarLink.appendChild(img);
      } else {
        const span = document.createElement('span');
        span.className = avatarClass;
        span.textContent = c.username.slice(0, 1).toUpperCase();
        avatarLink.appendChild(span);
      }

      const body = document.createElement('div');
      body.className = mode === 'top' ? 'comment-body' : 'reply-body';
      const head = document.createElement('div');
      head.className = mode === 'top' ? 'comment-head' : 'reply-head';
      const userLink = document.createElement('a');
      userLink.href = `/users/${encodeURIComponent(c.username)}`;
      userLink.className = mode === 'top' ? 'comment-user' : 'reply-user';
      userLink.textContent = c.username;
      const time = document.createElement('time');
      time.dateTime = new Date(c.created_at).toISOString();
      time.textContent = fresh ? '刚刚' : relativeTime(c.created_at);

      if (mode === 'reply' && c.reply_to_username && c.reply_to_username !== (threadRootEl?.querySelector('.comment-user') as HTMLElement | null)?.textContent) {
        head.append(userLink);
        const arrow = document.createElement('span');
        arrow.className = 'reply-arrow';
        arrow.textContent = '回复';
        const toA = document.createElement('a');
        toA.href = `/users/${encodeURIComponent(c.reply_to_username)}`;
        toA.className = 'reply-to';
        toA.textContent = `@${c.reply_to_username}`;
        head.append(arrow, toA, time);
      } else {
        head.append(userLink, time);
      }

      const text = document.createElement('p');
      text.className = mode === 'top' ? 'comment-text' : 'reply-text';
      text.textContent = c.content;

      // actions
      const actions = document.createElement('div');
      actions.className = mode === 'top' ? 'comment-actions' : 'reply-actions';
      actions.dataset.commentId = String(c.id);
      actions.dataset.authorId = String(Number(BigInt(c.id).toString().replace(/\D/g, '')) || '0');
      actions.dataset.authorName = c.username;

      const replyAct = document.createElement('button');
      replyAct.type = 'button';
      replyAct.className = 'cact cact-reply' + (mode === 'reply' ? ' sm' : '');
      replyAct.setAttribute('aria-label', `回复 ${c.username}`);
      replyAct.innerHTML = `<svg viewBox="0 0 24 24" width="${mode === 'reply' ? 12 : 14}" height="${mode === 'reply' ? 12 : 14}" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 17 4 12 9 7"></polyline><path d="M20 18v-2a4 4 0 0 0-4-4H4"></path></svg>回复`;

      const likeAct = document.createElement('button');
      likeAct.type = 'button';
      likeAct.className = 'cact cact-like' + (mode === 'reply' ? ' sm' : '');
      likeAct.setAttribute('aria-label', '点赞评论');
      likeAct.innerHTML = `<svg class="cact-like-ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg><span class="cact-like-count">${c.like_count ?? 0}</span>`;

      actions.append(replyAct, likeAct);

      body.append(head, text, actions);
      li.append(avatarLink, body);
      if (mode === 'top' && Array.isArray(c.replies) && c.replies.length) {
        const repList = document.createElement('ul');
        repList.className = 'reply-list';
        for (const r of c.replies) {
          repList.appendChild(
            createCommentNode(
              { ...r, replies: [] },
              false,
              'reply',
              li
            )
          );
        }
        body.append(repList);
      }
      // 新创建节点绑定事件
      bindCommentInteractions(li);
      return li;
    }

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const content = input!.value.trim();
      if (!content) {
        tip!.textContent = '说点什么再发送吧';
        input!.focus();
        return;
      }
      const parentId = form.dataset.parentId ? Number(form.dataset.parentId) : null;
      const replyToUserId = form.dataset.replyToUserId ? Number(form.dataset.replyToUserId) : null;

      const btn = form.querySelector<HTMLButtonElement>('#piCommentSubmit')!;
      btn.disabled = true;
      tip!.textContent = '';
      try {
        const res = await fetch(`/api/posts/${postId}/comments`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ content, parent_id: parentId, reply_to_user_id: replyToUserId }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || '评论失败');
        emptyHint?.remove();
        // 判断是顶层评论还是回复
        if (!parentId) {
          list!.prepend(createCommentNode(data.comment, true, 'top'));
        } else {
          const parentLi = list!.querySelector<HTMLElement>(`li.comment-item[data-comment-id="${parentId}"]`);
          if (parentLi) {
            let repList = parentLi.querySelector<HTMLUListElement>('ul.reply-list');
            if (!repList) {
              repList = document.createElement('ul');
              repList.className = 'reply-list';
              const cb = parentLi.querySelector('.comment-body');
              cb?.append(repList);
            }
            repList.append(createCommentNode(data.comment, true, 'reply', parentLi));
          }
        }
        input!.value = '';
        setReplyContext('', '', '');
        const n = Number(commentCount?.textContent || 0) + 1;
        if (commentCount) commentCount.textContent = String(n);
        if (commentNum) {
          commentNum.textContent = String(n);
          bump(commentNum);
        }
        toast('评论已发布');
      } catch (err) {
        tip!.textContent = err instanceof Error ? err.message : '评论失败，请稍后再试';
      } finally {
        btn.disabled = false;
      }
    });

    input?.addEventListener('keydown', (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
        e.preventDefault();
        form?.requestSubmit();
      }
    });

    // 排序 Tab 切换：通过 mode=threaded&sort=hot|new 拉取并替换列表
    const sortTabs = root.querySelectorAll<HTMLButtonElement>('.sort-tab');
    sortTabs.forEach((tab) => {
      tab.addEventListener('click', async () => {
        if (tab.classList.contains('is-active')) return;
        sortTabs.forEach((t) => {
          t.classList.remove('is-active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('is-active');
        tab.setAttribute('aria-selected', 'true');
        const sort = tab.dataset.sort as 'hot' | 'new';
        try {
          list!.style.opacity = '0.55';
          const res = await fetch(`/api/posts/${postId}/comments?mode=threaded&sort=${sort}`);
          const data = await res.json();
          if (!res.ok || !data.success) throw new Error(data.error || '刷新失败');
          list!.innerHTML = '';
          const arr = data.comments as any[];
          if (arr.length === 0) {
            if (!emptyHint) {
              const p = document.createElement('p');
              p.className = 'comment-empty';
              p.id = 'piCommentEmpty';
              p.textContent = '还没有评论，来做第一个发声的人吧。';
              list!.after(p);
            }
          } else {
            emptyHint?.remove();
            for (let i = 0; i < arr.length; i++) {
              const c = arr[i];
              const li = createCommentNode(c, false, 'top');
              if (li.style) li.style.animationDelay = `${Math.min(i, 12) * 50}ms`;
              list!.append(li);
            }
          }
        } catch (e) {
          toast(e instanceof Error ? e.message : '加载失败');
        } finally {
          list!.style.opacity = '';
        }
      });
    });

    // ---------- 转发 ----------
    const shareBtn = root.querySelector<HTMLButtonElement>('#piShareBtn');
    const shareCount = root.querySelector<HTMLElement>('#piShareCount');
    let shared = false;

    async function recordShare() {
      if (shared) return;
      shared = true;
      try {
        const res = await fetch(`/api/posts/${postId}/share`, { method: 'POST' });
        const data = await res.json();
        if (res.ok && shareCount) {
          shareCount.textContent = String(data.shares);
          bump(shareCount);
        }
      } catch {
        shared = false;
      }
    }

    async function copyText(text: string): Promise<boolean> {
      const canUseClipboard =
        !!navigator.clipboard &&
        document.visibilityState === 'visible' &&
        document.hasFocus?.() !== false;
      if (canUseClipboard) {
        try {
          await navigator.clipboard!.writeText(text);
          return true;
        } catch {
          /* 继续尝试 legacy 方案 */
        }
      }
      try {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.setAttribute('readonly', '');
        ta.style.position = 'fixed';
        ta.style.top = '-999px';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        const done = document.execCommand('copy');
        ta.remove();
        return done;
      } catch {
        return false;
      }
    }

    shareBtn?.addEventListener('click', async () => {
      shareBtn.classList.remove('is-pop');
      void shareBtn.offsetWidth;
      shareBtn.classList.add('is-pop');
      try {
        if (navigator.share) {
          await navigator.share({ title: shareTitle, url: shareUrl });
          toast('感谢分享');
          recordShare();
          return;
        }
      } catch (err) {
        if ((err as Error)?.name === 'AbortError') return;
      }
      const copied = await copyText(shareUrl);
      if (copied) {
        toast('链接已复制，快去分享吧');
        recordShare();
      } else {
        window.prompt('复制以下链接进行转发：', shareUrl);
        recordShare();
      }
    });

    // ---------- 收藏 ----------
    const bookmarkBtn = root.querySelector<HTMLButtonElement>('#piBookmarkBtn');
    const bookmarkCount = root.querySelector<HTMLElement>('#piBookmarkCount');

    bookmarkBtn?.addEventListener('click', async () => {
      if (bookmarkBtn.dataset.loading === '1') return;
      bookmarkBtn.dataset.loading = '1';
      const wasMarked = bookmarkBtn.classList.contains('is-bookmarked');
      bookmarkBtn.classList.toggle('is-bookmarked', !wasMarked);
      bookmarkBtn.setAttribute('aria-pressed', String(!wasMarked));
      let cur = Number(bookmarkCount?.textContent || 0);
      cur = Math.max(0, cur + (wasMarked ? -1 : 1));
      if (bookmarkCount) bookmarkCount.textContent = String(cur);
      if (bookmarkCount) bump(bookmarkCount);
      bookmarkBtn.classList.remove('is-pop');
      void bookmarkBtn.offsetWidth;
      bookmarkBtn.classList.add('is-pop');

      try {
        const res = await fetch(`/api/posts/${postId}/bookmark`, { method: 'POST' });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || '操作失败');
        bookmarkBtn.classList.toggle('is-bookmarked', data.bookmarked);
        bookmarkBtn.setAttribute('aria-pressed', String(data.bookmarked));
        if (bookmarkCount) bookmarkCount.textContent = String(data.bookmarks);
        if (bookmarkCount) bump(bookmarkCount);
        toast(data.bookmarked ? '已收藏' : '已取消收藏');
      } catch (e) {
        bookmarkBtn.classList.toggle('is-bookmarked', wasMarked);
        bookmarkBtn.setAttribute('aria-pressed', String(wasMarked));
        if (bookmarkCount) bookmarkCount.textContent = String(Math.max(0, cur + (wasMarked ? 1 : -1)));
        toast(e instanceof Error ? e.message : '操作失败');
      } finally {
        bookmarkBtn.dataset.loading = '';
      }
    });
  }
</script>

