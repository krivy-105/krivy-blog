---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import Avatar from './Avatar.astro';
import DevToolbarHeart from './DevToolbarHeart.astro';
import CommandPalette from './CommandPalette.astro';
import Toast from './Toast.astro';
import BackToTop from './BackToTop.astro';
import BottomNav from './BottomNav.astro';
import { postQueries, reportQueries, userQueries } from '../lib/db';

const user = Astro.locals.user;
const isLoggedIn = !!user;
const isAdmin = user?.role === 'admin';
// Header 角标 = 待审文章 + 待处理举报 + 待审头像
const pendingCount = isAdmin
  ? (postQueries.countByStatus.get('pending') as { count: number }).count +
    (reportQueries.pendingCount.get('pending') as { count: number }).count +
    (userQueries.countPendingAvatars.get() as { count: number }).count
  : 0;
---

<header>
  <nav>
    <div class="nav-left">
      <a href="/" class="brand" aria-label={SITE_TITLE}>
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="18" height="18">
            <path
              fill="currentColor"
              d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
            />
          </svg>
        </span>
        <span class="brand-name">{SITE_TITLE}</span>
      </a>
    </div>

    <div class="nav-center" id="navCenter">
      <HeaderLink href="/">首页</HeaderLink>
      <HeaderLink href="/blog">文章</HeaderLink>
      <HeaderLink href="/schedule">课表</HeaderLink>
      <HeaderLink href="/archive">归档</HeaderLink>
      <HeaderLink href="/links">友链</HeaderLink>
      <HeaderLink href="/about">关于</HeaderLink>
      {isLoggedIn && <HeaderLink href="/write">写文章</HeaderLink>}
      {/* 动态（/feed）从导航撤掉：登录后导航已有 10 个入口，太挤。
          页面本身还在，从首页/个人页仍可进入。 */}
      {isLoggedIn && (
        <HeaderLink href="/messages">
          私信<span class="unread-badge" id="unreadBadge" style="display:none;">0</span>
        </HeaderLink>
      )}
      {isLoggedIn && (
        <HeaderLink href="/notifications">
          通知<span class="unread-badge notif-badge" id="notifBadge" style="display:none;">0</span>
        </HeaderLink>
      )}
      {isAdmin && (
        <HeaderLink href="/admin">
          管理后台<span
            class="unread-badge pending-badge"
            id="pendingBadge"
            style={pendingCount > 0 ? '' : 'display:none;'}
            >{pendingCount}</span
          >
        </HeaderLink>
      )}
      <form action="/search" method="GET" class="nav-search nav-search-mobile" role="search">
        <input
          type="search"
          name="q"
          class="nav-search-input"
          placeholder="搜索文章…"
          aria-label="搜索文章"
          autocomplete="off"
          tabindex="-1"
        />
        <svg class="nav-search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7"/><path d="M21 21l-4.35-4.35"/>
        </svg>
      </form>
    </div>

    <div class="nav-right">
      <form action="/search" method="GET" class="nav-search nav-search-desktop" role="search">
        <input
          type="search"
          name="q"
          class="nav-search-input"
          placeholder="搜索文章…"
          aria-label="搜索文章"
          autocomplete="off"
          tabindex="-1"
        />
        <svg class="nav-search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7"/><path d="M21 21l-4.35-4.35"/>
        </svg>
      </form>
      <button
        class="theme-toggle"
        id="themeToggle"
        aria-label="切换暗色模式"
        title="切换主题"
      >
        <svg class="ic-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"/>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
        </svg>
        <svg class="ic-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3a7 7 0 0 0 9.79 9.79z"/>
        </svg>
      </button>
      {isLoggedIn ? (
        <>
          <a href={`/users/${user!.username}`} class="user-name" title="我的主页">
            <Avatar name={user!.username} src={user!.avatar} class="user-avatar" />
            <span class="user-text">{user!.username}</span>
          </a>
          <form method="POST" action="/api/logout" class="logout-form">
            <button type="submit" class="btn btn-ghost btn-sm">退出</button>
          </form>
        </>
      ) : (
        <a href="/login" class="btn btn-primary btn-sm">登录 / 注册</a>
      )}
      <button
        class="nav-toggle"
        id="navToggle"
        aria-label="打开菜单"
        aria-expanded="false"
        aria-controls="navCenter"
      >
        <span></span><span></span><span></span>
      </button>
    </div>
  </nav>
</header>
<DevToolbarHeart />
<CommandPalette />
<Toast />
<BackToTop />
<BottomNav />

<script is:inline>
  // 防止浏览器加载时自动聚焦到导航栏搜索框（第一个 input）
  document.addEventListener('DOMContentLoaded', () => {
    const active = document.activeElement;
    if (active && active.tagName === 'INPUT' && active.type === 'search') {
      active.blur();
    }
  });
</script>

<script>
  // ============================================================
  // 动效层：进场景 / 顶栏滚动状态 / 卡片指针光晕
  // 全部是渐进增强——JS 不跑或用户偏好减少动效时，内容照常显示。
  // ============================================================
  (function () {
    const root = document.documentElement;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce) return;

    root.classList.add('motion-ready');

    // ---- 1. 滚动进场：先定位元素，再交给 IntersectionObserver ----
    const SEL = [
      '.post-card', '.hot-list', '.post-item', '.intro', '.intro-chips li',
      '.section-head', '.cl-item', '.series-card', '.tag-row', '.day-block',
      '.about-content h3', '.links-grid > *', '.guest-item', '.moment-card',
    ].join(',');

    const els = Array.prototype.slice.call(document.querySelectorAll(SEL));
    els.forEach(function (el, i) {
      el.classList.add('reveal');
      // 同一屏内的元素按顺序错开，最多 240ms，避免一屏等太久
      el.style.setProperty('--d', Math.min((i % 8) * 45, 240) + 'ms');
    });

    if ('IntersectionObserver' in window && els.length) {
      const io = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) {
              e.target.classList.add('is-in');
              io.unobserve(e.target);
            }
          });
        },
        { rootMargin: '0px 0px -6% 0px', threshold: 0.05 }
      );
      els.forEach(function (el) { io.observe(el); });
    } else {
      // 兜底：任何情况下都不让内容卡在透明状态
      els.forEach(function (el) { el.classList.add('is-in'); });
    }

    // ---- 2. 顶栏滚动状态 ----
    const header = document.querySelector('header');
    if (header) {
      let ticking = false;
      const apply = function () {
        header.classList.toggle('is-scrolled', window.scrollY > 8);
        ticking = false;
      };
      apply();
      window.addEventListener('scroll', function () {
        if (!ticking) { ticking = true; requestAnimationFrame(apply); }
      }, { passive: true });
    }

    // ---- 3. 卡片指针光晕（只给精确指针设备，触屏不参与） ----
    if (window.matchMedia('(pointer: fine)').matches) {
      const GLOW = '.card, .post-card, .hot-list, .post-item';
      let current = null;
      document.addEventListener('pointermove', function (ev) {
        const t = ev.target && ev.target.closest ? ev.target.closest(GLOW) : null;
        if (!t) { current = null; return; }
        if (t !== current) { current = t; t.classList.add('glow-card'); }
        const r = t.getBoundingClientRect();
        t.style.setProperty('--mx', (ev.clientX - r.left) + 'px');
        t.style.setProperty('--my', (ev.clientY - r.top) + 'px');
      }, { passive: true });
    }

    // ---- 4. 首屏光斑视差：指针位置 → --par-x / --par-y（线性插值，避免抖动） ----
    const hero = document.querySelector('.hero');
    if (hero && window.matchMedia('(pointer: fine)').matches) {
      let curX = 0, curY = 0, aimX = 0, aimY = 0, raf = 0;
      const tick = function () {
        curX += (aimX - curX) * 0.09;
        curY += (aimY - curY) * 0.09;
        hero.style.setProperty('--par-x', curX.toFixed(3));
        hero.style.setProperty('--par-y', curY.toFixed(3));
        if (Math.abs(aimX - curX) > 0.002 || Math.abs(aimY - curY) > 0.002) {
          raf = requestAnimationFrame(tick);
        } else {
          raf = 0;
        }
      };
      const wake = function () { if (!raf) raf = requestAnimationFrame(tick); };
      hero.addEventListener('pointermove', function (ev) {
        const r = hero.getBoundingClientRect();
        aimX = ((ev.clientX - r.left) / r.width - 0.5) * 2;
        aimY = ((ev.clientY - r.top) / r.height - 0.5) * 2;
        wake();
      }, { passive: true });
      hero.addEventListener('pointerleave', function () {
        aimX = 0; aimY = 0; wake();
      });
    }

    // ---- 5. 磁吸按钮：指针靠近时轻微吸附（用 translate，不覆盖 hover 的 transform） ----
    if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
      document.querySelectorAll('.hero-actions .btn, .more-wrap .btn').forEach(function (el) {
        el.addEventListener('pointermove', function (ev) {
          const r = el.getBoundingClientRect();
          const dx = (ev.clientX - (r.left + r.width / 2)) / r.width;
          const dy = (ev.clientY - (r.top + r.height / 2)) / r.height;
          el.style.translate = (dx * 8).toFixed(2) + 'px ' + (dy * 5).toFixed(2) + 'px';
        });
        el.addEventListener('pointerleave', function () {
          el.style.translate = '0px 0px';
        });
      });
    }

    // ---- 6. 点击涟漪 ----
    document.addEventListener('pointerdown', function (ev) {
      const btn = ev.target && ev.target.closest ? ev.target.closest('.btn') : null;
      if (!btn || btn.disabled) return;
      const r = btn.getBoundingClientRect();
      const size = Math.max(r.width, r.height) * 2.2;
      const dot = document.createElement('span');
      dot.className = 'ripple';
      dot.style.width = size + 'px';
      dot.style.height = size + 'px';
      dot.style.left = (ev.clientX - r.left) + 'px';
      dot.style.top = (ev.clientY - r.top) + 'px';
      btn.appendChild(dot);
      setTimeout(function () { dot.remove(); }, 700);
    }, { passive: true });

    // ---- 7. 图片淡入：解码完成后才显形，避免"半张图"跳出来 ----
    document.querySelectorAll('main img').forEach(function (img) {
      if (img.complete && img.naturalWidth) return;
      img.classList.add('img-fade');
      const done = function () { img.classList.add('is-loaded'); };
      img.addEventListener('load', done, { once: true });
      img.addEventListener('error', done, { once: true });
      // 兜底：事件万一丢失也不让图片永久隐形
      setTimeout(done, 4000);
    });
  })();
</script>

<style>
  header {
    padding: 0 1.5rem;
    background: color-mix(in srgb, var(--bg-white) 78%, transparent);
    backdrop-filter: blur(16px) saturate(1.15);
    -webkit-backdrop-filter: blur(16px) saturate(1.15);
    border-bottom: 1px solid color-mix(in srgb, var(--border-light) 80%, transparent);
    position: sticky;
    top: 0;
    z-index: 100;
    transition: background 0.3s var(--ease), border-color 0.3s var(--ease), box-shadow 0.3s var(--ease);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.35) inset;
  }
  :global([data-theme="dark"]) header {
    background: color-mix(in srgb, var(--bg-white) 78%, transparent);
    border-bottom-color: color-mix(in srgb, var(--border-light) 80%, transparent);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.04) inset;
  }
  /* 不支持背景模糊的环境（老 WebView / 部分安卓浏览器）直接用实色，
     否则 78% 透明度会让滚动的正文透上来 */
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    header { background: var(--bg-white); }
    :global([data-theme="dark"]) header { background: var(--bg-white); }
  }
  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: var(--width-wide);
    margin: 0 auto;
    height: 66px;
    gap: 1rem;
  }

  /* 品牌 */
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }
  .brand-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 11px;
    background: linear-gradient(145deg, #8fb4c5 0%, #6b94a8 48%, #547e92 100%);
    color: #fff;
    font-weight: 700;
    font-size: 1.05rem;
    box-shadow: 0 4px 14px rgba(95, 136, 157, 0.32), inset 0 1px 0 rgba(255, 255, 255, 0.25);
    transition: transform 0.25s var(--ease), box-shadow 0.25s var(--ease);
  }
  .brand:hover .brand-mark {
    transform: translateY(-1px) scale(1.03);
    box-shadow: 0 8px 18px rgba(95, 136, 157, 0.38), inset 0 1px 0 rgba(255, 255, 255, 0.28);
  }
  .brand-name {
    font-size: 1.08rem;
    font-weight: 650;
    color: var(--text-dark);
    letter-spacing: 0.02em;
  }
  .brand:hover .brand-name { color: var(--monet-blue-dark); }

  /* 中部导航 */
  .nav-center {
    display: flex;
    align-items: center;
    gap: 0.1rem;
    flex: 1;
    justify-content: center;
    min-width: 0;
  }
  .nav-center :global(a) {
    position: relative;
    padding: 6px 11px;
    border-radius: 999px;
    color: var(--text-gray);
    font-size: 0.88rem;
    font-weight: 500;
    transition: var(--transition);
    white-space: nowrap;
  }
  .nav-center :global(a:hover) {
    background: var(--monet-blue-lighter);
    color: var(--text-dark);
  }
  .nav-center :global(a.active) {
    color: var(--monet-blue-dark);
    background: var(--monet-blue-light);
    font-weight: 600;
  }

  /* 搜索框 */
  .nav-search {
    position: relative;
    display: flex;
    align-items: center;
    margin-left: 0.5rem;
  }
  .nav-search-mobile { display: none; }
  .nav-search-input {
    width: 120px;
    padding: 6px 10px 6px 30px;
    border: 1px solid var(--border-light);
    border-radius: 999px;
    background: var(--monet-blue-lighter);
    color: var(--text-dark);
    font-size: 0.82rem;
    font-family: inherit;
    transition: var(--transition);
  }
  .nav-search-input:focus {
    outline: none;
    width: 160px;
    border-color: var(--monet-blue);
    background: var(--bg-white);
    box-shadow: 0 0 0 3px rgba(107, 148, 168, 0.18);
  }
  .nav-search-icon {
    position: absolute;
    left: 11px;
    color: var(--text-light);
    pointer-events: none;
  }

  /* 主题切换按钮 */
  .theme-toggle {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 1px solid var(--border-light);
    border-radius: 999px;
    background: var(--monet-blue-lighter);
    color: var(--text-dark);
    cursor: pointer;
    transition: var(--transition);
  }
  .theme-toggle:hover {
    background: var(--monet-blue-light);
    color: var(--monet-blue-dark);
    transform: rotate(15deg);
  }
  .theme-toggle .ic-moon { display: none; }
  [data-theme="dark"] .theme-toggle .ic-sun { display: none; }
  [data-theme="dark"] .theme-toggle .ic-moon { display: inline-flex; }

  /* 右侧用户区 */
  .nav-right {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    position: relative;
    z-index: 20;
  }
  .logout-form { display: inline; margin: 0; }
  .user-name {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 4px 10px 4px 4px;
    border-radius: 999px;
    transition: var(--transition);
  }
  .user-name:hover { background: var(--monet-blue-lighter); }
  .user-avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: linear-gradient(135deg, #8fb4c5, #6b94a8);
    color: #fff;
    font-size: 0.85rem;
    font-weight: 600;
  }
  .user-text {
    font-size: 0.9rem;
    color: var(--text-dark);
    font-weight: 550;
    max-width: 120px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .unread-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 17px;
    height: 17px;
    padding: 0 5px;
    background: #e26d5c;
    color: #fff;
    font-size: 0.66rem;
    font-weight: 600;
    border-radius: 9px;
    margin-left: 5px;
    vertical-align: middle;
  }
  .pending-badge {
    background: #e0a92e;
    animation: pendingPulse 2s var(--ease) infinite;
  }
  .notif-badge {
    background: #5f889d;
    animation: notifPulse 2s var(--ease) infinite;
  }
  @keyframes notifPulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(95, 136, 157, 0.5); }
    50% { box-shadow: 0 0 0 5px rgba(95, 136, 157, 0); }
  }
  @keyframes pendingPulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(224, 169, 46, 0.45); }
    50% { box-shadow: 0 0 0 5px rgba(224, 169, 46, 0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .pending-badge, .notif-badge { animation: none; }
  }

  /* 汉堡按钮（仅手机显示） */
  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    padding: 9px;
    background: transparent;
    border: none;
    border-radius: 10px;
    cursor: pointer;
  }
  .nav-toggle:hover { background: var(--monet-blue-lighter); }
  .nav-toggle span {
    display: block;
    height: 2px;
    width: 100%;
    background: var(--text-dark);
    border-radius: 2px;
    transition: transform 0.28s var(--ease), opacity 0.2s var(--ease);
  }
  .nav-toggle.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .nav-toggle.open span:nth-child(2) { opacity: 0; }
  .nav-toggle.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  /* 手机端 */
  @media (max-width: 768px) {
    /* 手机端把背景做实一点：78% 透明 + 背景模糊在部分移动浏览器里
       backdrop-filter 会被降级，滚动时正文会透出来，看起来像和导航重叠 */
    header {
      background: color-mix(in srgb, var(--bg-white) 99%, transparent);
    }
    :global([data-theme="dark"]) header {
      background: color-mix(in srgb, var(--bg-white) 99%, transparent);
    }
    header { padding: 0 0.9rem; }
    .nav-toggle { display: flex; width: 44px; height: 44px; padding: 11px; }
    .theme-toggle { width: 42px; height: 42px; }
    .user-text { display: none; }
    .user-name { padding: 4px; }
    .user-avatar { width: 34px; height: 34px; }
    .logout-form .btn { padding: 9px 14px; min-height: 42px; }
    .btn-sm { padding: 9px 14px; min-height: 42px; font-size: 0.9rem; }
    .nav-right { gap: 0.4rem; }

    .nav-center {
      position: absolute;
      top: 66px;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0.25rem;
      padding: 0.8rem 1.2rem 1rem;
      background: rgba(255, 255, 255, 0.97);
      backdrop-filter: blur(14px);
      border-bottom: 1px solid var(--border-light);
      box-shadow: var(--shadow-md);
      transform-origin: top;
      transform: scaleY(0.96) translateY(-6px);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.22s var(--ease), transform 0.22s var(--ease);
      z-index: 15;
    }
    .nav-center.open {
      opacity: 1;
      pointer-events: auto;
      transform: scaleY(1) translateY(0);
    }
    .nav-center :global(a) {
      padding: 13px 14px;
      border-radius: var(--radius-md);
      font-size: 1rem;
      min-height: 48px;
      display: flex;
      align-items: center;
    }
    .nav-search-mobile {
      display: flex;
      margin: 0.4rem 0 0.2rem;
      width: 100%;
    }
    .nav-search-desktop { display: none; }
    .nav-search-input,
    .nav-search-input:focus {
      width: 100%;
      min-height: 42px;
      font-size: 16px; /* ≥16px 避免 iOS 输入聚焦时自动缩放页面 */
    }
    [data-theme="dark"] .nav-center {
      background: rgba(26, 36, 43, 0.97);
    }
  }

  /* 超小屏：收起品牌文字，只留 logo，保证右侧操作区不挤 */
  @media (max-width: 420px) {
    .brand-name { display: none; }
    .brand { gap: 0; }
  }
</style>

<script>
  // 手机端菜单开合
  const toggle = document.getElementById('navToggle');
  const navCenter = document.getElementById('navCenter');
  toggle?.addEventListener('click', () => {
    const open = navCenter?.classList.toggle('open');
    toggle.classList.toggle('open', !!open);
    toggle.setAttribute('aria-expanded', String(!!open));
  });
  // 点击菜单项后自动收起
  navCenter?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      navCenter.classList.remove('open');
      toggle?.classList.remove('open');
      toggle?.setAttribute('aria-expanded', 'false');
    })
  );

  // 主题切换：支持的浏览器用 View Transition 做「从按钮扩散」的圆形切换
  const themeToggle = document.getElementById('themeToggle');
  themeToggle?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    const apply = () => {
      document.documentElement.dataset.theme = next;
      try { localStorage.setItem('theme', next); } catch {}
    };

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!document.startViewTransition || reduce) {
      apply();
    } else {
      const r = themeToggle.getBoundingClientRect();
      const cx = r.left + r.width / 2;
      const cy = r.top + r.height / 2;
      // 半径取到最远的那个视口角，保证整屏都能被盖住
      const radius = Math.hypot(
        Math.max(cx, window.innerWidth - cx),
        Math.max(cy, window.innerHeight - cy)
      );
      const root = document.documentElement;
      root.style.setProperty('--vt-x', cx + 'px');
      root.style.setProperty('--vt-y', cy + 'px');
      root.style.setProperty('--vt-r', radius + 'px');
      document.startViewTransition(apply);
    }

    fetch('/api/theme', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ theme: next }),
    }).catch(() => {});
  });
</script>

{isLoggedIn && (
  <script>
    // 角标轮询：一次请求带全 未读消息/通知 +（管理员）待办
    function setBadge(id, count) {
      const badge = document.getElementById(id);
      if (!badge) return;
      badge.textContent = count > 99 ? '99+' : count;
      badge.style.display = count > 0 ? 'inline-flex' : 'none';
    }
    async function updateBadges() {
      try {
        const res = await fetch('/api/me/summary');
        if (!res.ok) return;
        const d = await res.json();
        setBadge('unreadBadge', d.messages);
        setBadge('notifBadge', d.notifications);
        setBadge('pendingBadge', d.pending);
      } catch {}
    }
    updateBadges();
    setInterval(updateBadges, 45000);
  </script>
)}
