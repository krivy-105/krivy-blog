---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';

const user = Astro.locals.user;
const isLoggedIn = !!user;
---

<header>
  <nav>
    <div class="nav-left">
      <h2><a href="/">{SITE_TITLE}</a></h2>
    </div>
    <div class="nav-center">
      <HeaderLink href="/">首页</HeaderLink>
      <HeaderLink href="/blog">文章</HeaderLink>
      <HeaderLink href="/about">关于</HeaderLink>
      {isLoggedIn && <HeaderLink href="/write">写文章</HeaderLink>}
      {isLoggedIn && <HeaderLink href="/messages">私信<span class="unread-badge" id="unreadBadge" style="display:none;">0</span></HeaderLink>}
    </div>
    <div class="nav-right">
      {isLoggedIn ? (
        <>
          <span class="user-name" title={user!.username}>👤 {user!.username}</span>
          <form method="POST" action="/api/logout" style="display:inline;">
            <button type="submit" class="btn btn-ghost btn-sm">退出</button>
          </form>
        </>
      ) : (
        <a href="/login" class="btn btn-primary btn-sm">登录 / 注册</a>
      )}
    </div>
  </nav>
</header>

<style>
  header {
    margin: 0;
    padding: 0 1.5rem;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(12px);
    box-shadow: 0 2px 12px rgba(126, 166, 184, 0.08);
    position: sticky;
    top: 0;
    z-index: 100;
  }
  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1100px;
    margin: 0 auto;
    height: 64px;
    gap: 1rem;
  }
  .nav-left h2 {
    margin: 0;
    font-size: 1.2rem;
  }
  .nav-left h2 a {
    color: var(--monet-blue);
    text-decoration: none;
    font-weight: 600;
  }
  .nav-center {
    display: flex;
    gap: 0.25rem;
    flex: 1;
    justify-content: center;
  }
  .nav-center :deep(a) {
    padding: 8px 14px;
    border-radius: var(--radius-md);
    color: var(--text-gray);
    font-size: 0.95rem;
    transition: var(--transition);
  }
  .nav-center :deep(a:hover) {
    background: var(--monet-blue-lighter);
    color: var(--text-dark);
  }
  .nav-center :deep(a.active) {
    color: var(--monet-blue);
    background: var(--monet-blue-light);
  }
  .nav-right {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .user-name {
    font-size: 0.9rem;
    color: var(--text-dark);
    font-weight: 500;
  }
  .btn-sm {
    padding: 6px 16px;
    font-size: 0.85rem;
  }
  .unread-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 16px;
    height: 16px;
    padding: 0 5px;
    background: #e74c3c;
    color: white;
    font-size: 0.65rem;
    border-radius: 8px;
    margin-left: 4px;
    vertical-align: middle;
  }
  @media (max-width: 768px) {
    .nav-center { display: none; }
  }
</style>

{isLoggedIn && (
  <script>
    async function updateUnread() {
      try {
        const res = await fetch('/api/messages/unread');
        const data = await res.json();
        const badge = document.getElementById('unreadBadge');
        if (badge) {
          badge.textContent = data.count > 99 ? '99+' : data.count;
          badge.style.display = data.count > 0 ? 'inline-flex' : 'none';
        }
      } catch {}
    }
    updateUnread();
    setInterval(updateUnread, 15000);
  </script>
)}
