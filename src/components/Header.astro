---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import { postQueries } from '../lib/db';

const user = Astro.locals.user;
const isLoggedIn = !!user;
const isAdmin = user?.role === 'admin';
const pendingCount = isAdmin
  ? (postQueries.countByStatus.get('pending') as { count: number }).count
  : 0;
---

<header>
  <nav>
    <div class="nav-left">
      <a href="/" class="brand" aria-label={SITE_TITLE}>
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="18" height="18">
            <path
              fill="currentColor"
              d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
            />
          </svg>
        </span>
        <span class="brand-name">{SITE_TITLE}</span>
      </a>
    </div>

    <div class="nav-center" id="navCenter">
      <HeaderLink href="/">首页</HeaderLink>
      <HeaderLink href="/blog">文章</HeaderLink>
      <HeaderLink href="/archive">归档</HeaderLink>
      <HeaderLink href="/links">友链</HeaderLink>
      <HeaderLink href="/about">关于</HeaderLink>
      {isLoggedIn && <HeaderLink href="/write">写文章</HeaderLink>}
      {isLoggedIn && (
        <HeaderLink href="/messages">
          私信<span class="unread-badge" id="unreadBadge" style="display:none;">0</span>
        </HeaderLink>
      )}
      {isAdmin && (
        <HeaderLink href="/admin">
          管理后台<span
            class="unread-badge pending-badge"
            id="pendingBadge"
            style={pendingCount > 0 ? '' : 'display:none;'}
            >{pendingCount}</span
          >
        </HeaderLink>
      )}
      <form action="/search" method="GET" class="nav-search" role="search">
        <input
          type="search"
          name="q"
          class="nav-search-input"
          placeholder="搜索文章…"
          aria-label="搜索文章"
          autocomplete="off"
        />
        <svg class="nav-search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7"/><path d="M21 21l-4.35-4.35"/>
        </svg>
      </form>
    </div>

    <div class="nav-right">
      <button
        class="theme-toggle"
        id="themeToggle"
        aria-label="切换暗色模式"
        title="切换主题"
      >
        <svg class="ic-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"/>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
        </svg>
        <svg class="ic-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3a7 7 0 0 0 9.79 9.79z"/>
        </svg>
      </button>
      {isLoggedIn ? (
        <>
          <a href={`/users/${user!.username}`} class="user-name" title="我的主页">
            <span class="user-avatar">{user!.username.slice(0, 1).toUpperCase()}</span>
            <span class="user-text">{user!.username}</span>
          </a>
          <form method="POST" action="/api/logout" class="logout-form">
            <button type="submit" class="btn btn-ghost btn-sm">退出</button>
          </form>
        </>
      ) : (
        <a href="/login" class="btn btn-primary btn-sm">登录 / 注册</a>
      )}
      <button
        class="nav-toggle"
        id="navToggle"
        aria-label="打开菜单"
        aria-expanded="false"
        aria-controls="navCenter"
      >
        <span></span><span></span><span></span>
      </button>
    </div>
  </nav>
</header>

<style>
  header {
    padding: 0 1.5rem;
    background: rgba(255, 255, 255, 0.82);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid rgba(227, 237, 242, 0.7);
    position: sticky;
    top: 0;
    z-index: 100;
  }
  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: var(--width-wide);
    margin: 0 auto;
    height: 66px;
    gap: 1rem;
  }

  /* 品牌 */
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }
  .brand-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: linear-gradient(135deg, #7aa3b6, #5f889d);
    color: #fff;
    font-weight: 700;
    font-size: 1.05rem;
    box-shadow: 0 3px 10px rgba(95, 136, 157, 0.3);
  }
  .brand-name {
    font-size: 1.08rem;
    font-weight: 650;
    color: var(--text-dark);
    letter-spacing: 0.02em;
  }
  .brand:hover .brand-name { color: var(--monet-blue-dark); }

  /* 中部导航 */
  .nav-center {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    flex: 1;
    justify-content: center;
  }
  .nav-center :global(a) {
    position: relative;
    padding: 7px 15px;
    border-radius: 999px;
    color: var(--text-gray);
    font-size: 0.94rem;
    font-weight: 500;
    transition: var(--transition);
  }
  .nav-center :global(a:hover) {
    background: var(--monet-blue-lighter);
    color: var(--text-dark);
  }
  .nav-center :global(a.active) {
    color: var(--monet-blue-dark);
    background: var(--monet-blue-light);
    font-weight: 600;
  }

  /* 搜索框 */
  .nav-search {
    position: relative;
    display: flex;
    align-items: center;
    margin-left: 0.5rem;
  }
  .nav-search-input {
    width: 150px;
    padding: 7px 12px 7px 32px;
    border: 1px solid var(--border-light);
    border-radius: 999px;
    background: var(--monet-blue-lighter);
    color: var(--text-dark);
    font-size: 0.86rem;
    font-family: inherit;
    transition: var(--transition);
  }
  .nav-search-input:focus {
    outline: none;
    width: 200px;
    border-color: var(--monet-blue);
    background: var(--bg-white);
    box-shadow: 0 0 0 3px rgba(107, 148, 168, 0.18);
  }
  .nav-search-icon {
    position: absolute;
    left: 11px;
    color: var(--text-light);
    pointer-events: none;
  }

  /* 主题切换按钮 */
  .theme-toggle {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 1px solid var(--border-light);
    border-radius: 999px;
    background: var(--monet-blue-lighter);
    color: var(--text-dark);
    cursor: pointer;
    transition: var(--transition);
  }
  .theme-toggle:hover {
    background: var(--monet-blue-light);
    color: var(--monet-blue-dark);
    transform: rotate(15deg);
  }
  .theme-toggle .ic-moon { display: none; }
  [data-theme="dark"] .theme-toggle .ic-sun { display: none; }
  [data-theme="dark"] .theme-toggle .ic-moon { display: inline-flex; }

  /* 右侧用户区 */
  .nav-right {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .logout-form { display: inline; margin: 0; }
  .user-name {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 4px 10px 4px 4px;
    border-radius: 999px;
    transition: var(--transition);
  }
  .user-name:hover { background: var(--monet-blue-lighter); }
  .user-avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: linear-gradient(135deg, #8fb4c5, #6b94a8);
    color: #fff;
    font-size: 0.85rem;
    font-weight: 600;
  }
  .user-text {
    font-size: 0.9rem;
    color: var(--text-dark);
    font-weight: 550;
    max-width: 120px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .unread-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 17px;
    height: 17px;
    padding: 0 5px;
    background: #e26d5c;
    color: #fff;
    font-size: 0.66rem;
    font-weight: 600;
    border-radius: 9px;
    margin-left: 5px;
    vertical-align: middle;
  }
  .pending-badge {
    background: #e0a92e;
    animation: pendingPulse 2s var(--ease) infinite;
  }
  @keyframes pendingPulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(224, 169, 46, 0.45); }
    50% { box-shadow: 0 0 0 5px rgba(224, 169, 46, 0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .pending-badge { animation: none; }
  }

  /* 汉堡按钮（仅手机显示） */
  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    padding: 9px;
    background: transparent;
    border: none;
    border-radius: 10px;
    cursor: pointer;
  }
  .nav-toggle:hover { background: var(--monet-blue-lighter); }
  .nav-toggle span {
    display: block;
    height: 2px;
    width: 100%;
    background: var(--text-dark);
    border-radius: 2px;
    transition: transform 0.28s var(--ease), opacity 0.2s var(--ease);
  }
  .nav-toggle.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .nav-toggle.open span:nth-child(2) { opacity: 0; }
  .nav-toggle.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  /* 手机端 */
  @media (max-width: 768px) {
    .nav-toggle { display: flex; }
    .user-text { display: none; }
    .user-name { padding: 4px; }
    .logout-form .btn { padding: 7px 12px; }

    .nav-center {
      position: absolute;
      top: 66px;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0.25rem;
      padding: 0.8rem 1.2rem 1rem;
      background: rgba(255, 255, 255, 0.97);
      backdrop-filter: blur(14px);
      border-bottom: 1px solid var(--border-light);
      box-shadow: var(--shadow-md);
      transform-origin: top;
      transform: scaleY(0.96) translateY(-6px);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.22s var(--ease), transform 0.22s var(--ease);
    }
    .nav-center.open {
      opacity: 1;
      pointer-events: auto;
      transform: scaleY(1) translateY(0);
    }
    .nav-center :global(a) {
      padding: 11px 14px;
      border-radius: var(--radius-md);
      font-size: 1rem;
    }
    .nav-search {
      margin: 0.4rem 0 0.2rem;
      width: 100%;
    }
    .nav-search-input,
    .nav-search-input:focus {
      width: 100%;
    }
    [data-theme="dark"] .nav-center {
      background: rgba(26, 36, 43, 0.97);
    }
  }
</style>

<script>
  // 手机端菜单开合
  const toggle = document.getElementById('navToggle');
  const navCenter = document.getElementById('navCenter');
  toggle?.addEventListener('click', () => {
    const open = navCenter?.classList.toggle('open');
    toggle.classList.toggle('open', !!open);
    toggle.setAttribute('aria-expanded', String(!!open));
  });
  // 点击菜单项后自动收起
  navCenter?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      navCenter.classList.remove('open');
      toggle?.classList.remove('open');
      toggle?.setAttribute('aria-expanded', 'false');
    })
  );

  // 主题切换
  const themeToggle = document.getElementById('themeToggle');
  themeToggle?.addEventListener('click', async () => {
    const cur = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = cur;
    try { localStorage.setItem('theme', cur); } catch {}
    try {
      await fetch('/api/theme', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ theme: cur }),
      });
    } catch {}
  });
</script>

{isAdmin && (
  <script>
    // 管理后台待审核角标轮询
    async function updatePending() {
      try {
        const res = await fetch('/api/admin/posts/pending-count');
        if (!res.ok) return;
        const data = await res.json();
        const badge = document.getElementById('pendingBadge');
        if (badge) {
          badge.textContent = data.count > 99 ? '99+' : data.count;
          badge.style.display = data.count > 0 ? 'inline-flex' : 'none';
        }
      } catch {}
    }
    updatePending();
    setInterval(updatePending, 20000);
  </script>
)}

{isLoggedIn && (
  <script>
    async function updateUnread() {
      try {
        const res = await fetch('/api/messages/unread');
        const data = await res.json();
        const badge = document.getElementById('unreadBadge');
        if (badge) {
          badge.textContent = data.count > 99 ? '99+' : data.count;
          badge.style.display = data.count > 0 ? 'inline-flex' : 'none';
        }
      } catch {}
    }
    updateUnread();
    setInterval(updateUnread, 15000);
  </script>
)}
