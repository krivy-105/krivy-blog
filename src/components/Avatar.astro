---
// 通用头像：有自定义头像时渲染 <img>，否则回退为首字母渐变圆形。
//
// 两种调用方式都支持：
// 1) class 传入：尺寸/颜色由调用方 CSS 决定（如 .comment-avatar）
// 2) size 传入：内联输出尺寸 + width/height 属性，图片未加载时也能占住位置
//    （避免布局在图片到达后跳动，CLS）
// name / username 互为别名——早期页面写的是 username，之前没人处理，
// 结果首字母变成 "?"、alt 变成 "undefined 的头像"。
interface Props {
  name?: string;
  username?: string;
  src?: string | null;
  class?: string;
  alt?: string;
  /** 显示尺寸（px）。传了就会强制成对应大小的圆形头像 */
  size?: number;
}
const { name, username, src = null, class: className = '', alt, size } = Astro.props;
const who = name || username || '';
const initial = (who || '?').slice(0, 1).toUpperCase();

// size 模式：圆形容器 + 渐变底 + 白字，与 .comment-avatar / .user-avatar 视觉一致
const sizeStyle = size
  ? [
      `width:${size}px`,
      `height:${size}px`,
      'display:inline-flex',
      'align-items:center',
      'justify-content:center',
      'flex:none',
      'border-radius:50%',
      'overflow:hidden',
      'background:linear-gradient(135deg,#8fb4c5,#6b94a8)',
      'color:#fff',
      `font-size:${Math.max(11, Math.round(size * 0.42))}px`,
      'font-weight:600',
      'line-height:1',
    ].join(';')
  : undefined;
const imgStyle = size ? `${sizeStyle};object-fit:cover` : undefined;
---

{src ? (
  <img
    class={`md-avatar ${className}`}
    src={src}
    alt={alt || (who ? `${who} 的头像` : '')}
    loading="lazy"
    decoding="async"
    width={size}
    height={size}
    style={imgStyle}
  />
) : (
  <span class={`md-avatar ${className}`} aria-hidden="true" style={sizeStyle}>{initial}</span>
)}

<style>
  /* global：PostInteract 等组件在客户端动态创建的头像 img 也复用 .md-avatar */
  :global(img.md-avatar) {
    object-fit: cover;
    background: var(--bg-body, #f3f8fb);
  }
  :global(.md-avatar) {
    flex-shrink: 0;
  }
</style>
